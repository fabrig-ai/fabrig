record InfrastructureKindOwnerEffect { value: u64 }
record InfrastructureKindOutbox { value: u64 }
record InfrastructureKindHold { value: u64 }
record InfrastructureKindProject { value: u32 }
record InfrastructureRefusalRole { held: u32 }
enum InfrastructureRefusal { role: InfrastructureRefusalRole, past, exhausted, signed_out, not_allowed, conflict, invalid }
record InfrastructureAnswerRefused { why: InfrastructureRefusal }
record InfrastructureService { environment: bytes 4096 name: bytes 4096 }
record InfrastructureEnvironment { pool: bytes 4096 name: bytes 4096 }
record InfrastructurePool { value: bytes 4096 }
record InfrastructureResourceService { value: InfrastructureService }
record InfrastructureResourceEnvironment { value: InfrastructureEnvironment }
record InfrastructureResourcePool { value: InfrastructurePool }
record InfrastructureResourceQuota { value: InfrastructurePool }
enum InfrastructureResource { service: InfrastructureResourceService, environment: InfrastructureResourceEnvironment, pool: InfrastructureResourcePool, quota: InfrastructureResourceQuota }
enum InfrastructureHold { exclusive_wait, pooled_wait, none }
enum InfrastructureResourceRole { owned, participant, context, unavailable }
record InfrastructureNamed { resource: InfrastructureResource role: InfrastructureResourceRole hold: InfrastructureHold }
record InfrastructurePurposeCall { attempt: u64 completion: u32 position: u32 }
record InfrastructurePurposeProcedure { purpose: u64 }
record InfrastructurePurposeProjection { purpose: u64 }
enum InfrastructurePurpose { call: InfrastructurePurposeCall, procedure: InfrastructurePurposeProcedure, projection: InfrastructurePurposeProjection }
record InfrastructureKey { deployment: fixed 16 task: u64 origin: InfrastructurePurpose purpose: u64 }
enum InfrastructureBackend { operation_ids, no_operation_ids }
record InfrastructureEffectRestart { service: InfrastructureService operation: u64 }
record InfrastructureEffectScale { service: InfrastructureService from: u32 to: u32 }
record InfrastructureEffectRollback { service: InfrastructureService from: bytes 4096 to: bytes 4096 }
record InfrastructureEffectCreateEnvironment { environment: InfrastructureEnvironment until: u64 price: u64 }
record InfrastructureEffectTearDown { environment: InfrastructureEnvironment created_by: InfrastructureKey }
enum InfrastructureEffect { restart: InfrastructureEffectRestart, scale: InfrastructureEffectScale, rollback: InfrastructureEffectRollback, create_environment: InfrastructureEffectCreateEnvironment, tear_down: InfrastructureEffectTearDown }
enum InfrastructureForm { creation, transition, set }
enum InfrastructureRecovery { keyed, conditional, unrecoverable }
record InfrastructureDescription { kind: u16 resources: list 128 InfrastructureResource condition: bool form: InfrastructureForm recovery: InfrastructureRecovery price: option u64 state: u64 }
enum InfrastructurePhase { kept, sent, uncertain, held }
record InfrastructureEntry { project: option u32 number: u64 key: InfrastructureKey effect: InfrastructureEffect attempt: u32 deadline: u64 phase: InfrastructurePhase }
record InfrastructureServiceFact { version: bytes 4096 replicas: u32 healthy: bool revision: u64 observed: u64 }
record InfrastructureEnvironmentFact { created_by: InfrastructureKey ready_at: u64 until: u64 price: u64 }
record InfrastructureProcedureRemediate { service: InfrastructureService operation: u64 deadline: u64 }
record InfrastructureProcedureScale { service: InfrastructureService replicas: u32 deadline: u64 }
record InfrastructureProcedureProvision { environment: InfrastructureEnvironment until: u64 price: u64 deadline: u64 }
record InfrastructureProcedureTearDown { environment: InfrastructureEnvironment created_by: InfrastructureKey deadline: u64 }
enum InfrastructureProcedure { remediate: InfrastructureProcedureRemediate, scale: InfrastructureProcedureScale, provision: InfrastructureProcedureProvision, tear_down: InfrastructureProcedureTearDown }
enum InfrastructureProcedurePhase { active, reading_facts, facts_ready, effect_outstanding, waiting_condition, holding, done, held }
record InfrastructureProcedureState { task: u64 procedure: InfrastructureProcedure phase: InfrastructureProcedurePhase }
enum InfrastructureDriftKind { changed, deleted }
record InfrastructureDriftAccount { resource: InfrastructureResource kind: InfrastructureDriftKind at: u64 by: option bytes 4096 }
record InfrastructureEnvironmentEnd { revision: u64 until: u64 }
record InfrastructureClientPool { quota: u32 used: u32 }
record InfrastructureResourceFactService { value: option InfrastructureServiceFact }
record InfrastructureResourceFactEnvironment { fact: option InfrastructureEnvironmentFact end: option InfrastructureEnvironmentEnd }
record InfrastructureResourceFactPool { value: option InfrastructureClientPool }
record InfrastructureResourceFactQuota { value: option InfrastructureClientPool }
enum InfrastructureResourceFact { service: InfrastructureResourceFactService, environment: InfrastructureResourceFactEnvironment, pool: InfrastructureResourceFactPool, quota: InfrastructureResourceFactQuota }
record InfrastructureClientResource { named: InfrastructureNamed fact: InfrastructureResourceFact }
record InfrastructureClientEnvironment { environment: InfrastructureEnvironment fact: InfrastructureEnvironmentFact end: option InfrastructureEnvironmentEnd pool: option InfrastructureClientPool }
record InfrastructureValueEnvironment { environment: InfrastructureEnvironment end_revision: u64 fact: InfrastructureEnvironmentFact end: option InfrastructureEnvironmentEnd pool: option InfrastructureClientPool }
record InfrastructureValuePanel { task: u64 state: InfrastructureProcedureState resources: list 128 InfrastructureClientResource effects: list 128 InfrastructureEntry }
record InfrastructureValueResult { task: u64 state: InfrastructureProcedureState resources: list 128 InfrastructureClientResource }
record InfrastructureValueEffect { proposal: u64 task: u64 effect: InfrastructureEffect description: InfrastructureDescription }
record InfrastructureValueOutbox { entry: InfrastructureEntry description: InfrastructureDescription }
record InfrastructureValueHold { task: u64 resources: list 128 InfrastructureClientResource drift: list 128 InfrastructureDriftAccount effects: list 128 InfrastructureEntry }
record InfrastructureValueProject { project: u32 resources: list 128 InfrastructureClientResource environments: list 128 InfrastructureClientEnvironment }
record InfrastructureValueDeployment { backend: InfrastructureBackend effects: list 128 InfrastructureEntry made: u32 proposal_limit: u32 staged_limit: u32 }
enum InfrastructureValue { environment: InfrastructureValueEnvironment, panel: InfrastructureValuePanel, result: InfrastructureValueResult, effect: InfrastructureValueEffect, outbox: InfrastructureValueOutbox, hold: InfrastructureValueHold, project: InfrastructureValueProject, deployment: InfrastructureValueDeployment }
record ObservabilityScopeProject { value: u32 }
enum ObservabilityScope { project: ObservabilityScopeProject, deployment }
record ObservabilityKindIncidents { open: bool }
