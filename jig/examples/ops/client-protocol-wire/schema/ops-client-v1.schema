family jig-ops-client-wire 1
record DecisionTask { value: u64 }
record DecisionParty { value: u64 }
enum DecisionMaker { task: DecisionTask, party: DecisionParty }
record DecisionKey { maker: DecisionMaker number: u64 }
record InfrastructureScopeProject { value: u32 }
enum InfrastructureScope { project: InfrastructureScopeProject, deployment }
record InfrastructureKindPanel { value: u64 }
record InfrastructureKindResult { value: u64 }
