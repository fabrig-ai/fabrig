enum InfrastructureNativeValue { environment: InfrastructureNativeValueEnvironment, panel: InfrastructureNativeValuePanel, result: InfrastructureNativeValueResult, effect: InfrastructureNativeValueEffect, outbox: InfrastructureNativeValueOutbox, hold: InfrastructureNativeValueHold, project: InfrastructureNativeValueProject, deployment: InfrastructureNativeValueDeployment }
