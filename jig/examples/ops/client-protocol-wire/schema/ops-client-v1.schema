enum InfrastructureNativeResourceFact { service: InfrastructureNativeResourceFactService, environment: InfrastructureNativeResourceFactEnvironment, pool: InfrastructureNativeResourceFactPool, quota: InfrastructureNativeResourceFactQuota }
record InfrastructureNativeClientResource { named: InfrastructureNativeNamed fact: InfrastructureNativeResourceFact }
record InfrastructureNativeClientEnvironment { environment: InfrastructureNativeEnvironment fact: InfrastructureNativeEnvironmentFact end: option InfrastructureNativeEnvironmentEnd pool: option InfrastructureNativeClientPool }
record InfrastructureNativeValueEnvironment { environment: InfrastructureNativeEnvironment end_revision: u64 fact: InfrastructureNativeEnvironmentFact end: option InfrastructureNativeEnvironmentEnd pool: option InfrastructureNativeClientPool }
record InfrastructureNativeValuePanel { task: u64 state: InfrastructureNativeProcedureState resources: list 128 InfrastructureNativeClientResource effects: list 128 InfrastructureNativeEntry }
record InfrastructureNativeValueResult { task: u64 state: InfrastructureNativeProcedureState resources: list 128 InfrastructureNativeClientResource }
record InfrastructureNativeValueEffect { proposal: u64 task: u64 effect: InfrastructureNativeEffect description: InfrastructureNativeDescription }
record InfrastructureNativeValueOutbox { entry: InfrastructureNativeEntry description: InfrastructureNativeDescription }
record InfrastructureNativeValueHold { task: u64 resources: list 128 InfrastructureNativeClientResource drift: list 128 InfrastructureNativeDriftAccount effects: list 128 InfrastructureNativeEntry }
record InfrastructureNativeValueProject { project: u32 resources: list 128 InfrastructureNativeClientResource environments: list 128 InfrastructureNativeClientEnvironment }
