record ObservabilitySubject { scope: ObservabilityScope kind: ObservabilityKind }
record ObservabilityService { environment: bytes 4096 name: bytes 4096 }
enum ObservabilityState { alerting, resolved }
record ObservabilityLoadPoint { observed: u64 load_percent: u8 }
record ObservabilityFact { observed: u64 healthy_replicas: u32 errors: u32 error_rate_percent: u8 load_percent: u8 load: list 128 ObservabilityLoadPoint }
record ObservabilityHealth { observed: u64 healthy_replicas: u32 errors: u32 error_rate_percent: u8 }
record ObservabilityPoint { at: u64 health: option ObservabilityHealth }
record ObservabilityIncident { project: u32 number: u64 watch: u64 lead: option u64 alerts: list 128 u64 raised: u64 service: ObservabilityService severity: u8 state: ObservabilityState timeline: list 128 ObservabilityPoint cut: bool }
record ObservabilityServiceState { service: ObservabilityService fact: option ObservabilityFact }
record ObservabilityAlert { number: u64 service: ObservabilityService severity: u8 }
record ObservabilityPurposeCall { attempt: u64 completion: u32 position: u32 }
record ObservabilityPurposeProcedure { purpose: u64 }
record ObservabilityPurposeProjection { purpose: u64 }
enum ObservabilityPurpose { call: ObservabilityPurposeCall, procedure: ObservabilityPurposeProcedure, projection: ObservabilityPurposeProjection }
record ObservabilityKey { deployment: fixed 16 task: u64 origin: ObservabilityPurpose purpose: u64 }
record ObservabilityEffect { rule: bytes 4096 until: u64 }
enum ObservabilityPhase { kept, sent, uncertain, held }
record ObservabilityEntry { project: option u32 number: u64 key: ObservabilityKey effect: ObservabilityEffect attempt: u32 deadline: u64 phase: ObservabilityPhase }
record ObservabilityValueService { service: ObservabilityService fact: ObservabilityFact }
record ObservabilityValueAlert { alert: ObservabilityAlert raised: u64 state: ObservabilityState fact: option ObservabilityFact }
record ObservabilityValueOutbox { entry: ObservabilityEntry }
record ObservabilityValueDeployment { watches: u32 effects: list 128 ObservabilityEntry read_limit: u32 incident_limit: u32 }
record ObservabilityValueIncident { incident: ObservabilityIncident fact: option ObservabilityFact }
record ObservabilityValueProject { project: u32 services: list 128 ObservabilityServiceState incidents: list 128 ObservabilityIncident }
enum ObservabilityValue { service: ObservabilityValueService, alert: ObservabilityValueAlert, outbox: ObservabilityValueOutbox, deployment: ObservabilityValueDeployment, incident: ObservabilityValueIncident, project: ObservabilityValueProject }
record ObservabilityDocumentData { subject: ObservabilitySubject value: ObservabilityValue }
versioned record ObservabilitySubjectRecord { value: ObservabilityKind }
