record InfrastructureKindEnvironments { pool: option InfrastructurePool }
enum InfrastructureKind { environment: InfrastructureKindEnvironment, environments: InfrastructureKindEnvironments, panel: InfrastructureKindPanel, result: InfrastructureKindResult, effect: InfrastructureKindEffect, owner_effect: InfrastructureKindOwnerEffect, outbox: InfrastructureKindOutbox, hold: InfrastructureKindHold, project: InfrastructureKindProject, deployment }
record InfrastructureSubject { scope: InfrastructureScope kind: InfrastructureKind }
record InfrastructureAskMoveEnd { object: u64 project: u32 environment: InfrastructureEnvironment revision: u64 until: u64 }
