enum ObservabilityNativeValue { service: ObservabilityNativeValueService, alert: ObservabilityNativeValueAlert, outbox: ObservabilityNativeValueOutbox, deployment: ObservabilityNativeValueDeployment, incident: ObservabilityNativeValueIncident, project: ObservabilityNativeValueProject }
