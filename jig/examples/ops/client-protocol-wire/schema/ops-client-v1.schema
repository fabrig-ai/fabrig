record ObservabilityNativeServiceState { service: ObservabilityService fact: option ObservabilityNativeFact }
record ObservabilityNativeAlert { number: u64 service: ObservabilityService severity: u8 }
record ObservabilityNativePurposeCall { attempt: u64 completion: u32 position: u32 }
record ObservabilityNativePurposeProcedure { purpose: u64 }
record ObservabilityNativePurposeProjection { purpose: u64 }
