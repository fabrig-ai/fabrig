record InfrastructureNativeProcedureProvision { environment: InfrastructureNativeEnvironment until: u64 price: u64 deadline: u64 }
record InfrastructureNativeProcedureTearDown { environment: InfrastructureNativeEnvironment created_by: InfrastructureNativeKey deadline: u64 }
enum InfrastructureNativeProcedure { remediate: InfrastructureNativeProcedureRemediate, scale: InfrastructureNativeProcedureScale, provision: InfrastructureNativeProcedureProvision, tear_down: InfrastructureNativeProcedureTearDown }
enum InfrastructureNativeProcedurePhase { active, reading_facts, facts_ready, effect_outstanding, waiting_condition, holding, done, held }
record InfrastructureNativeProcedureState { task: u64 procedure: InfrastructureNativeProcedure phase: InfrastructureNativeProcedurePhase }
enum InfrastructureNativeDriftKind { changed, deleted }
record InfrastructureNativeDriftAccount { resource: InfrastructureNativeResource kind: InfrastructureNativeDriftKind at: u64 by: option bytes 4096 }
record InfrastructureNativeEnvironmentEnd { revision: u64 until: u64 }
record InfrastructureNativeClientPool { quota: u32 used: u32 }
record InfrastructureNativeResourceFactService { value: option InfrastructureNativeServiceFact }
record InfrastructureNativeResourceFactEnvironment { fact: option InfrastructureNativeEnvironmentFact end: option InfrastructureNativeEnvironmentEnd }
