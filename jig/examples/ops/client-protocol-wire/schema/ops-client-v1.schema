record InfrastructureNativeKey { deployment: fixed 16 task: u64 origin: InfrastructureNativePurpose purpose: u64 }
enum InfrastructureNativeBackend { operation_ids, no_operation_ids }
record InfrastructureNativeEffectRestart { service: InfrastructureNativeService operation: u64 }
record InfrastructureNativeEffectScale { service: InfrastructureNativeService from: u32 to: u32 }
record InfrastructureNativeEffectRollback { service: InfrastructureNativeService from: bytes 4096 to: bytes 4096 }
record InfrastructureNativeEffectCreateEnvironment { environment: InfrastructureNativeEnvironment until: u64 price: u64 }
record InfrastructureNativeEffectTearDown { environment: InfrastructureNativeEnvironment created_by: InfrastructureNativeKey }
enum InfrastructureNativeEffect { restart: InfrastructureNativeEffectRestart, scale: InfrastructureNativeEffectScale, rollback: InfrastructureNativeEffectRollback, create_environment: InfrastructureNativeEffectCreateEnvironment, tear_down: InfrastructureNativeEffectTearDown }
enum InfrastructureNativeForm { creation, transition, set }
enum InfrastructureNativeRecovery { keyed, conditional, unrecoverable }
record InfrastructureNativeDescription { kind: u16 resources: list 128 InfrastructureNativeResource condition: bool form: InfrastructureNativeForm recovery: InfrastructureNativeRecovery price: option u64 state: u64 }
enum InfrastructureNativePhase { kept, sent, uncertain, held }
record InfrastructureNativeEntry { project: option u32 number: u64 key: InfrastructureNativeKey effect: InfrastructureNativeEffect attempt: u32 deadline: u64 phase: InfrastructureNativePhase }
record InfrastructureNativeServiceFact { version: bytes 4096 replicas: u32 healthy: bool revision: u64 observed: u64 }
record InfrastructureNativeEnvironmentFact { created_by: InfrastructureNativeKey ready_at: u64 until: u64 price: u64 }
