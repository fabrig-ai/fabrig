{
  "engine": {
    "llm": {
      "providers": [
        {
          "name": "openai",
          "number": 1,
          "endpoint": "openai",
          "keep": [
            "gpt-*"
          ],
          "drop": [
            "*audio*",
            "*image*",
            "*realtime*",
            "*search*",
            "*transcribe*",
            "*tts*",
            "*-20??-??-??"
          ],
          "signed_in_plan": true,
          "manage_usage": "https://chatgpt.com/settings/usage",
          "sources": {
            "keys": true,
            "sign_in": {
              "issuer": "https://auth.openai.com",
              "client": "dynamic_agent_client",
              "name_hint": "temper",
              "authorization": "https://auth.openai.com/api/accounts/authorize",
              "token": "https://auth.openai.com/api/accounts/oauth/token",
              "revocation": "https://auth.openai.com/api/accounts/oauth/revoke",
              "keys": "https://auth.openai.com/.well-known/jwks.json",
              "transport": "tls",
              "server_name": "auth.openai.com",
              "scopes": [
                "openid",
                "profile",
                "email",
                "offline_access",
                "resource.invoke",
                "chatgpt.tokens.use.direct"
              ],
              "must_grant": [
                "chatgpt.tokens.use.direct"
              ],
              "resource": "https://api.openai.com/v1",
              "redirect_path": "auth/callback",
              "redirect_port": 1455
            }
          }
        }
      ],
      "endpoints": [
        {
          "name": "openai",
          "number": 1,
          "dialect": 3,
          "provider": "openai",
          "address": {
            "host": "api.openai.com",
            "port": 443
          },
          "transport": "tls",
          "headers": [],
          "connect_ms": 10000,
          "handshake_ms": 10000,
          "server_name": "api.openai.com"
        }
      ]
    },
    "hosts": {
      "listener": [
        {
          "in_process": "workers"
        }
      ]
    },
    "clients": {},
    "owners": [
      {
        "provider": 1,
        "subject": "owner-a"
      }
    ]
  },
  "workers": [
    {
      "engine": {
        "in_process": "workers"
      },
      "name": "local",
      "secret": "secrets/worker.secret",
      "slots": 4
    }
  ],
  "application": {
    "clients": {
      "listener": {
        "socket": "127.0.0.1:7100"
      },
      "bundle": null,
      "public": null
    },
    "webhooks": {
      "listener": {
        "socket": "127.0.0.1:7101"
      }
    },
    "demo": null, "sign_in": null
  }
}
