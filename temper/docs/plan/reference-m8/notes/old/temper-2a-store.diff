+            let finding = decode_finding(finding)?;
+            if usize::try_from(landing).or(Err(Undecodable))? >= landings.len()
+                || finding.blamed.len() != landings.len()
+            {
+                return Err(Undecodable);
+            }
+            p::Part::Probe { landing, tests, finding }
+        }
+    };
+    Ok(p::Run { number, tip, key, landings, part, faults })
+}
+#[expect(clippy::manual_map, reason = "step translations use explicit matches")]
+#[expect(clippy::too_many_lines, reason = "one complete durable tier row translation")]
+pub(super) fn encode(row: &d::TierRow) -> w::TierRow {
+    let mut flakes = List::with_capacity(u32::try_from(row.record.flakes.len()).expect(FITS));
+    for flake in &row.record.flakes {
+        flakes
+            .push(
+                w::TierFlake::new(&w::CEILINGS, w::TierFlakeParts { test: flake.test.clone(), count: flake.count })
+                    .expect(FITS),
+            )
+            .expect(FITS);
+    }
+    let judged = match row.record.judged {
+        Some(j) => Some(w::TierJudged::new(&w::CEILINGS, w::TierJudgedParts { tip: j.tip, key: j.key }).expect(FITS)),
+        None => None,
+    };
+    let run = match &row.record.run {
+        Some(run) => Some(encode_run(run)),
+        None => None,
+    };
+    let record = w::TierRecord::new(
+        &w::CEILINGS,
+        w::TierRecordParts {
+            sequence: row.record.sequence,
+            judged,
+            failing: verification::encode_failures(&row.record.failing),
+            flakes,
+            run,
+        },
+    )
+    .expect(FITS);
+    let branch = match row.branch {
+        d::TierBranch::Absent => w::TierBranch::Absent,
+        d::TierBranch::Made => w::TierBranch::Made,
+        d::TierBranch::Pending { entry } => {
+            w::TierBranch::Pending(w::Number::new(&w::CEILINGS, w::NumberParts { number: entry }).expect(FITS))
+        }
+    };
+    let flight = match &row.flight {
+        Some(f) => {
+            let mut pending = List::with_capacity(u32::try_from(f.pending.len()).expect(FITS));
+            for attempt in &f.pending {
+                pending.push(super::answers::encode_job_attempt(attempt)).expect(FITS);
+            }
+            Some(
+                w::TierFlight::new(
+                    &w::CEILINGS,
+                    w::TierFlightParts {
+                        next: match f.next {
+                            Some(at) => Some(at.as_nanos()),
+                            None => None,
+                        },
+                        entry: f.entry,
+                        start: match f.start {
+                            Some(at) => Some(at.as_nanos()),
+                            None => None,
+                        },
+                        since: match f.since {
+                            Some(at) => Some(at.as_nanos()),
+                            None => None,
+                        },
+                        waiting: f.waiting,
+                        fault: f.fault,
+                        pending,
+                    },
+                )
+                .expect(FITS),
+            )
+        }
+        None => None,
+    };
+    let result = match &row.result {
+        Some(r) => Some(
+            w::TierResult::new(
+                &w::CEILINGS,
+                w::TierResultParts {
+                    verdict: w::TierJudgement::new(
+                        &w::CEILINGS,
+                        w::TierJudgementParts {
+                            number: r.verdict.number,
+                            tip: r.verdict.tip,
+                            key: r.verdict.key,
+                            finding: encode_finding(&p::Finding {
+                                failing: r.verdict.failing.clone(),
+                                flakes: r.verdict.flakes.clone(),
+                                blamed: r.verdict.landings.clone(),
+                            }),
+                        },
+                    )
+                    .expect(FITS),
+                    run: w::ReceiptRun::new(
+                        &w::CEILINGS,
+                        w::ReceiptRunParts { id: r.run.id, number: r.run.number, url: r.run.url.clone() },
+                    )
+                    .expect(FITS),
+                    received: r.received,
+                    status: encode_branch(r.status),
+                },
+            )
+            .expect(FITS),
+        ),
+        None => None,
+    };
+    w::TierRow::new(
+        &w::CEILINGS,
+        w::TierRowParts {
+            repository: names::encode_repository(row.repository),
+            tier: row.tier.clone(),
+            record,
+            pending: encode_pending(&row.pending),
+            baseline: match &row.baseline {
+                Some(baseline) => Some(encode_pending_landing(baseline)),
+                None => None,
+            },
+            task: row.task,
+            branch,
+            flight,
+            result,
+        },
+    )
+    .expect(FITS)
+}
+#[expect(
+    clippy::too_many_lines,
+    clippy::manual_map,
+    reason = "one durable row translation validates the related operation states without callbacks"
+)]
+pub(super) fn decode(row: w::TierRow) -> Result<d::TierRow, Undecodable> {
+    let w::TierRowParts { repository, tier, record, pending, baseline, task, branch, flight, result } =
+        row.into_parts();
+    if tier.is_empty() {
+        return Err(Undecodable);
+    }
+    for byte in &tier {
+        if !byte.is_ascii_alphanumeric() && *byte != b'-' && *byte != b'_' {
+            return Err(Undecodable);
+        }
+    }
+    let w::TierRecordParts { sequence, judged, failing, flakes, run } = record.into_parts();
+    let judged = match judged {
+        Some(j) => {
+            let w::TierJudgedParts { tip, key } = j.into_parts();
+            Some(p::Judged { tip, key })
+        }
+        None => None,
+    };
+    let run = match run {
+        Some(run) => Some(decode_run(run)?),
+        None => None,
+    };
+    let mut values = List::with_capacity(flakes.len());
+    for flake in flakes.into_boxed() {
+        let w::TierFlakeParts { test, count } = flake.into_parts();
+        if let Some(previous) = values.as_slice().last() {
+            let previous: &p::Flake = previous;
+            if previous.test >= test {
+                return Err(Undecodable);
+            }
+        }
+        values.push(p::Flake { test, count }).expect(FITS);
+    }
+    let branch = match branch {
+        w::TierBranch::Absent => d::TierBranch::Absent,
+        w::TierBranch::Made => d::TierBranch::Made,
+        w::TierBranch::Pending(n) => d::TierBranch::Pending { entry: n.into_parts().number },
+    };
+    let flight = match flight {
+        Some(f) => {
+            let w::TierFlightParts { next, entry, start, since, waiting, fault, pending } = f.into_parts();
+            let mut jobs = List::with_capacity(pending.len());
+            for attempt in pending.into_boxed() {
+                jobs.push(super::answers::decode_job_attempt(attempt)).expect(FITS);
+            }
+            Some(d::TierFlight {
+                next: match next {
+                    Some(at) => Some(skein_lib::Time::from_nanos(at)),
+                    None => None,
+                },
+                entry,
+                start: match start {
+                    Some(at) => Some(skein_lib::Time::from_nanos(at)),
+                    None => None,
+                },
+                since: match since {
+                    Some(at) => Some(skein_lib::Time::from_nanos(at)),
+                    None => None,
+                },
+                waiting,
+                fault,
+                pending: jobs.into_boxed(),
+            })
+        }
+        None => None,
+    };
+    let result = match result {
+        Some(r) => {
+            let w::TierResultParts { verdict, run, received, status } = r.into_parts();
+            let w::TierJudgementParts { number, tip, key, finding } = verdict.into_parts();
+            let finding = decode_finding(finding)?;
+            let w::ReceiptRunParts { id, number: run_number, url } = run.into_parts();
+            Some(d::TierResult {
+                verdict: p::Verdict {
+                    number,
+                    tip,
+                    key,
+                    failing: finding.failing,
+                    flakes: finding.flakes,
+                    landings: finding.blamed,
+                },
+                run: d::ReceiptRun { id, number: run_number, url },
+                received,
+                status: decode_branch(status),
+            })
+        }
+        None => None,
+    };
+    if (baseline.is_some() && (judged.is_some() || run.is_some()))
+        || (flight.is_some() && (run.is_none() || task.is_none()))
+        || (result.is_some() && run.is_none())
+    {
+        return Err(Undecodable);
+    }
+    if let Some(result) = &result {
+        let run = run.as_ref().ok_or(Undecodable)?;
+        if result.verdict.number != run.number
+            || result.verdict.tip != run.tip
+            || result.verdict.key != run.key
+            || result.verdict.landings.len() != run.landings.len()
+        {
+            return Err(Undecodable);
+        }
+    }
+    Ok(d::TierRow {
+        repository: names::decode_repository(repository),
+        tier,
+        record: p::Record {
+            sequence,
+            judged,
+            failing: verification::decode_failures(failing)?,
+            flakes: values.into_boxed(),
+            run,
+        },
+        pending: decode_pending(pending),
+        baseline: match baseline {
+            Some(baseline) => Some(decode_pending_landing(baseline)),
+            None => None,
+        },
+        task,
+        branch,
+        flight,
+        result,
+    })
+}
+
+fn encode_branch(branch: d::TierBranch) -> w::TierBranch {
+    match branch {
+        d::TierBranch::Absent => w::TierBranch::Absent,
+        d::TierBranch::Made => w::TierBranch::Made,
+        d::TierBranch::Pending { entry } => {
+            w::TierBranch::Pending(w::Number::new(&w::CEILINGS, w::NumberParts { number: entry }).expect(FITS))
+        }
+    }
+}
+fn decode_branch(branch: w::TierBranch) -> d::TierBranch {
+    match branch {
+        w::TierBranch::Absent => d::TierBranch::Absent,
+        w::TierBranch::Made => d::TierBranch::Made,
+        w::TierBranch::Pending(entry) => d::TierBranch::Pending { entry: entry.into_parts().number },
+    }
+}
diff --git a/temper/crates/temper-protocol-store/src/records/verification.rs b/temper/crates/temper-protocol-store/src/records/verification.rs
new file mode 100644
index 000000000..6c0d0780f
--- /dev/null
+++ b/temper/crates/temper-protocol-store/src/records/verification.rs
@@ -0,0 +1,138 @@
+//! Family 26's bounded translations (protocol/store.md, 2).
+use super::{FITS, names, w};
+use crate::Undecodable;
+use skein_lib::List;
+use temper_engine_domain_forge as d;
+use temper_engine_domain_forge_tiers::{Blame, Failures};
+
+pub(super) fn encode_failures(value: &Failures) -> w::Failures {
+    match value {
+        Failures::Many => w::Failures::Many,
+        Failures::Tests(tests) => {
+            let mut encoded = List::with_capacity(u32::try_from(tests.len()).expect(FITS));
+            for test in tests {
+                encoded
+                    .push(w::FailingTest::new(&w::CEILINGS, w::FailingTestParts { test_id: test.clone() }).expect(FITS))
+                    .expect(FITS);
+            }
+            w::Failures::Tests(w::FailedTests::new(&w::CEILINGS, w::FailedTestsParts { tests: encoded }).expect(FITS))
+        }
+    }
+}
+
+pub(super) fn encode_blame(value: &Blame) -> w::Blame {
+    match value {
+        Blame::Cleared => w::Blame::Cleared,
+        Blame::Owns(failures) => w::Blame::Owns(
+            w::BlamedFailures::new(&w::CEILINGS, w::BlamedFailuresParts { failures: encode_failures(failures) })
+                .expect(FITS),
+        ),
+        Blame::Suspect(failures) => w::Blame::Suspect(
+            w::BlamedFailures::new(&w::CEILINGS, w::BlamedFailuresParts { failures: encode_failures(failures) })
+                .expect(FITS),
+        ),
+    }
+}
+
+#[expect(clippy::manual_map, reason = "step translations use explicit matches without closures")]
+pub(super) fn encode(row: &d::Verification) -> w::Verification {
+    let mut changes = List::with_capacity(u32::try_from(row.changes.len()).expect(FITS));
+    for task in &row.changes {
+        changes.push(*task).expect(FITS);
+    }
+    let mut tiers = List::with_capacity(u32::try_from(row.tiers.len()).expect(FITS));
+    for tier in &row.tiers {
+        let verdict = match &tier.verdict {
+            Some(verdict) => Some(
+                w::TierVerdict::new(
+                    &w::CEILINGS,
+                    w::TierVerdictParts { run: verdict.run, blame: encode_blame(&verdict.blame) },
+                )
+                .expect(FITS),
+            ),
+            None => None,
+        };
+        tiers
+            .push(
+                w::TierVerification::new(
+                    &w::CEILINGS,
+                    w::TierVerificationParts { tier: tier.tier.clone(), verdict, repaired: tier.repaired },
+                )
+                .expect(FITS),
+            )
+            .expect(FITS);
+    }
+    w::Verification::new(
+        &w::CEILINGS,
+        w::VerificationParts {
+            repository: names::encode_repository(row.repository),
+            commit: row.commit,
+            changes,
+            tiers,
+        },
+    )
+    .expect(FITS)
+}
+
+pub(super) fn decode_failures(value: w::Failures) -> Result<Failures, Undecodable> {
+    Ok(match value {
+        w::Failures::Many => Failures::Many,
+        w::Failures::Tests(tests) => {
+            let mut decoded = List::with_capacity(tests.tests().len());
+            for test in tests.into_parts().tests.into_boxed() {
+                let test = test.into_parts().test_id;
+                if let Some(previous) = decoded.as_slice().last()
+                    && previous >= &test
+                {
+                    return Err(Undecodable);
+                }
+                decoded.push(test).expect(FITS);
+            }
+            Failures::Tests(decoded.into_boxed())
+        }
+    })
+}
+
+pub(super) fn decode_blame(value: w::Blame) -> Result<Blame, Undecodable> {
+    Ok(match value {
+        w::Blame::Cleared => Blame::Cleared,
+        w::Blame::Owns(value) => Blame::Owns(decode_failures(value.into_parts().failures)?),
+        w::Blame::Suspect(value) => Blame::Suspect(decode_failures(value.into_parts().failures)?),
+    })
+}
+
+pub(super) fn decode(row: w::Verification) -> Result<d::Verification, Undecodable> {
+    let w::VerificationParts { repository, commit, changes, tiers } = row.into_parts();
+    let mut decoded = List::with_capacity(tiers.len());
+    for tier in tiers.into_boxed() {
+        let w::TierVerificationParts { tier, verdict, repaired } = tier.into_parts();
+        if tier.is_empty() {
+            return Err(Undecodable);
+        }
+        for byte in &tier {
+            if !byte.is_ascii_alphanumeric() && *byte != b'-' && *byte != b'_' {
+                return Err(Undecodable);
+            }
+        }
+        for previous in &decoded {
+            let previous: &d::TierVerification = previous;
+            if previous.tier == tier {
+                return Err(Undecodable);
+            }
+        }
+        let verdict = match verdict {
+            Some(verdict) => {
+                let w::TierVerdictParts { run, blame } = verdict.into_parts();
+                Some(d::TierVerdict { run, blame: decode_blame(blame)? })
+            }
+            None => None,
+        };
+        decoded.push(d::TierVerification { tier, verdict, repaired }).expect(FITS);
+    }
+    Ok(d::Verification {
+        repository: names::decode_repository(repository),
+        commit,
+        changes: changes.into_boxed(),
+        tiers: decoded.into_boxed(),
+    })
+}
