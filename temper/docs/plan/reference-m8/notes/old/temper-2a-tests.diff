+    for _ in 0..TIER_STEPS {
+        world.run_for(1);
+        if browser_row(&world).result.is_some() {
+            break;
+        }
+    }
+    let row = browser_row(&world);
+    assert_eq!(row.record.run.as_ref().expect("receipt judgement").key, baseline);
+    assert!(row.result.as_ref().expect("received verdict").received);
+    tier_hold(&mut world, TIER_RANGE, 2);
+    let mut dispatched = 0;
+    // Receipt judgement needs the same status admission as a completed run.
+    for at in 0..TIER_STEPS {
+        world.event(top::Event::StepTier { task: TIER_RANGE, entry: 1400 + at });
+        world.run_for(1);
+        let mut done = false;
+        for request in world.take_seen() {
+            if let top::Request::TierEffect { entry, .. } = &request {
+                if matches!(entry.effect.write, skein_forge::api::Write::Dispatch { .. }) {
+                    dispatched += 1;
+                }
+                world.event(top::Event::Committed { entry: entry.number });
+            }
+            if let top::Request::TierDecision { decision: top::TierDecision::Done { .. }, .. } = request {
+                done = true;
+            }
+        }
+        world.run_for(1);
+        if done {
+            break;
+        }
+    }
+    assert_eq!(dispatched, 0);
+    assert_eq!(browser_row(&world).record.judged.expect("judged merge").key, baseline);
+    assert_eq!(browser_row(&world).record.judged.expect("judged merge").tip, merge);
+    assert_eq!(
+        change_step_task(&mut world, FIRST_CHANGE, 1700, change::Status::Passed, Box::new([]), false, false),
+        change::Decision::Finish { merge }
+    );
+    let skein_fake_forge_domain::api::Answer::Statuses(statuses) =
+        world.inspect(&skein_fake_forge_domain::api::Read::Statuses { commit: world.branch(b"main") })
+    else {
+        panic!("merge statuses")
+    };
+    assert!(statuses.iter().any(|status| status.context.as_ref() == b"temper/verdict/browser"
+        && status.state == skein_fake_forge_domain::api::Check::Passed));
+    assert!(!world.has_branch(b"temper/tier/browser.2"));
+}
+
+fn logged(world: &World, since: Wall) -> top::LandingsView {
+    let top::Document::Landings(view) = world.logged(5, since).expect("landing history document") else {
+        panic!("landing history")
+    };
+    view
+}
+#[test]
+fn a_push_to_a_main_nobody_watches_is_not_logged() {
+    // Thirty-five seconds exceeds the world's shipped poll interval.
+    const POLL_SECONDS: u64 = 35;
+    let mut world = World::new(71);
+    world.adopt();
+    world.push(b"main", b"outside temper");
+    world.run_for(POLL_SECONDS);
+    world.restart();
+    world.run_for(POLL_SECONDS);
+    assert!(logged(&world, Wall::EPOCH).logged.is_empty());
+}
+
+#[test]
+fn a_coordinator_reads_the_landings_since_a_time() {
+    use temper_engine_forge_world::landings;
+    const MINUTE: u64 = 60_000_000_000;
+    const GOAL: u64 = 42;
+    let mut world = tier_history_world(World::coordinator(), &[]);
+    world.adopt_kit();
+    // The coordinator's goal follows kit's landings; the log adds no watch.
+    let kit = world
+        .stored()
+        .iter()
+        .find_map(|(_, record)| {
+            if let top::Stored::Repository(row) = record
+                && row.name.as_ref() == b"kit"
+            {
+                Some(row.provider)
+            } else {
+                None
+            }
+        })
+        .expect("adopted kit");
+    world.event(top::Event::Names {
+        task: GOAL,
+        resources: Box::new([top::Name {
+            forge: kit.forge,
+            repository: kit.repository,
+            what: top::What::Branch(Box::new([b"main".as_slice().into()])),
+        }]),
+    });
+    world.event(top::Event::Subscribe {
+        subscription: top::Subscriber {
+            task: GOAL,
+            number: GOAL,
+            topic: top::Topic::Landings { repository: kit, branch: b"main".as_slice().into() },
+            own_change: None,
+            goal_tasks: Some(Box::new([])),
+            paths: Box::new([]),
+        },
+    });
+    world.run_for(1);
+    land_for_tier(&mut world, FIRST_CHANGE, b"temper/51");
+    // TIME is minute-aligned. Cross its next boundary before the outside push.
+    let since = Wall::from_nanos(world.wall().as_nanos().div_ceil(MINUTE) * MINUTE);
+    world.run_to(Wall::from_nanos(since.as_nanos() + 1_000_000_000));
+    world.push_kit();
+    world.run_for(35); // shipped polling interval reaches both repositories.
+    world.project_landing(5, change::Way::Turn, Box::new([]));
+    world.produce(b"temper/52");
+    landings::ready_change(&mut world, SECOND_CHANGE, b"temper/52");
+    let mut row = landings::landing_row(world.change(SECOND_CHANGE));
+    row.landing.members[0].gates = Box::new([]);
+    world.event(top::Event::Landing { row });
+    landings::drive_landing(&mut world, landings::LANDING);
+    world.run_for(35); // observe the new main before finishing the baseline range.
+    let before = logged(&world, since);
+    assert_eq!(before.logged.len(), 2);
+    assert_eq!(before.logged[0].changes.as_ref(), &[SECOND_CHANGE]);
+    assert_eq!(before.logged[0].repository.as_ref(), b"org/repo");
+    assert_eq!(before.logged[0].verdicts[0].verdict, top::Verdict::Verifying);
+    assert_eq!(before.logged[1].repository.as_ref(), b"org/kit");
+    assert!(before.logged[1].changes.is_empty() && before.logged[1].verdicts.is_empty());
+    for at in 0..TIER_STEPS {
+        if tier_step(&mut world, TIER_BASELINE, 1100 + at) {
+            break;
+        }
+    }
+    release_tier(&mut world, TIER_BASELINE, 1300);
+    tier_hold(&mut world, TIER_RANGE, 2);
+    for at in 0..TIER_STEPS {
+        if tier_step(&mut world, TIER_RANGE, 1400 + at) {
+            break;
+        }
+    }
+    let after = logged(&world, since);
+    assert_eq!(after.logged[0].verdicts[0].verdict, top::Verdict::Cleared, "{:?}", browser_row(&world));
+    assert_eq!(after.logged[0].commit, before.logged[0].commit);
+}
