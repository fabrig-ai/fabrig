+        world.tick();
+    }
+    assert!(world.store.rows.values().any(|stored| matches!(stored, Record::Forge { row, .. } if matches!(row.as_ref(), forge_top::Stored::Tier(row) if row.record.sequence == 2 && row.record.run.is_none()))));
