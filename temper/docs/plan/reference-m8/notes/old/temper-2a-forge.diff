+fn tier_runs(out: &Queue<Request>) -> skein_lib::List<(u64, [u8; 32])> {
+    let mut runs = skein_lib::List::with_capacity(out.len());
+    for request in out {
+        if let Request::TierRun { number, tip, .. } = request {
