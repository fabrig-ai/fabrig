+                    .checked_add(walk_payload)?
+                    .checked_add(result_payload)?
+                    .checked_add(
+                        u64::from(l.client.rows)
+                            .checked_mul(u64::try_from(size_of::<skein_forge::api::JobAttempt>()).ok()?)?,
