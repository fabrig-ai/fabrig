+/// Finish the tier main watch's initial read before scripting a change's calls.
+pub fn prime_main(d: &mut Domain) -> Box<[Request]> {
+    use skein_forge::api::{Answer, Op, Read};
+    let (mut call, mut op) = next_call(d);
+    if let Op::Read(Read::Items { .. }) = op {
+        answer(d, call, Ok(Answer::Items { items: Box::new([]), more: false, now: env().now }));
+        (call, op) = next_call(d);
+    }
+    assert_eq!(op, Op::Read(Read::Branch { branch: b"main".as_slice().into() }));
+    let answered = answer(d, call, Ok(Answer::Commit(BASE)));
+    let mut out = Queue::with_capacity(max_out(&LIMITS));
+    for request in answered {
+        out.push(request);
+    }
+    finish_tier_keys(d, &mut out);
+    let mut values = skein_lib::List::with_capacity(out.len());
+    while let Some(request) = out.pop() {
+        values.push(request).expect("sized from queue");
+    }
+    values.into_boxed()
+}
+
+fn tier_bytes(byte: u8, length: usize) -> Box<[u8]> {
+    let mut bytes = skein_lib::List::with_capacity(u32::try_from(length).expect("fixture byte count"));
+    for _ in 0..length {
+        bytes.push(byte).expect("fixture byte count");
+    }
+    bytes.into_boxed()
+}
+
+/// Script actual tree reads for the tier stories; each tip has a distinct
+/// source object. Tests about key reuse supply their own trees instead.
+pub fn finish_tier_keys(d: &mut Domain, out: &mut Queue<Request>) {
+    let mut pending = Queue::with_capacity(max_out(&LIMITS));
+    while let Some(request) = out.pop() {
+        pending.push(request);
+    }
+    loop {
+        while let Some(request) = pending.pop() {
+            if let Request::Call {
+                call,
+                op: skein_forge::api::Op::Read(skein_forge::api::Read::Tree { object, .. }),
+                ..
+            } = request
+            {
+                for request in answer(d, call, Ok(tier_tree(object))) {
+                    pending.push(request);
+                }
+            } else {
+                out.push(request);
+            }
+        }
+        for request in ready(d) {
+            pending.push(request);
+        }
+        if pending.is_empty() {
+            break;
+        }
+    }
+}
