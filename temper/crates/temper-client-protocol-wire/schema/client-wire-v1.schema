family temper-client-wire 16

# The role, as temper-engine-domain-forge's Role, in its order.
enum Role { owned, adopted, fork, context }

# The keyed request (client/forge/records.md): forge::Adoption's fields in its order,
# the provider's repository id and the host left out. Byte fields take
# Bounds.field_bytes; checks Bounds.checks.
record Adopt { project: u32 home: bool forge: u16 owner: bytes 1024 name: bytes 1024 prefix: bytes 1024 role: Role landing: bytes 1024 ci: bool checks: list 64 u32 }

# The family's keyed requests and setup outcome (client/forge/records.md).
# temper/docs/design/client/forge/records.md: kept and new forges.
record Kept { forge: u16 }
record ManagedForge { host: bytes 255 port: u16 tls: option bytes 255 git: bytes 2048 web: option bytes 2048 git_program: option bytes 4096 }
enum ForgeAsk { github, owned, managed: ManagedForge, connected: ManagedForge }
record NewForge { forge: ForgeAsk }
enum Making { kept: Kept, new: NewForge }
record FirstEmpty { org: bytes 1024 repository: bytes 1024 playground: bool }
record CopyAddresses { addresses: list 16 bytes 512 }
enum SetUpFirst { empty: FirstEmpty, copies: CopyAddresses, nothing }
record SetUp { forge: Making first: SetUpFirst }
record GitHubApp { id: u64 read_only: option bool }
record GitHubManifest { back: option bytes 512 }
record FirstAsk { org: bytes 1024 repository: bytes 1024 label: bytes 64 }
record ForgejoAdmin { first: option FirstAsk }
record ForgejoTokens { }
enum How { github_app: GitHubApp, github_manifest: GitHubManifest, forgejo_admin: ForgejoAdmin, forgejo_tokens: ForgejoTokens }
record Replace { forge: u16 }
record Connect { forge: Making how: How }
record Install { forge: u16 back: option bytes 512 }
record Reachable { forge: u16 installation: option u64 page: u32 }
record Accept { forge: u16 installation: u64 }

# A model's trial (temper/docs/design/domain/trial.md, 6).
record TryAccount { account: u32 again: bool }
enum TrialStep { starts, answers }
enum TrialClass { transient, permanent, run, agent, lost, invalid, refused }
record TrialEnded { class: TrialClass }
enum TrialWhy { ended: TrialEnded, refused, waited }
record TrialAnswered { seconds: u32 }
record TrialFailed { why: TrialWhy }
enum TrialState { running, answered: TrialAnswered, failed: TrialFailed }
record TrialRow { account: u32 task: option u64 took: option u32 step: TrialStep state: TrialState }
versioned record Trials { rows: list 64 TrialRow }

enum Kind { forgejo, github }

# A change waiting on a person's review (client/forge/records.md; domain/forge/change/questions.md, 2).
enum ApprovalYours { counts, no_account, too_few, other_role }
record ApprovalRow { task: u64 project: u32 goal: option u64 forge: u16 kind: Kind owner: bytes 1024 name: bytes 1024 pull: u64 address: bytes 2048 title: bytes 256 since: u64 scope: u32 rule: u32 role: u32 required: u32 counted: u32 behind: u32 whole: bool yours: ApprovalYours }
versioned record Approvals { rows: list 32 ApprovalRow more: u32 }

record Looked { project: u32 }

# Away and decisions (temper/docs/design/client/forge/records.md).
enum ReachKind { wording, retry, implementation, tests, dependency, departure, money, irreversible, rules, other }
enum ReachClass { decide, ask, ask_away, wait }
record ReachSet { number: u8 }
record ReachKindOf { kind: ReachKind }
enum ClassSubject { kind: ReachKindOf, set: ReachSet }
# A person's dismissals (client/forge/records.md).
record ToBegin { project: u32 }
record GoalFrom { project: u32 chat: u64 goal: u64 at: u64 }
record KeepAsking { project: u32 subject: ClassSubject at: u64 }
enum PersonFact { to_begin: ToBegin goal_from: GoalFrom keep_asking: KeepAsking }
record Dismiss { what: PersonFact }
versioned record Dismissals { dismissed: list 8192 PersonFact }
enum ReachReason { kind, set: ReachSet, always }
record Reach { kind: ReachKind class: ReachClass reason: ReachReason under: u8 sets: u8 matched: u8 away: bool }
record SetAway { project: u32 on: bool until: option u64 }
record Overturn { project: u32 number: u32 }
record AwayRow { project: u32 since: u64 until: option u64 landed: u64 off: option u64 }
versioned record Aways { rows: list 1024 AwayRow }
record Decision { number: u32 task: u64 at: u64 question: bytes 400 took: bytes 120 why: bytes 400 overturned: bool reach: Reach }
record Asked { number: u32 task: u64 at: u64 reach: Reach }
versioned record Decisions { project: u32 rows: list 128 Decision asked: list 128 Asked cut: bool }
enum OverturnRefusal { already, unknown }
record OverturnRefused { reason: OverturnRefusal }

# temper/docs/design/client/forge/records.md: removal and reset.
record RemoveForge { forge: u16 }
record MakeCopy { address: bytes 512 }
enum MakeFrom { empty, copy: MakeCopy }
record MakeInto { project: u32 home: bool }
record MakeRepository { forge: u16 org: bytes 1024 name: bytes 1024 from: MakeFrom into: option MakeInto }
record DismissMaking { forge: u16 org: bytes 1024 name: bytes 1024 into: option u32 }

record FollowAt { after: fixed 32 }
record FollowReasonAct { after: fixed 32 reason: bytes 8192 }
record FollowMergeAct { afters: list 32 fixed 32 }
enum FollowAct { start: FollowAt, hold: FollowReasonAct, skip: FollowReasonAct, merge: FollowMergeAct }
record FollowOutcome { refusal: option bytes 8192 }
record FollowActRequest { project: u32 follow: u32 act: FollowAct }
enum Request { adopt: Adopt, set_up: SetUp, connect: Connect, install: Install, reachable: Reachable, accept: Accept, remove_forge: RemoveForge, start_playground, end_playground, replace: Replace, dismiss: Dismiss, make_repository: MakeRepository, dismiss_making: DismissMaking, looked: Looked, set_away: SetAway, overturn: Overturn, try_account: TryAccount, follow_act: FollowActRequest }
versioned record Requesting { request: Request }
enum SetUpRefusal { not_offered, not_under_the_box, busy, invalid }
record SetUpRefused { why: SetUpRefusal }
enum StartRefusal { not_offered }
record StartRefused { why: StartRefusal }
record GroupFailed { why: bytes 256 }
enum StartFailure { group: GroupFailed, account, adoption, not_connected }
record StartFailed { why: StartFailure }


# The deployment's forges, in number order (client/forge/records.md).
enum Mode { connected, managed, owned, fake }
enum SetUpStep { fetch, prepare, run, source }
enum SetUpBinary { forgejo, runner }
record SetUpFetched { binary: SetUpBinary done: u64 total: option u64 }
record SettingUp { step: option SetUpStep fetched: option SetUpFetched }
enum FailedStep { fetch, prepare, run, connect }
record SetUpFailed { why: bytes 256 at: option FailedStep }
record Connected { id: u64 login: bytes 1024 }
record Stopped { reason: bytes 1024 }
enum Connection { not_connected, not_set_up, setting_up: SettingUp, set_up_failed: SetUpFailed, connecting, connected: Connected, stopped: Stopped }
# Whether the deployment offers to set the forge up here (client/forge/records.md):
# the forge domain's, from its configuration, the box and its state.
enum Offer { not_offered, not_under_the_box, offered }
enum CreateStep { admin, org, repository, file }
record Made { id: u64 }
record CreateFailed { step: CreateStep }
enum FirstState { making, made: Made, failed: CreateFailed }
record FirstRepository { org: bytes 1024 repository: bytes 1024 state: FirstState label: bytes 64 playground: bool }
record Account { id: u64 login: bytes 1024 }
record Installation { id: u64 account: option Account suspended: bool stray: bool }
record ConnectStopped { why: bytes 256 }
enum SetupStage { admin, bot, token, org, repository, file, app, installation, state }
record AdminRefused { status: u16 stage: SetupStage }
enum AdminStop { not_admin, refused: AdminRefused, unmarked, other }
enum AppWay { manifest, pasted }
record Adoption { owner: bytes 1024 name: bytes 1024 project: u32 }
record OwnedForge { forgejo: bytes 64 runner: option bytes 64 password: bytes 512 }
record MakingMade { id: u64 branch: bytes 1024 }
enum MakeStep { admin, org, repository, file, adoption }
record Refused { status: u16 }
enum MakeFailure { taken, empty, timed_out, refused: Refused, not_allowed, other }
record MakingFailed { step: MakeStep reason: MakeFailure words: bytes 256 }
enum MakingState { waiting, making, made: MakingMade, adopting: MakingMade, failed: MakingFailed }
record RepositoryMaking { org: bytes 1024 name: bytes 1024 from: MakeFrom into: option MakeInto state: MakingState }
enum StartsWith { repository, copies: CopyAddresses, nothing }
record ForgeRow { number: u16 host: bytes 2048 kind: Kind mode: Mode connection: Connection offer: Offer first: option FirstRepository starts_with: StartsWith installations: list 64 Installation ended: option ConnectStopped app: option AppWay web: option bytes 2048 repositories: list 16 Adoption owned: option OwnedForge admin: bool ended_stop: option AdminStop read_only: bool makings: list 64 RepositoryMaking }
versioned record Forges { forges: list 16 ForgeRow linked: bool }

# The forge's reads (temper/docs/design/client/forge/served.md).
record SettingRead { kind: u32 scope: u32 number: u32 }
record ProposalItemsRead { key: u64 }
record RevisionSettingRead { kind: u32 scope: u32 number: u32 revision: u32 }
# Values are the records of temper's settings kinds below.
versioned record SettingAnswer { value: option bytes 1048576 }
record SettingValue { value: bytes 1048576 }
enum SettingEdit { set: SettingValue, removed, reset }
record ProposalItem { kind: u32 scope: u32 number: u32 edit: SettingEdit }
versioned record ProposalItemsAnswer { items: list 1024 ProposalItem owned_approval: bool }
# A branch's path (temper/docs/design/domain/forge/change/branch-path.md; client/forge/records.md).
enum Actor { person, agent, code, bar }
enum PathStep { ask, draft, plan, produce, produce_many, check, review, repair, approve, conflict, resolve, merge, catch_up, prepare, prove, turn, verify, branch, design, close_out }
record OpensCharter { charter: u32 }
record OpensRule { kind: u32 scope: u32 number: u32 }
record OpensGate { number: u32 charter: u32 }
record OpensTier { name: bytes 32 }
enum Opens { nothing, charter: OpensCharter, rule: OpensRule, gate: OpensGate, tier: OpensTier, queue, turn }
record Fact { label: text 32 value: text 184 }
record Card { who: text 128 name: text 64 facts: list 4 Fact }
record Stop { actor: Actor step: PathStep words: text 64 needed: bool over: text 16 opens: Opens card: Card }
record BranchPath { repository: option bytes 2048 branch: bytes 1024 stops: list 24 Stop }
# A project's stock ways, watched (client/forge/records.md; protocol/configuration/settings.md, 8).
record CharterWords { line: text 120 }
record ProjectWords { headline: text 120 lede: text 480 }
record StockWay { name: text 64 headline: text 120 line: text 256 path: BranchPath items: list 8 ProposalItem delegation: bool }
record WaysSubject { project: u32 }
versioned record WaysPanel { project: u32 ways: list 4 StockWay current: option u32 own: BranchPath words: option ProjectWords may_change: bool }
# A view, read when shown (client/forge/records.md and client/pages/chat/conversation.md, 3).
record ViewRead { project: u32 address: text 512 }
record WayView { name: text 64 line: text 256 path: BranchPath current: bool }
record ProposalView { before: BranchPath after: BranchPath }
record CharterView { charter: u32 card: Card }
record RuleView { kind: u32 number: u32 card: Card }
record RolesView { roles: list 16 CharterView }
record NotDrawn { words: text 512 }
enum View { way: WayView, path: BranchPath, proposal: ProposalView, charter: CharterView, rule: RuleView, roles: RolesView, not_drawn: NotDrawn }
versioned record ViewAnswer { view: View }

enum Read { playground, setting: SettingRead, proposal_items: ProposalItemsRead, deployment, revision_setting: RevisionSettingRead, program_environment, view: ViewRead }
versioned record Reading { read: Read }

# temper/docs/design/client/forge/records.md: no playground is no record.
enum PlaygroundState { starting, running, resetting }
versioned record PlaygroundAnswer { forge: u16 project: option u32 provider: u32 owner: bytes 1024 name: bytes 1024 state: PlaygroundState cues: list 8 text 256 }

# The deployment's read (temper/docs/design/client/forge/records.md).
versioned record DeploymentAnswer { welcome: bool owned: bool program_login: option bytes 8192 }
versioned record ProgramEnvironmentAnswer { environment: bytes 49216 }

# A change's watched panel (client/forge/records.md; client/forge/served.md, 2).
record ChangeSubject { task: u64 }
record Pull { number: u64 address: bytes 2048 }
# A landing's watched panel (domain/landing.md, section 14).
record LandingSubject { task: u64 }
record LandingsSubject { project: u32 ended: bool }
record ChangesSubject { project: u32 }
record StatusSubject { project: u32 }
record DecidedSubject { project: u32 }
record FollowsSubject { project: u32 }
enum Watch { change: ChangeSubject, forges, landing: LandingSubject, landings: LandingsSubject, dismissed, changes: ChangesSubject, status: StatusSubject, away, decided: DecidedSubject, trials, approvals, ways: WaysSubject, follows: FollowsSubject }
enum LandingPhase { waiting, preparing, proving, proved, turn, landed, held, cancelled }
record Receipted { run: u64 number: u64 address: bytes 2048 }
record Dispatched { attempt: u16 run: option u64 }
enum Proof { unkeyed, keyed, dispatched: Dispatched, waiting, passed: Receipted, failed: Receipted }
record GateProof { name: bytes 32 blocking: bool key: option fixed 32 proof: Proof faults: u32 }
record Member { change: u64 forge: u16 owner: bytes 1024 name: bytes 1024 branch: bytes 1024 landing: bytes 1024 pull: option Pull base: option fixed 32 candidate: option fixed 32 landed: option fixed 32 gates: list 8 GateProof }
record HeldFaults { member: u16 gate: u16 }
enum LandingHold { faults: HeldFaults }
versioned record LandingPanel { task: u64 project: u32 phase: LandingPhase hold: option LandingHold members: list 8 Member preparation: u16 stale_proofs: u32 turn: option u64 }
record LandingLine { task: u64 phase: LandingPhase changes: list 8 u64 repositories: list 8 bytes 2048 landed: list 8 fixed 32 }
versioned record LandingsPanel { project: u32 turn: option u64 landings: list 64 LandingLine }
# A project's changes (temper/docs/design/client/forge/records.md).
record ChangesQueued { task: u64 title: bytes 256 ready_since: u64 checks_since: option u64 }
record ChangesQueue { repository: bytes 2048 branch: bytes 1024 red: bool changes: list 32 ChangesQueued }
record ChangesLanded { task: u64 title: bytes 256 at: u64 }
versioned record ChangesPanel { project: u32 landing: bytes 1024 queues: list 32 ChangesQueue more: u32 landed: list 32 ChangesLanded landed_more: u32 }
# A party's project status (temper/docs/design/client/forge/records.md).
record StatusBrief { sentence: bytes 200 lede: bytes 600 at: u64 landed: u64 }
versioned record ProjectStatus { project: u32 landed: u64 last_landed: option u64 brief: option StatusBrief previous: option u64 seen: u64 queued: u32 red: bool branch: bytes 1024 }
versioned record Watching { watch: Watch }
record Queued { place: u32 ahead: list 64 u64 }
record GateReason { gate: u64 }
enum Reason { ci, gate: GateReason, semantic, review }
record Repairing { reason: Reason }
record Landed { merge: fixed 32 }
record InLanding { landing: option u64 }
record Verifying { merge: fixed 32 tiers: list 32 bytes 8192 }
record Red { merge: fixed 32 tiers: list 32 bytes 8192 }
record Cleared { merge: fixed 32 tiers: list 32 bytes 8192 uncleared: bool }
enum Step { producing, opening, recreating, reopening, checking, gating, queued: Queued, first, updating, resolving, repairing: Repairing, landing, landed: Landed, ended, ready: InLanding, preparing: InLanding, verifying: Verifying, red: Red, cleared: Cleared }
record AuthorityHold { reason: bytes 512 }
enum Hold { stalled, repairs, resolutions, updates, moved, missing, closed, retargeted, failed, rejected, authority: AuthorityHold, questions }
enum Ci { unknown, pending, passed, failed }
enum GateKind { review, approval, check }
enum Verdict { none, pending, approved, changes }
record Gate { number: u64 kind: GateKind blocks: bool verdict: Verdict }
record Used { used: u32 limit: u32 }
enum Way { queue, turn }
enum Route { none, foreman, up }
record Foreman { task: option u64 }
enum Stands { taken, foreman: Foreman, asked, held }
record Question { asker: u64 number: u64 line: bytes 256 stands: Stands }
record Questions { route: Route taken: Used open: list 8 Question }
# Landing-rule approvals (domain/forge/change/gates.md, 2; client/forge/README.md, 4).
enum RuleFreshness { exact, clean }
enum ReviewRead { unread, incomplete, complete }
record CountedReview { person: u64 head: fixed 32 }
record UnmappedReview { account: u64 head: fixed 32 verdict: Verdict }
record Approval { scope: u32 number: u32 role: u32 freshness: RuleFreshness required: u32 read: ReviewRead counted: list 256 CountedReview remaining: option u32 refused: bool }
versioned record ChangePanel { task: u64 forge: u16 owner: bytes 1024 name: bytes 1024 branch: bytes 1024 landing: bytes 1024 head: option fixed 32 pull: option Pull step: Step hold: option Hold runs: option u64 ci: Ci gates: list 64 Gate approvals: list 8192 Approval unmapped_reviews: list 256 UnmappedReview repairs: Used resolutions: Used updates: Used way: Way in_landing: option u64 questions: Questions ci_required: bool }

# Its outcome (client/forge/records.md and client/forge/family.md, 6).
record Kinds { read: bool push: bool open: bool land: bool review: bool status: bool comment: bool issue: bool branch: bool }
record Rule { branch: bytes 1024 contexts: list 64 bytes 1024 approvals: u32 dismiss_stale: bool }
enum Protection { unknown, absent, rule: Rule }
record Adopted { forge: u16 repository: u32 owner: bytes 1024 name: bytes 1024 role: Role home: bool kinds: Kinds protection: Protection }
# jig-client-protocol-wire's Refusal, encoded at jig's VERSION; 16777209 so
# that Answer at its ceiling fits jig's Owned.record (16777216).
record CoreRefused { refusal: bytes 16777209 }
enum ForgeReason { no_such_forge, not_found, no_access, refused, in_flight, too_large, unreachable, invalid_answer, another_project, home_held, prefix_occupied }
record ForgeRefused { reason: ForgeReason }
enum ForgeRefusal { role, no_such_forge, not_taken, connected, not_connected, busy, no_key, first_is_bot }
record ConnectRefused { why: ForgeRefusal }
record Link { address: bytes 2048 }
record Reached { id: u64 owner: Account name: bytes 1024 private: bool }
record Page { rows: list 100 Reached more: bool }
# unknown: the outcome's retention ended (02.2's Delivery::Application
# outcome None; client/forge/family.md, 6, "unknown past the retention").
record AcceptedInstallation { installation: u64 }

# temper/docs/design/client/forge/records.md.
enum EndRefusal { not_offered }
record EndRefused { why: EndRefusal }
record RemoveRefused { why: ForgeRefusal }
enum MakeRefusal { no_such_forge, not_offered, not_owner, invalid, home_held, full, not_failed }
record MakeRefused { why: MakeRefusal }
enum Outcome { adopted: Adopted, core_refused: CoreRefused, forge_refused: ForgeRefused, unknown, setting_up, set_up_refused: SetUpRefused, running, start_refused: StartRefused, start_failed: StartFailed, connecting, link: Link, connect_refused: ConnectRefused, page: Page, accepted: AcceptedInstallation, removed, remove_refused: RemoveRefused, reset, end_refused: EndRefused, dismissed, make_kept, make_refused: MakeRefused, looked, away, overturned, overturn_refused: OverturnRefused, tried, not_theirs, follow: FollowOutcome }
versioned record Answer { outcome: Outcome }

# Values of temper's settings kinds (temper/docs/design/domain/routing.md, 6;
# temper/docs/design/protocol/configuration/settings.md, 2).
record LandingExact { value: bytes 4096 }
record LandingOpen { value: bytes 4096 }
enum LandingLast { exact: LandingExact, open: LandingOpen }
record LandingPattern { segments: list 16 bytes 4096 last: LandingLast }
record RuleGate { number: u32 blocking: bool freshness: RuleFreshness }
record RuleApproval { role: u32 people: u32 freshness: RuleFreshness }
record LandingRule { pattern: LandingPattern enforce: bool ci: bool up_to_date: bool gates: list 64 RuleGate approvals: list 64 RuleApproval }
record ForgeCharter { charter: u32 }
record TemplateGoal { design: bool close_out: bool }
enum QuestionsRoute { none, foreman, up }
record ProjectQuestions { route: QuestionsRoute }
record ProjectWays { drafts: bool goals: bool changes: bool way: u32 }
# What reaches a person (temper/docs/design/domain/forge/attention.md, 6).
record ClassItem { subject: ClassSubject words: bytes 120 class: ReachClass }
record PathSet { number: u8 name: bytes 40 patterns: list 6 bytes 80 }
record ProjectClasses { items: list 20 ClassItem sets: list 6 PathSet }

# A project's follows (temper/docs/design/domain/forge/follows.md, 2).
record FollowRepository { forge: u16 repository: u32 }
record FollowSource { repository: FollowRepository branch: bytes 4096 paths: list 256 bytes 256 }
record FollowTarget { repository: FollowRepository branch: bytes 4096 }
record FollowPerson { person: u64 }
enum FollowOwner { person: FollowPerson }
enum FollowStart { owner, code }
enum FollowFormat { junit, lines }
record FollowCheck { workflow: bytes 256 artifact: bytes 256 format: FollowFormat }
record Follow { source: FollowSource target: FollowTarget owner: FollowOwner start: FollowStart producer: option bytes 8192 verification: FollowCheck }

# A project's follows (domain/forge/follows.md, 7).
record FollowWords { words: bytes 8192 }
record FollowWait { change: u64 }
enum FollowState { not_made, waits_word, held_by_owner: FollowWords, waits_for: FollowWait, producing, held: FollowWords, ended: FollowWords }
record FollowEntry { after: fixed 32 change: option u64 state: FollowState }
record FollowSkip { after: fixed 32 reason: bytes 8192 }
record FollowFailing { count: u32 }
enum FollowVerdict { passed, failing: FollowFailing, many }
record FollowParity { source: fixed 32 head: fixed 32 verdict: FollowVerdict run: bytes 2048 }
record FollowView { number: u32 setting: Follow source: bytes 2048 source_branch: bytes 4096 target: bytes 2048 target_branch: bytes 4096 task: option u64 stopped: option bytes 8192 lag: u32 entries: list 256 FollowEntry skips: list 256 FollowSkip parity: option FollowParity }
versioned record FollowsPanel { project: u32 follows: list 256 FollowView }
