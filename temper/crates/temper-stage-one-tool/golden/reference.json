      "prerequisite": "`reference-code-production.md` and `reference-landing.md` at the path the walk names"
    }
  ],
  "rules": [
    {
      "id": "designer.design-docs",
      "role": "designer",
      "words": "Write the family's design where the project keeps it, in this project under `docs/design`, with the status file beside each document and its Later section; never the draft's own text",
      "source": "reference-code-production.md, 5 and 14"
    },
    {
      "id": "designer.report",
      "role": "designer",
      "words": "Cite the design by path and section, and finish with a report listing the family's changes: a name, the sections and status entries each closes, what it owns, its dependencies and its effort",
      "source": "reference-code-production.md, 5"
    },
    {
      "id": "coding.push-early",
      "role": "coding",
      "words": "Push early, and finish with what was done and a Left list of what was found and not owned",
      "source": "reference-code-production.md, 6 and 14"
    },
    {
      "id": "coding.not-owned",
      "role": "coding",
      "words": "Never fix what the change does not own; a story failing for code it does not own is marked ignored, the fault its reason",
      "source": "reference-code-production.md, 14"
    },
    {
      "id": "coding.pre-pr",
      "role": "coding",
      "words": "Run the project's checks, `.temper/pre-pr`, before delivering",
      "source": "reference-code-production.md, 6 and 14"
    },
    {
      "id": "coding.ask",
      "role": "coding",
      "words": "Where the change's words and the design leave a choice it cannot make, push what it has and ask its change, with options and a recommendation",
      "source": "reference-code-production.md, 8"
    },
    {
      "id": "coordinator.cut",
      "role": "coordinator",
      "words": "The cut: read the draft and the designs, survey where worth it, shape the plan, then the shared design, a designer's change per family and its own changes, all into the goal's own branch",
      "source": "reference-code-production.md, 5"
    },
    {
      "id": "coordinator.families",
      "role": "coordinator",
      "words": "On a designer's result, the family's changes as one batch, each after its dependencies",
      "source": "reference-code-production.md, 5"
    },
    {
      "id": "coordinator.questions",
      "role": "coordinator",
      "words": "Every change names questions up; each relayed question is answered, amended, met by a new change or asked of the person",
      "source": "stock-charters.md, 3; reference-code-production.md, 8"
    },
    {
      "id": "coordinator.holds",
      "role": "coordinator",
      "words": "A hold is released, amended then released, cancelled, or passed up to the person with its reasons",
      "source": "reference-code-production.md, 9"
    },
    {
      "id": "coordinator.llm",
      "role": "coordinator",
      "words": "Each coding change at gpt-6.1-sol at its spec's effort; each designer's change at Opus 5.5, xhigh, its sub-agents at high",
      "source": "reference-code-production.md, 14"
    },
    {
      "id": "coordinator.catch-up",
      "role": "coordinator",
      "words": "The coordinator makes no catch-up changes when main moves under its goal",
      "source": "temper/docs/design/protocol/configuration/reference.md"
    },
    {
      "id": "coordinator.triage",
      "role": "coordinator",
      "words": "A red of the goal branch's tier is triaged: a live change's failure amends its words, the rest a repair change into the goal's branch",
      "source": "reference-code-production.md, 10"
    },
    {
      "id": "coordinator.close",
      "role": "coordinator",
      "words": "The coordinator makes no close-out, landing or finish once its plan's changes end; its closer settles status, lands the goal and writes the goal's report",
      "source": "temper/docs/design/protocol/configuration/reference.md"
    },
    {
      "id": "triage.report",
      "role": "triage",
      "words": "Read only; for each failing test, the change or landing it fails in, whether new, inherited or a flake, and the repair it would make",
      "source": "reference-landing.md, 6"
    }
  ]
}
