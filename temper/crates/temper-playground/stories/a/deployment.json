{
  "application": {
    "clients": {
      "bundle": null,
      "listener": {
        "socket": "127.0.0.1:7102"
      },
      "public": null
    },
    "demo": {
      "llm": {
        "asked": [
          {
            "cue": "Add CSV export to widget"
          },
          {
            "cue": "Add a dark theme to widget"
          },
          {
            "cue": "Fix widget's empty search state"
          }
        ],
        "cued": [],
        "key": "/setup/llm.key",
        "listen": {
          "socket": "127.0.0.1:443"
        },
        "otherwise": [
          "The story's scripts are in its LLM document."
        ],
        "provider": 1
      }
    },
    "sign_in": null,
    "webhooks": {
      "listener": {
        "socket": "127.0.0.1:0"
      }
    }
  },
  "engine": {
    "clients": {},
    "hosts": {
      "listener": [
        {
          "in_process": "workers"
        }
      ]
    },
    "llm": {
      "endpoints": [
        {
          "address": {
            "socket": "127.0.0.1:443"
          },
          "connect_ms": 10000,
          "dialect": 3,
          "handshake_ms": 10000,
          "headers": [],
          "name": "fake",
          "number": 1,
          "provider": "fake-provider",
          "transport": "plaintext"
        }
      ],
      "providers": [
        {
          "name": "fake-provider",
          "number": 1,
          "sources": {
            "keys": true
          },
          "endpoint": "fake"
        }
      ]
    },
    "owners": [
      {
        "provider": 1,
        "subject": "owner-a"
      }
    ]
  },
  "workers": [
    {
      "engine": {
        "in_process": "workers"
      },

      "name": "local",
      "secret": "worker.secret",
      "slots": 1
    }
  ]
}
