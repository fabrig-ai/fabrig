{
  "application": {
    "clients": {
      "bundle": null,
      "listener": {
        "socket": "127.0.0.1:7102"
      },
      "public": null
    },
    "demo": {
      "llm": {
        "asked": [
          {
            "cue": "Add CSV export to widget"
          },
          {
            "cue": "Add a dark theme to widget"
          },
          {
            "cue": "Fix widget's empty search state"
          }
        ],
        "cued": [],
        "key": "/setup/llm.key",
        "listen": {
          "socket": "127.0.0.1:443"
        },
        "otherwise": [
          "The story's scripts are in its LLM document."
        ],
        "provider": 1
      }
    },
    "sign_in": null,
    "webhooks": {
      "listener": {
        "socket": "127.0.0.1:0"
      }
    }
  },
  "engine": {
    "clients": {},
    "hosts": {
      "listener": [
        {
          "in_process": "workers"
        }
      ],
      "workers": [
        {
          "digest": "secrets/worker-a.digest",
          "name": "worker-a"
        }
      ]
    },
    "llm": {
      "endpoints": [
        {
          "address": {
            "socket": "127.0.0.1:443"
          },
          "connect_ms": 10000,
          "dialect": 3,
          "handshake_ms": 10000,
          "headers": [],
          "name": "fake",
          "number": 1,
          "provider": "fake-provider",
          "transport": "plaintext"
        }
      ],
      "providers": [
        {
          "name": "fake-provider",
          "number": 1,
          "sources": {
            "keys": true
          },
          "endpoint": "fake"
        }
      ]
    },
    "owners": [
      {
        "provider": 1,
        "subject": "owner-a"
      }
    ]
  },
  "workers": [
    {
      "agent": {
        "arguments": [
          "internal",
          "agent",
          "/opt/temper/agent.json"
        ],
        "configuration": "/opt/temper/agent.json",
        "program": "/opt/temper/bin/temper"
      },
      "engine": {
        "in_process": "workers"
      },
      "limits": {
        "overrides": {
          "core.call_answer_bytes": 2048,
          "hub.accounts": 4,
          "hub.event_bytes": 1024,
          "hub.run_calls": 1,
          "hub.slots": 1,
          "hub.transcript_bytes": 3992192,
          "hub.turn_bytes": 998044,
          "hub.turn_queue_bytes": 7984352,
          "people.words": 512,
          "tasks.message_bytes": 512,
          "tasks.result_bytes": 512,
          "hub.inbox": 8,
          "hub.held": 8,
          "tasks.run_inbox": 8
        }
      },
      "name": "worker-a",
      "secret": "worker.secret",
      "slots": 1
    }
  ]
}
