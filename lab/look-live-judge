#!/bin/sh
# Keep Python isolated, as the lab's look/capture launcher does.
umask 077
exec python3 -I -B -S - "$0" "$@" <<'PYTHON'
"""Build one committed subject and judge its three live scenes."""
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile


def run(argv, repository, *, capture=True):
    print('+ ' + shlex.join(map(str, argv)), file=sys.stderr, flush=True)
    result = subprocess.run(argv, cwd=repository, text=True,
                            stdout=subprocess.PIPE if capture else sys.stderr)
    if capture and result.stdout:
        print(result.stdout, file=sys.stderr, end='', flush=True)
    return result


def main():
    if len(sys.argv) != 3:
        print('usage: lab/look-live-judge LAB', file=sys.stderr)
        return 2
    repository = Path(sys.argv[1]).resolve().parent.parent
    sys.path.insert(0, str(repository / 'lab'))
    from look_pack import pack
    from look_bar import bar
    lab = Path(sys.argv[2]).resolve()
    if not lab.is_file() or not os.access(lab, os.X_OK):
        print(f'look-live-judge: expected an executable at {lab}', file=sys.stderr)
        return 2
    status = run(['git', 'status', '--porcelain'], repository)
    if status.returncode:
        return 4
    if status.stdout:
        print('look-live-judge: repository must be clean', file=sys.stderr)
        return 2
    commit = run(['git', 'rev-parse', 'HEAD'], repository)
    if commit.returncode:
        return 4
    build = run(['heavy', 'cargo', 'build', '--release', '-p', 'temper',
                 '-p', 'temper-client-gallery'],
                repository, capture=False)
    if build.returncode:
        return 4
    target = Path(os.environ.get('CARGO_TARGET_DIR', 'target'))
    temper = (repository / target / 'release' / 'temper').resolve()
    gallery = (repository / target / 'release' / 'temper-client-gallery').resolve()
    with tempfile.TemporaryDirectory(prefix='temper-look-live-') as scratch:
        scratch = Path(scratch)
        output = scratch / 'bundle'
        bundled = run(['heavy', 'scripts/bundle.sh', '--release', output],
                      repository, capture=False)
        if bundled.returncode:
            return 4
        printed = scratch / 'gallery'
        generated = run([gallery, printed], repository, capture=False)
        if generated.returncode:
            return 4
        gallery_tar = scratch / 'gallery.tar'
        gallery_tar.write_bytes(pack(printed))
        artifact = scratch / 'bundle.tar'
        artifact.write_bytes(pack(output))
        # Cargo links the binary into deps/; a subject's artifact has one link.
        binary = scratch / 'temper'
        shutil.copyfile(temper, binary)
        binary.chmod(0o700)
        subject = run([lab, 'subject', '--repository', repository,
                       '--commit', commit.stdout.strip(), '--exclude', 'lab',
                       '--artifact', 'temper=' + str(binary),
                       '--artifact', 'bundle=' + str(artifact),
                       '--artifact', 'gallery=' + str(gallery_tar)], repository)
    if subject.returncode:
        return subject.returncode
    digest = subject.stdout.strip()
    failures = {2: 'refused', 3: 'not enough evidence', 4: 'error'}
    key = run([lab, 'validate', 'lab/look-live', '--subject', digest], repository)
    if key.returncode:
        print(f'look-live - {failures.get(key.returncode, "error")}', flush=True)
        return key.returncode
    judged = run([lab, 'judge', 'lab/look-live', '--subject', digest], repository)
    lines = judged.stdout.splitlines()
    verdict = lines[-1] if lines else failures.get(judged.returncode, 'error')
    print(f'look-live {key.stdout.strip()} {verdict}', flush=True)
    try:
        lab_root = Path.home() / 'src/rust/tmp/lab'
        text, _ = bar(lab_root, repository / 'lab/look-live', key.stdout.strip(),
                      lab_root / 'judgements/look-live')
        print(text, end='', flush=True)
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f'look-live-judge: bar: {error}', file=sys.stderr)
    return 0 if judged.returncode in (0, 1) else judged.returncode


try:
    sys.exit(main())
except (OSError, ValueError) as error:
    print(f'look-live-judge: {error}', file=sys.stderr)
    sys.exit(4)
PYTHON
