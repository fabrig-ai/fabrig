#!/bin/sh
# draft/qa-lab.md, 6.2. Trusted prefix: TEMPER CLIENT_DIRECTORY PUBLIC_ORIGIN.
# The runner supplies http://HOST:PORT/, with no credential.
# Shell builtins only until exec; never interpret a driver's words as code.
set -f
refuse() { printf 'ctl: refused: %s\n' "$1" >&2; exit 1; }
[ "$#" -ge 4 ] || refuse 'expected temper, client directory, public origin and tool'
temper=$1 client=$2 origin=$3
shift 3
tool=$1
leading_json=no
# The actual parser also accepts --json before the tool.
if [ "$tool" = --json ]; then
    [ "$#" -ge 2 ] || refuse 'missing tool'
    tool=$2
    leading_json=yes
fi
case $tool in
    me|inbox|tasks|task|chat|activity|turn|run|wait|message|close|adopt|answer|decide|release|stop|cancel|pending|help) ;;
    *) refuse 'tool outside area 1' ;;
esac
for word do
    case $word in
        sign-in|sign-out) refuse 'sign-in and sign-out are seed operations' ;;
        --call|--call=*) refuse 'JSON call indirection' ;;
    esac
done

# directory.rs::address requires exactly one newline-terminated line.
# The redirected compound command leaves the call's stdin untouched.
address= extra=
{
    IFS= read -r address || refuse 'address is not a terminated line'
    if IFS= read -r extra || [ -n "$extra" ]; then
        refuse 'address has trailing data'
    fi
} < "$client/address" || refuse 'address cannot be read'
case $address in http://*) authority=${address#http://} ;; *) refuse 'address must be HTTP' ;; esac

# Validate the endpoint here, independently of the charter and host. Decimal
# components are length-bounded before arithmetic (no octal or overflow).
decimal() {
    case $1 in ''|*[!0-9]*) return 1 ;; esac
    [ "${#1}" -le "$2" ] || return 1
    digits=$1
    while [ "${digits#0}" != "$digits" ]; do digits=${digits#0}; done
    digits=${digits:-0}
    [ "$digits" -le "$3" ]
}
ipv4() {
    case $1 in .*|*.|*..*) return 1 ;; esac
    saved_ifs=$IFS
    IFS=.
    set -- $1
    IFS=$saved_ifs
    [ "$#" -eq 4 ] && [ "$1" = 127 ] || return 1
    for octet do
        decimal "$octet" 3 255 || return 1
        # Rust's SocketAddr rejects leading zeroes on IPv4 octets.
        [ "$octet" = "$digits" ] || return 1
    done
}
ipv6() {
    # IPv6 loopback is seven zero groups and a final one. Accept its full
    # and compressed spellings; no zone id, IPv4 mapping or other address.
    ip=$1
    case $ip in *[!0-9:]*|''|*:::*) return 1 ;; esac
    case $ip in :[!:]*) return 1 ;; esac
    compressed=no
    case $ip in
        *::*)
            compressed=yes
            before=${ip%%::*} after=${ip#*::}
            case $after in *::*) return 1 ;; esac
            ip=$before:$after ;;
    esac
    case $ip in :*) ip=${ip#:} ;; esac
    # A loopback must end in a non-compressed one group.
    case $ip in *:|'') return 1 ;; esac
    saved_ifs=$IFS
    IFS=:
    set -- $ip
    IFS=$saved_ifs
    count=$#
    if [ "$compressed" = yes ]; then
        [ "$count" -lt 8 ] || return 1
    else
        [ "$count" -eq 8 ] || return 1
    fi
    while [ "$#" -gt 1 ]; do
        case $1 in 0|00|000|0000) ;; *) return 1 ;; esac
        shift
    done
    case $1 in 1|01|001|0001) return 0 ;; *) return 1 ;; esac
}
case $authority in
    \[*\]:*)
        host=${authority%\]:*}
        host=${host#\[}
        port=${authority##*\]:}
        ipv6 "$host" || refuse 'address must be numeric loopback' ;;
    *:*)
        host=${authority%:*} port=${authority##*:}
        ipv4 "$host" || refuse 'address must be numeric loopback' ;;
    *) refuse 'address requires a port' ;;
esac
decimal "$port" 5 65535 || refuse 'invalid address port'
[ "$origin" = "http://$authority/" ] || refuse 'address differs from public origin'

if [ "$tool" = help ]; then
    if [ "$leading_json" = yes ]; then
        shift
        exec "$temper" ctl "$@" --json
    fi
    exec "$temper" ctl "$@"
fi
exec "$temper" ctl "$client" "$@"
