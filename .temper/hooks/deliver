#!/bin/sh
# Deliver: check the run's checkout against its pinned refs/temper/landing.
# Takes no arguments. Exit 0 passes; any other exit refuses the delivery.
# temper/docs/design/protocol/hooks.md, 2; temper/docs/design/domain/agent/charter.md, 4.
set -eu
cd "$(dirname "$0")/../.."
exec python3 -I -B tools/pre-pr/pre_pr.py
