#!/bin/sh
# The completed goal check (tools/pre-pr/design.md).
set -eu
cd "$(dirname "$0")/.."
rerun=$(git rev-parse --git-path temper/rerun)
if [ ! -e "$rerun" ]; then
    mkdir -p "$(dirname "$rerun")"
    printf '%s\n' 'temper-rerun 1 0' > "$rerun.tmp"
    mv "$rerun.tmp" "$rerun"
fi
exec python3 -I -B tools/pre-pr/pre_pr.py --goal "$@"
