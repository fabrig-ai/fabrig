#!/usr/bin/env python3
"""Stop, update, and detach one queue (tools/queue/design.md, 3.7)."""

import argparse
import importlib.util
import os
from pathlib import Path
import select
import shutil
import subprocess
import sys
import time


sys.dont_write_bytecode = True
SPEC = importlib.util.spec_from_file_location("restart_authority", Path(__file__).resolve().with_name("authority.py"))
authority = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(authority)


def command(argv, repo, *, pass_fds=()):
    return subprocess.run(argv, cwd=repo, stdin=subprocess.DEVNULL, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
                          pass_fds=pass_fds).stdout.strip()


def queue_pid(repo):
    """Prefer the queue flock's holder; fall back to exactly one mq run."""
    return queue_pid_for_lock(repo.with_name(repo.name + ".queue.lock"))


def queue_pid_for_lock(lock):
    if lock.exists():
        info = lock.stat()
        holders = set()
        for line in Path("/proc/locks").read_text().splitlines():
            fields = line.split()
            if len(fields) < 6 or fields[1] != "FLOCK":
                continue
            major, minor, inode = fields[5].split(":")
            if (int(major, 16), int(minor, 16), int(inode)) == (
                    os.major(info.st_dev), os.minor(info.st_dev), info.st_ino):
                holders.add(int(fields[4]))
        if len(holders) == 1 and next(iter(holders)) > 0:
            return holders.pop()
        if holders:
            raise RuntimeError(f"expected one queue lock holder, found {sorted(holders)}")
    return None  # Process absence grants no checkout or remote-job authority.


def await_start(child, ready_fd, output):
    # The child acknowledges only after it adopted the same authority inode,
    # checked durable ownership, and acquired its checkout lock. No drain sleep.
    if not select.select([ready_fd], [], [], 3)[0] or os.read(ready_fd, 64) != b"READY\n":
        raise RuntimeError(f"mq run startup unconfirmed; stop file retained; see {output}")
    if child.poll() is not None:
        raise RuntimeError(f"mq run exited {child.returncode}; see {output}")


def restart(repo, wait, home, *, batch=8, authority_dir=None):
    layout = authority.Layout(authority_dir, home=home)
    with layout.restart_lock():
        if command(["git", "rev-parse", "--show-toplevel"], repo) != str(repo):
            raise RuntimeError("--repo must name the checkout root")
        pid = queue_pid(repo)
        process_fd = None
        if pid is not None:
            try:
                process_fd = os.pidfd_open(pid)
            except ProcessLookupError:
                pass
        stop = home / "src/fabrig/queue.stop"
        authority.durable.publish(stop, b"", private_parent=False)
        print(f"waiting up to {wait:g}s for mq run pid {pid}; stop file {stop}", flush=True)
        if process_fd is not None:
            try:
                if not select.select([process_fd], [], [], wait)[0]:
                    raise RuntimeError(f"timed out waiting for mq run pid {pid}; stop file retained")
            finally:
                os.close(process_fd)
        # Never hold main authority while asking the existing writer to drain.
        # A competing direct writer may win this acquisition: then refuse safely.
        with layout.acquire() as lease:
            layout.legacy_guard(repo)
            with authority.checkout_lock(repo) as checkout:
                inherited = (lease.fd, checkout.fd)
                command(["git", "fetch", "origin"], repo, pass_fds=inherited)
                command(["git", "switch", "--detach", "origin/main"], repo, pass_fds=inherited)
                commit = command(["git", "rev-parse", "HEAD"], repo, pass_fds=inherited)
            output = home / "src/fabrig/notes/queue.out"
            output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            read_fd, write_fd = os.pipe()
            try:
                with output.open("a") as log:
                    os.chmod(output, 0o600)
                    argv = ["python3", "-B", "-u", "tools/queue/mq", "run", "--repo", str(repo),
                            "--authority-dir", str(layout.root), "--authority-fd", str(lease.fd),
                            "--startup-fd", str(write_fd)]
                    if batch != 8:
                        argv.extend(["--batch", str(batch)])
                    try:
                        stop.unlink()
                        authority.durable.sync_directory(stop.parent)
                        child = subprocess.Popen(argv, cwd=repo, stdin=subprocess.DEVNULL,
                            stdout=log, stderr=log, start_new_session=True,
                            pass_fds=(lease.fd, write_fd))
                    except BaseException:
                        authority.durable.publish(stop, b"", private_parent=False)
                        raise
                os.close(write_fd)
                write_fd = None
                try:
                    await_start(child, read_fd, output)
                except BaseException:
                    authority.durable.publish(stop, b"", private_parent=False)
                    raise
            finally:
                os.close(read_fd)
                if write_fd is not None:
                    os.close(write_fd)
            # Close our duplicate, never LOCK_UN the child's open description.
            print(f"mq run pid {child.pid}, main {commit}; output {output}")


def seconds(value):
    number = float(value)
    if not 0 <= number < float("inf"):
        raise argparse.ArgumentTypeError("must be a finite nonnegative number")
    return number


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--train-config", type=Path)
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--authority-dir", type=Path,
                        help="shared queue authority directory; never per clone")
    parser.add_argument("--wait", type=seconds, default=1800)
    parser.add_argument("--batch", type=positive, default=8,
                        help="branches per batch for the replacement queue (default: 8)")
    args = parser.parse_args()
    if args.train_config is not None:
        try:
            spec = importlib.util.spec_from_file_location("restart_operation", Path(__file__).resolve().with_name("operation.py"))
            operation = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(operation)
            config = operation.configuration(args.train_config)
            if "--batch" in sys.argv and args.batch != config["batch"]:
                raise ValueError("restart must preserve the train configuration batch")
            if "--repo" in sys.argv or "--authority-dir" in sys.argv:
                raise ValueError("train configuration owns authority and checkout paths")
            operation.restart(args.train_config, args.wait)
            return 0
        except (OSError, ValueError, RuntimeError) as error:
            print(f"restart train: {error}", file=sys.stderr)
            return 1
    for name in ("cargo", "heavy", "post", "git"):
        if shutil.which(name) is None:
            print(f"restart: missing {name} on PATH; invoke from bash -lc", file=sys.stderr)
            return 2
    try:
        restart(args.repo.expanduser().resolve(), args.wait, Path.home(), batch=args.batch,
                authority_dir=args.authority_dir)
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"restart: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
