#!/usr/bin/env python3
"""Stop, update, and detach one queue (tools/queue/design.md, 3.7)."""

import argparse
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import select
import shutil
import subprocess
import sys
import time


sys.dont_write_bytecode = True
DIRECTORY = Path(__file__).resolve().parent
RUNTIME_FILES = ("mq", "restart", "worker.py", "always.txt", "read-by-tests.txt", "leads.txt")


def runtime_module(directory, repo, *, external=False):
    directory = directory.expanduser().resolve(strict=True)
    if external:
        if directory == repo or repo in directory.parents:
            raise ValueError("--runtime must be outside the queue checkout")
        for name in RUNTIME_FILES:
            path = directory / name
            if path.is_symlink() or not path.is_file():
                raise ValueError(f"--runtime requires a regular {name}")
            if name in ("mq", "restart") or name.endswith(".py"):
                compile(path.read_bytes(), str(path), "exec")
    loader = importlib.machinery.SourceFileLoader("restart_mq", str(directory / "mq"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    if external:
        if any(not callable(getattr(module, name, None)) for name in
               ("validate_repair", "advertised_repair", "log_repair_refusal")):
            raise ValueError("--runtime requires queue code supporting pinned repairs")
        for name in ("always.txt", "read-by-tests.txt"):
            if not module.lines(directory / name):
                raise ValueError(f"--runtime requires a nonempty {name}")
        if not dict(line.split() for line in module.lines(directory / "leads.txt")):
            raise ValueError("--runtime requires a nonempty leads.txt")
    return module, directory


def command(argv, repo):
    return subprocess.run(argv, cwd=repo, stdin=subprocess.DEVNULL, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True).stdout.strip()


def queue_pid(repo):
    """Prefer the queue flock's holder; fall back to exactly one mq run."""
    lock = repo.with_name(repo.name + ".queue.lock")
    if lock.exists():
        info = lock.stat()
        holders = set()
        for line in Path("/proc/locks").read_text().splitlines():
            fields = line.split()
            if len(fields) < 6 or fields[1] != "FLOCK":
                continue
            major, minor, inode = fields[5].split(":")
            if (int(major, 16), int(minor, 16), int(inode)) == (
                    os.major(info.st_dev), os.minor(info.st_dev), info.st_ino):
                holders.add(int(fields[4]))
        if len(holders) == 1 and next(iter(holders)) > 0:
            return holders.pop()
        if holders:
            raise RuntimeError(f"expected one queue lock holder, found {sorted(holders)}")
    pattern = r"(^|[[:space:]])([^[:space:]]*/)?tools/queue/mq[[:space:]]+run([[:space:]]|$)"
    result = subprocess.run(["pgrep", "-f", pattern], stdin=subprocess.DEVNULL,
                            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode not in (0, 1):
        raise RuntimeError(f"pgrep failed: {result.stderr.strip()}")
    pids = [int(pid) for pid in result.stdout.split()]
    if len(pids) != 1:
        raise RuntimeError(f"expected exactly one mq run, found {pids}")
    return pids[0]


def restart(repo, wait, home, *, batch=8, runtime=None,
            repair_ready=None, repair_tip=None, repair_reason=None):
    if command(["git", "rev-parse", "--show-toplevel"], repo) != str(repo):
        raise RuntimeError("--repo must name the checkout root")
    repair = None
    if runtime is not None or any(value is not None for value in (repair_ready, repair_tip, repair_reason)):
        module, directory = runtime_module(DIRECTORY, repo)
        raw = {"name": repair_ready, "tip": repair_tip, "reason": repair_reason}
        try:
            if runtime is not None:
                module, directory = runtime_module(runtime, repo, external=True)
            repair = module.validate_repair(repo, repair_ready, repair_tip, repair_reason)
            if repair is not None:
                module.advertised_repair(repo, repair)
        except (OSError, ValueError, RuntimeError, SyntaxError) as error:
            module.log_repair_refusal(home / "src/fabrig/notes/queue.jsonl", raw, error)
            raise
    frozen = {name: (directory / name).read_bytes() for name in RUNTIME_FILES} if runtime is not None else {}
    pid = queue_pid(repo)
    # A pidfd follows this process even if the kernel later reuses its pid.
    try:
        process_fd = os.pidfd_open(pid)
    except ProcessLookupError:
        process_fd = None
    stop = home / "src/fabrig/queue.stop"
    stop.touch(mode=0o600)
    print(f"waiting up to {wait:g}s for mq run pid {pid}; stop file {stop}", flush=True)
    if process_fd is not None:
        try:
            if not select.select([process_fd], [], [], wait)[0]:
                raise RuntimeError(f"timed out waiting for mq run pid {pid}; stop file retained")
        finally:
            os.close(process_fd)
    command(["git", "fetch", "origin"], repo)
    command(["git", "switch", "--detach", "origin/main"], repo)
    commit = command(["git", "rev-parse", "HEAD"], repo)
    if any((directory / name).read_bytes() != data for name, data in frozen.items()):
        error = RuntimeError("external runtime changed while draining; stop file retained")
        module.log_repair_refusal(home / "src/fabrig/notes/queue.jsonl", repair, error)
        raise error
    output = home / "src/fabrig/notes/queue.out"
    try:
        output.parent.mkdir(parents=True, exist_ok=True)
        with output.open("a") as log:
            os.chmod(output, 0o600)
            argv = (["python3", "-B", "-u", str(directory / "mq")] if runtime is not None else
                    ["python3", "-u", "tools/queue/mq"])
            argv.extend(["run", "--repo", str(repo)])
            if batch != 8 or repair is not None:
                argv.extend(["--batch", str(batch)])
            if repair is not None:
                argv.extend(["--repair-ready", repair["name"], "--repair-tip", repair["tip"],
                             "--repair-reason", repair["reason"]])
            stop.unlink()
            child = subprocess.Popen(argv,
                                     cwd=repo, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                     start_new_session=True)
        time.sleep(3)
        if child.poll() is not None:
            raise RuntimeError(f"mq run exited {child.returncode}; see {output}")
    except BaseException:
        stop.touch(mode=0o600)
        raise
    print(f"mq run pid {child.pid}, main {commit}; output {output}")


def seconds(value):
    number = float(value)
    if not 0 <= number < float("inf"):
        raise argparse.ArgumentTypeError("must be a finite nonnegative number")
    return number


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--wait", type=seconds, default=1800)
    parser.add_argument("--batch", type=positive, default=8,
                        help="branches per batch for the replacement queue (default: 8)")
    parser.add_argument("--runtime", type=Path, help="complete queue runtime directory outside --repo")
    parser.add_argument("--repair-ready")
    parser.add_argument("--repair-tip")
    parser.add_argument("--repair-reason")
    args = parser.parse_args()
    for name in ("cargo", "heavy", "post", "git"):
        if shutil.which(name) is None:
            print(f"restart: missing {name} on PATH; invoke from bash -lc", file=sys.stderr)
            return 2
    try:
        restart(args.repo.expanduser().resolve(), args.wait, Path.home(), batch=args.batch,
                runtime=args.runtime, repair_ready=args.repair_ready, repair_tip=args.repair_tip,
                repair_reason=args.repair_reason)
        return 0
    except (OSError, ValueError, RuntimeError, SyntaxError, subprocess.SubprocessError) as error:
        print(f"restart: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
