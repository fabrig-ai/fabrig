#!/usr/bin/env python3
"""Stop, update, and detach one queue (tools/queue/design.md, 3.7)."""

import argparse
import importlib.machinery
import importlib.util
import hashlib
import os
from pathlib import Path
import select
import shutil
import subprocess
import sys
import time


sys.dont_write_bytecode = True
DIRECTORY = Path(__file__).resolve().parent
RUNTIME_FILES = ("mq", "restart", "worker.py", "always.txt", "read-by-tests.txt", "leads.txt",
                 "train.py", "authority.py", "recovery.py", "durable.py", "publication.py", "coordinators.txt")


def runtime_module(directory, repo, *, external=False):
    directory = directory.expanduser().resolve(strict=True)
    frozen = {}
    if external and (directory == repo or repo in directory.parents):
        raise ValueError("--runtime must be outside the queue checkout")
    for name in RUNTIME_FILES:
        path = directory / name
        if path.is_symlink() or not path.is_file():
            raise ValueError(f"--runtime requires a regular {name}")
        frozen[name] = path.read_bytes()
        if name in ("mq", "restart") or name.endswith(".py"):
            compile(frozen[name], str(path), "exec")
    loader = importlib.machinery.SourceFileLoader("restart_mq", str(directory / "mq"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    runtime_unchanged(directory, frozen)
    if any(not callable(getattr(module, name, None)) for name in
           ("validate_repair", "repair_pending", "advertised_repair", "log_repair_refusal", "UnknownHeavyError",
            "writer_authority", "writer_fds")):
        raise ValueError("--runtime requires queue code supporting pinned repairs and shared authority")
    if (Path(module.authority.__file__).resolve() != directory / "authority.py" or
            Path(module.authority.durable.__file__).resolve() != directory / "durable.py"):
        raise ValueError("--runtime authority dependencies must load from the frozen directory")
    for name in ("always.txt", "read-by-tests.txt"):
        if not module.lines(directory / name):
            raise ValueError(f"--runtime requires a nonempty {name}")
    if not dict(line.split() for line in module.lines(directory / "leads.txt")):
        raise ValueError("--runtime requires a nonempty leads.txt")
    module.publication.coordinators(frozen["coordinators.txt"])
    if Path(module.publication.__file__).resolve() != directory / "publication.py":
        raise ValueError("publication dependency must load from the frozen directory")
    module.restart_identity = {"version": 1, "files": {name: hashlib.sha256(data).hexdigest()
                                for name, data in frozen.items()},
                               "coordinators_sha256": hashlib.sha256(frozen["coordinators.txt"]).hexdigest()}
    module.restart_frozen = frozen
    return module, directory


def runtime_unchanged(directory, frozen):
    try:
        for name, data in frozen.items():
            path = directory / name
            if path.is_symlink() or path.read_bytes() != data:
                raise RuntimeError("external runtime changed while draining; stop file retained")
    except OSError as error:
        raise RuntimeError("external runtime dependency missing while draining; stop file retained") from error


SPEC = importlib.util.spec_from_file_location("restart_authority", Path(__file__).resolve().with_name("authority.py"))
authority = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(authority)


def command(argv, repo, *, pass_fds=()):
    return subprocess.run(argv, cwd=repo, stdin=subprocess.DEVNULL, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
                          pass_fds=pass_fds).stdout.strip()


def queue_pid(repo):
    """Prefer the queue flock's holder; fall back to exactly one mq run."""
    lock = repo.with_name(repo.name + ".queue.lock")
    if lock.exists():
        info = lock.stat()
        holders = set()
        for line in Path("/proc/locks").read_text().splitlines():
            fields = line.split()
            if len(fields) < 6 or fields[1] != "FLOCK":
                continue
            major, minor, inode = fields[5].split(":")
            if (int(major, 16), int(minor, 16), int(inode)) == (
                    os.major(info.st_dev), os.minor(info.st_dev), info.st_ino):
                holders.add(int(fields[4]))
        if len(holders) == 1 and next(iter(holders)) > 0:
            return holders.pop()
        if holders:
            raise RuntimeError(f"expected one queue lock holder, found {sorted(holders)}")
    return None  # Process absence grants no checkout or remote-job authority.


def await_start(child, ready_fd, output):
    # The child acknowledges only after it adopted the same authority inode,
    # checked durable ownership, and acquired its checkout lock. No drain sleep.
    if not select.select([ready_fd], [], [], 3)[0] or os.read(ready_fd, 64) != b"READY\n":
        raise RuntimeError(f"mq run startup unconfirmed; stop file retained; see {output}")
    if child.poll() is not None:
        raise RuntimeError(f"mq run exited {child.returncode}; see {output}")


def restart(repo, wait, home, *, batch=8, authority_dir=None, runtime=None,
            repair_ready=None, repair_tip=None, repair_reason=None, repair_hold=False):
    repair = None
    selected_authority = authority
    module, directory = runtime_module(DIRECTORY, repo)
    frozen = module.restart_frozen
    if runtime is not None or repair_hold or any(value is not None for value in (repair_ready, repair_tip, repair_reason)):
        raw = {"name": repair_ready, "tip": repair_tip, "reason": repair_reason}
        try:
            if runtime is not None:
                module, directory = runtime_module(runtime, repo, external=True)
                selected_authority = module.authority
                frozen = module.restart_frozen
            repair = module.validate_repair(repo, repair_ready, repair_tip, repair_reason, hold=repair_hold)
            if repair is not None and module.repair_pending(repo, repair):
                module.advertised_repair(repo, repair)
        except (OSError, ValueError, RuntimeError, SyntaxError) as error:
            module.log_repair_refusal(home / "src/fabrig/notes/queue.jsonl", raw, error)
            raise
    def guard_runtime():
        runtime_unchanged(directory, frozen)

    try:
        layout = selected_authority.Layout(authority_dir, home=home)
        with layout.restart_lock():
            if command(["git", "rev-parse", "--show-toplevel"], repo) != str(repo):
                raise RuntimeError("--repo must name the checkout root")
            pid = queue_pid(repo)
            process_fd = None
            if pid is not None:
                try:
                    process_fd = os.pidfd_open(pid)
                except ProcessLookupError:
                    pass
            stop = home / "src/fabrig/queue.stop"
            selected_authority.durable.publish(stop, b"", private_parent=False)
            print(f"waiting up to {wait:g}s for mq run pid {pid}; stop file {stop}", flush=True)
            if process_fd is not None:
                try:
                    if not select.select([process_fd], [], [], wait)[0]:
                        raise RuntimeError(f"timed out waiting for mq run pid {pid}; stop file retained")
                finally:
                    os.close(process_fd)
            # Never hold main authority while asking the existing writer to drain.
            # A competing direct writer may win this acquisition: then refuse safely.
            with layout.acquire() as lease:
                layout.legacy_guard(repo)
                guard_runtime()
                with selected_authority.checkout_lock(repo) as checkout:
                    if repair is not None and module.repair_pending(repo, repair):
                        module.advertised_repair(repo, repair)
                    with module.writer_authority(lease, checkout):
                        store = module.publication.Store(layout.root / "publications", repo, module.git,
                            lambda: (lease.guard(), checkout.guard(), layout.legacy_guard(repo)))
                        store.reconcile()
                    inherited = (lease.fd, checkout.fd)
                    command(["git", "fetch", "origin"], repo, pass_fds=inherited)
                    command(["git", "switch", "--detach", "origin/main"], repo, pass_fds=inherited)
                    commit = command(["git", "rev-parse", "HEAD"], repo, pass_fds=inherited)
                output = home / "src/fabrig/notes/queue.out"
                output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                read_fd, write_fd = os.pipe()
                try:
                    with output.open("a") as log:
                        os.chmod(output, 0o600)
                        script = str(directory / "mq") if runtime is not None else "tools/queue/mq"
                        argv = ["python3", "-B", "-u", script, "run", "--repo", str(repo),
                                "--authority-dir", str(layout.root), "--authority-fd", str(lease.fd),
                                "--startup-fd", str(write_fd)]
                        if batch != 8 or repair is not None:
                            argv.extend(["--batch", str(batch)])
                        if repair is not None:
                            argv.extend(["--repair-ready", repair["name"], "--repair-tip", repair["tip"],
                                         "--repair-reason", repair["reason"]])
                        if repair_hold:
                            argv.append("--repair-hold")
                        try:
                            guard_runtime()
                            stop.unlink()
                            selected_authority.durable.sync_directory(stop.parent)
                            child = subprocess.Popen(argv, cwd=repo, stdin=subprocess.DEVNULL,
                                stdout=log, stderr=log, start_new_session=True,
                                pass_fds=(lease.fd, write_fd))
                        except BaseException:
                            selected_authority.durable.publish(stop, b"", private_parent=False)
                            raise
                    os.close(write_fd)
                    write_fd = None
                    try:
                        await_start(child, read_fd, output)
                    except BaseException:
                        selected_authority.durable.publish(stop, b"", private_parent=False)
                        raise
                finally:
                    os.close(read_fd)
                    if write_fd is not None:
                        os.close(write_fd)
                # Close our duplicate, never LOCK_UN the child's open description.
                print(f"mq run pid {child.pid}, main {commit}; output {output}")
    except BaseException as error:
        if runtime is not None or repair is not None:
            module.log_repair_refusal(home / "src/fabrig/notes/queue.jsonl", repair, error)
        raise


def seconds(value):
    number = float(value)
    if not 0 <= number < float("inf"):
        raise argparse.ArgumentTypeError("must be a finite nonnegative number")
    return number


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--authority-dir", type=Path,
                        help="shared queue authority directory; never per clone")
    parser.add_argument("--wait", type=seconds, default=1800)
    parser.add_argument("--batch", type=positive, default=8,
                        help="branches per batch for the replacement queue (default: 8)")
    parser.add_argument("--runtime", type=Path, help="complete queue runtime directory outside --repo")
    parser.add_argument("--repair-ready")
    parser.add_argument("--repair-tip")
    parser.add_argument("--repair-reason")
    parser.add_argument("--repair-hold", action="store_true", help="hold admission after the pinned repair")
    args = parser.parse_args()
    try:
        for name in ("cargo", "heavy", "post", "git"):
            if shutil.which(name) is None:
                error = RuntimeError(f"missing {name} on PATH; invoke from bash -lc")
                raw = {"name": args.repair_ready, "tip": args.repair_tip, "reason": args.repair_reason}
                if args.repair_hold or any(value is not None for value in raw.values()):
                    module, _ = runtime_module(DIRECTORY, args.repo)
                    module.log_repair_refusal(Path.home() / "src/fabrig/notes/queue.jsonl", raw, error)
                print(f"restart: {error}", file=sys.stderr)
                return 2
        restart(args.repo.expanduser().resolve(), args.wait, Path.home(), batch=args.batch,
                authority_dir=args.authority_dir, runtime=args.runtime, repair_ready=args.repair_ready,
                repair_tip=args.repair_tip, repair_reason=args.repair_reason, repair_hold=args.repair_hold)
        return 0
    except (OSError, ValueError, RuntimeError, SyntaxError, subprocess.SubprocessError) as error:
        print(f"restart: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
