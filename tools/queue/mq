WRITER_LEASE = None
WRITER_CHECKOUT = None


@contextmanager
def writer_authority(lease, checkout):
    global WRITER_LEASE, WRITER_CHECKOUT
    previous = WRITER_LEASE, WRITER_CHECKOUT
    WRITER_LEASE, WRITER_CHECKOUT = lease, checkout
    try:
        yield
    finally:
        WRITER_LEASE, WRITER_CHECKOUT = previous


def writer_fds():
    if WRITER_LEASE is None:
        return ()
    WRITER_LEASE.guard()
    WRITER_CHECKOUT.guard()
    return (WRITER_LEASE.fd, WRITER_CHECKOUT.fd)


class DiskFloorError(RuntimeError):
    """A capacity refusal defers work without rejecting branches."""

    def __init__(self, message, report_key):
        super().__init__(message)
        self.report_key = report_key


class UnknownHeavyError(RuntimeError):
    """Client termination leaves job completion and input ownership unresolved."""


def repair_options(parser):
    parser.add_argument("--repair-ready", help="one Ops-named ready branch repairing a recurring gate failure")
    parser.add_argument("--repair-tip", help="exact full commit OID for the repair")
    parser.add_argument("--repair-reason", help="why this repair must prove before ordinary batches")
    parser.add_argument("--repair-hold", action="store_true", help="hold authority after this repair; admit nothing else")


def validate_repair(repo, ready, tip, reason, *, hold=False):
    if ready is None and tip is None and reason is None:
        if hold:
            raise ValueError("--repair-hold requires the complete repair triplet")
        return None
    if any(value is None for value in (ready, tip, reason)):
        raise ValueError("--repair-ready, --repair-tip and --repair-reason must be supplied together")
    if (len(ready.split("/")) != 3 or not ready.startswith("ready/") or
            git(repo, "check-ref-format", "refs/heads/" + ready, check=False).returncode):
        raise ValueError("--repair-ready must be a valid full ready/<lead>/<task> branch")
    if not re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", tip):
        raise ValueError("--repair-tip must be a full lowercase commit OID")
    if not reason.strip() or not reason.isprintable():
        raise ValueError("--repair-reason must be nonempty printable text")
    return {"name": ready, "tip": tip, "reason": reason}


def read_queue_state(repo, path=None):
    """Validate private consumption evidence without changing the state contract."""
    path = path or repo.with_name(repo.name + ".state.json")
    if not path.exists() and not path.is_symlink():
        return {}
    state = authority.durable.read_json(authority.durable.read_bytes(path))
    fields = {"tried", "batches_since_full", "last_full", "last_full_main", "selected_passed",
              "idle_since", "reported_errors"}
    if not isinstance(state, dict) or not set(state) <= fields or not isinstance(state.get("tried"), dict):
        raise ValueError("invalid queue state/consumption evidence")
    for name, tip in state["tried"].items():
        if (len(name.split("/")) != 3 or not name.startswith("ready/") or
                git(repo, "check-ref-format", "refs/heads/" + name, check=False).returncode):
            raise ValueError("invalid ready name in queue state")
        authority.oid(tip)
    if "batches_since_full" in state and (type(state["batches_since_full"]) is not int or
                                          state["batches_since_full"] < 0):
        raise ValueError("invalid queue state batch counter")
    for name in ("last_full", "idle_since"):
        if name in state and (type(state[name]) not in (int, float) or
                              not 0 <= state[name] <= sys.float_info.max):
            raise ValueError("invalid queue state time")
    if "last_full_main" in state:
        authority.oid(state["last_full_main"])
    if "selected_passed" in state and type(state["selected_passed"]) is not bool:
        raise ValueError("invalid queue state selection flag")
    if "reported_errors" in state and (not isinstance(state["reported_errors"], list) or
                                       any(not isinstance(v, str) for v in state["reported_errors"])):
        raise ValueError("invalid queue state errors")
    return state


def repair_pending(repo, repair):
    return read_queue_state(repo).get("tried", {}).get(repair["name"]) != repair["tip"]


def advertised_repair(repo, repair):
    ref = "refs/heads/" + repair["name"]
    output = git(repo, "ls-remote", "--heads", "origin", ref).stdout.splitlines()
    if output != [repair["tip"] + "\t" + ref]:
        raise ValueError("repair ready branch is missing or no longer advertises the pinned tip")


def log_repair_refusal(path, repair, error):
    record = {"start": utc_now(), "end": utc_now(), "branches": [], "steps": [], "posts": [],
              "event": "repair-refusal", "repair": repair, "outcome": "error", "error": str(error)}
    log_batch(path, record)
    return record


def free_gb(repo):
    return shutil.disk_usage(repo).free / GB


def lines(path):
    return [line.split("#", 1)[0].strip() for line in path.read_text().splitlines()
            if line.split("#", 1)[0].strip()]


def command(argv, cwd, *, check=True, body=None, separate_stderr=False):
    kwargs = {"stdin": subprocess.DEVNULL} if body is None else {"input": body}
    if WRITER_LEASE is not None:
        kwargs["pass_fds"] = writer_fds()
    result = subprocess.run(argv, cwd=cwd, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE if separate_stderr else subprocess.STDOUT, **kwargs)
    if check and result.returncode:
        raise RuntimeError(f"{shlex.join(argv)} exited {result.returncode}:\n{result.stdout}{result.stderr or ''}")
    return result


def git(repo, *args, check=True):
    return command(["git", *args], repo, check=check)


def list_candidates(repo, tried):
    """Pin each ready tip, oldest committer timestamp first; suppress tried tips."""
    output = git(repo, "for-each-ref", "--format=%(refname:strip=3) %(objectname) %(committerdate:unix)",
                 "refs/remotes/origin/ready/").stdout
    candidates = []
    for line in output.splitlines():
        name, tip, timestamp = line.split()
        if len(name.split("/", 2)) == 3 and tried.get(name) != tip:
            candidates.append({"name": name, "tip": tip, "timestamp": int(timestamp)})
    return sorted(candidates, key=lambda branch: (branch["timestamp"], branch["name"]))


def ensure_clean(repo):
    if git(repo, "status", "--porcelain").stdout:
        raise RuntimeError("queue checkout has uncommitted or untracked files")


def merge_ratchets(repo, paths, before):
    """Recount against the batch's baseline after a ratchet-only conflict."""
    git(repo, "checkout", "--ours", "--", *paths)
    git(repo, "add", "--", *paths)
    git(repo, "commit", "--no-edit")
    for tree in sorted({path.split("/", 1)[0] for path in paths}):
        argv = ["python3", "-I", "-B", str(repo / tree / "scripts/old_forms.py"), "--write"]
        result = command(argv, repo / tree, check=False)
        if result.returncode == 1:
            git(repo, "reset", "--hard", before)
            return {"step": f"ratchet:{tree}", "error": result.stdout}
        if result.returncode:
            raise RuntimeError(f"{shlex.join(argv)} exited {result.returncode}:\n{result.stdout}")
    git(repo, "add", "--", *paths)
    git(repo, "commit", "--amend", "--no-edit")
    return None


def build_batch(repo, branches, base="origin/main", *, keep_contained=False):
    """Merge pinned tips, resolving only old-form baselines (design.md, 3.3)."""
    ensure_clean(repo)
    git(repo, "switch", "--detach", base)
    merged, conflicts = [], []
    ratchets = {f"{tree}/scripts/old-forms.txt" for tree in TREES}
    for branch in branches:
        before = git(repo, "rev-parse", "HEAD").stdout.strip()
        result = git(repo, "merge", "--no-ff", "-m", f"Merge {branch['name']}", branch["tip"], check=False)
        if result.returncode:
            output = git(repo, "diff", "--name-only", "--diff-filter=U", "-z").stdout
            conflicting = output.split("\0")[:-1] if output else []
            if conflicting and set(conflicting) <= ratchets:
                failure = merge_ratchets(repo, conflicting, before)
                if failure:
                    conflicts.append({**branch, **failure})
                    continue
            else:
                if git(repo, "rev-parse", "--verify", "--quiet", "MERGE_HEAD", check=False).returncode == 0:
                    git(repo, "merge", "--abort")
                if not conflicting:
                    raise RuntimeError(f"merge of {branch['name']} failed:\n{result.stdout}")
                conflicts.append({**branch, "error": result.stdout})
                continue
        commit = git(repo, "rev-parse", "HEAD").stdout.strip()
        if commit != before or keep_contained:
            merged.append({**branch, "commit": commit, "parent": before})
    return merged, conflicts


def full_inputs(paths):
    return any(path == "Cargo.toml" or
               PurePosixPath(path).name in ("rustfmt.toml", "clippy.toml") or
               PurePosixPath(path).name.startswith("rust-toolchain") or
               ".config" in PurePosixPath(path).parts for path in paths)


def package_owners(metadata):
    root = Path(metadata["workspace_root"])
    members = set(metadata["workspace_members"])
    owners = [(PurePosixPath(Path(package["manifest_path"]).parent.relative_to(root).as_posix()),
               package["id"]) for package in metadata["packages"] if package["id"] in members]
    return sorted(owners, key=lambda owner: len(owner[0].parts), reverse=True)


def lock_changes(base, head, metadata):
    """Map changed lock entries to HEAD resolve IDs (design.md, 2.1)."""
    def entries(document):
        return {(package["name"], package["version"], package.get("source")):
                tuple(sorted(package.get("dependencies", [])))
                for package in tomllib.loads(document).get("package", [])}

    before, after = entries(base), entries(head)
    changed = {key for key in before.keys() | after.keys() if before.get(key) != after.get(key)}
    return {package["id"] for package in metadata["packages"]
            if (package["name"], package["version"], package.get("source")) in changed}


def selection(changed_paths, metadata, *, always=None, read_by_tests=None, locked=None):
    """Choose docs, full, or owners plus reverse dependencies (design.md, 2)."""
    paths = list(changed_paths)
    if full_inputs(paths):
        return "full"
    patterns = lines(CONFIG / "read-by-tests.txt") if read_by_tests is None else read_by_tests
    if any(fnmatch.fnmatchcase(path, pattern) for path in paths for pattern in patterns):
        return "full"
    members = set(metadata.get("workspace_members", []))
    packages = {p["id"]: p for p in metadata.get("packages", []) if p["id"] in members}
    owners = package_owners(metadata) if metadata else []
    selected = set()
    for path in paths:
        if path.startswith("tools/"):
            continue
        if path == "Cargo.lock":
            if locked is None:
                raise ValueError("lockfile selection requires base and HEAD lock entries")
            selected.update(locked)
            continue
        for directory, package_id in owners:
            try:
                local = PurePosixPath(path).relative_to(directory)
            except ValueError:
                continue
            if local.as_posix() in ("Cargo.toml", "build.rs") or (len(local.parts) > 1 and local.parts[0] in
                                                   ("src", "tests", "benches", "examples")):
                selected.add(package_id)
                break
            if not path.endswith(".md"):
                return "full"
            break
        else:
            if not path.endswith(".md"):
                return "full"
    if not selected and "Cargo.lock" not in paths:
        return "docs"
    resolve = metadata.get("resolve")
    if resolve is None:
        raise ValueError("package selection requires cargo metadata's resolve graph")
    reverse = {node["id"]: set() for node in resolve["nodes"]}
    for node in resolve["nodes"]:
        for dependency in node["dependencies"]:
            reverse[dependency].add(node["id"])
    pending = list(selected)
    while pending:
        for dependent in reverse[pending.pop()] - selected:
            selected.add(dependent)
            pending.append(dependent)
    names = {packages[package_id]["name"] for package_id in selected if package_id in packages}
    always = lines(CONFIG / "always.txt") if always is None else always
    available = {package["name"] for package in packages.values()}
    missing = set(always) - available
    if missing:
        raise ValueError(f"always.txt names missing workspace packages: {', '.join(sorted(missing))}")
    return names | set(always)


def load_workspace_metadata(repo):
    return json.loads(command(["cargo", "metadata", "--no-deps", "--format-version", "1", "--locked"],
                             repo, separate_stderr=True).stdout)


def load_metadata(repo):
    # --no-deps supplies ownership; the resolved graph includes normal, build and dev edges.
    metadata = load_workspace_metadata(repo)
    resolved = json.loads(command(["cargo", "metadata", "--format-version", "1", "--locked"],
                                 repo, separate_stderr=True).stdout)
    metadata["resolve"] = resolved["resolve"]
    metadata["packages"] = resolved["packages"]
    return metadata


def changed_paths(repo, candidate="HEAD", *, base="origin/main"):
    """Compare checked parent and candidate trees (design.md, 2)."""
    # Include both sides of a rename, so moving a file cannot hide its old owner.
    output = git(repo, "diff", "--name-only", "--no-renames", "-z", base, candidate, "--").stdout
    return output.split("\0")[:-1] if output else []


def preview_changed_paths(repo, tip, *, base="origin/main"):
    """Preview an unmerged tip from its merge base (design.md, 2)."""
    ancestor = git(repo, "merge-base", base, tip).stdout.strip()
    return changed_paths(repo, tip, base=ancestor)


def check_commands(repo, selected, paths, *, metadata=None):
    steps = []
    if selected == "full":
        steps.append(("fmt", ["cargo", "fmt", "--all", "--check"], repo))
    elif selected != "docs":
        rust_paths = [PurePosixPath(path) for path in paths if path.endswith(".rs")]
        if rust_paths:
            metadata = load_workspace_metadata(repo) if metadata is None else metadata
            owners = package_owners(metadata)
            ids = set()
            for path in rust_paths:
                for directory, package_id in owners:
                    if path.is_relative_to(directory):
                        ids.add(package_id)
                        break
            names = sorted(package["name"] for package in metadata["packages"] if package["id"] in ids)
            if names:
                scope = [arg for name in names for arg in ("-p", name)]
                steps.append(("fmt", ["cargo", "fmt", "--check", *scope], repo))
    if selected and selected != "docs":
        scope = ["--workspace"] if selected == "full" else [arg for name in sorted(selected) for arg in ("-p", name)]
        steps.extend([
            ("clippy", ["heavy", "--gate", "cargo", "clippy", *scope, "--all-targets", "--", "-D", "warnings"], repo),
            ("build", ["heavy", "--gate", "cargo", "nextest", "run", *scope, "--no-run"], repo),
            ("default", ["heavy", "--gate", "cargo", "nextest", "run", *scope, "--no-fail-fast"], repo),
            ("fuzzy", ["heavy", "--gate", "cargo", "nextest", "run", *scope, "--no-fail-fast", "--profile", "fuzzy"], repo),
        ])
    return steps


def ratchet_commands(repo, paths, *, check_only=False):
    trees = {path.split("/", 1)[0] for path in paths} & set(TREES)
    return [(f"ratchet:{tree}", ["python3", "-I", "-B", str(repo / tree / "scripts/old_forms.py"),
                              *([] if check_only else ["--write"])],
             repo / tree) for tree in sorted(trees)]


def tools_commands(repo):
    """Discover tracked offline suites, honoring executable shebangs (design.md, 2.3)."""
    commands = []
    for entry in git(repo, "ls-files", "--stage", "-z", "--", "tools/").stdout.split("\0"):
        if not entry:
            continue
        attributes, path = entry.split("\t", 1)
        mode = attributes.split()[0]
        name = PurePosixPath(path).name
        # This suite installs real systemd units; run it manually on a builder.
        if path == "tools/heavy/test-heavy-recovery":
            continue
        if fnmatch.fnmatchcase(name, "test_*.py"):
            commands.append((path, ["python3", "-I", "-B", path], repo))
        elif name.startswith("test-") and mode == "100755":
            commands.append((path, ["./" + path], repo))
    return commands


def unknown_heavy(step):
    return (step.get("command", [None])[0] == "heavy" and
            (step.get("returncode", 0) < 0 or step.get("returncode") == 137))


def run_step(name, argv, cwd, log, *, runner, clock, timeout=None, status_observer=None):
    log.write(f"\n[{name}] {shlex.join(argv)} (cwd {cwd})\n")
    log.flush()
    output_start = log.tell()
    started = clock()
    launch_error = None
    try:
        options = {} if timeout is None else {"timeout": timeout}
        if WRITER_LEASE is not None:
            options["pass_fds"] = writer_fds()
        result = runner(argv, cwd=cwd, stdin=subprocess.DEVNULL,
                        stdout=log, stderr=subprocess.STDOUT, **options)
    except subprocess.TimeoutExpired:
        log.write(f"Timed out after {timeout} seconds\n")
        code = 124
    except OSError as error:
        log.write(f"{error}\n")
        code = 127
        launch_error = str(error)
    else:
        code = result.returncode
        # Repair ownership must be blocked before log I/O or any later checker work.
        # Observer failures are not command launch failures.
        if status_observer is not None:
            status_observer({"name": name, "command": argv, "cwd": str(cwd),
                             "returncode": code, "green": code == 0})
    log.flush()
    log.seek(output_start)
    output = log.read()
    log.seek(0, os.SEEK_END)
    refused = code == 2 and "below the disk floor" in output and argv[0] == "heavy"
    green = code == 0 or (name in ("build", "default", "fuzzy") and code == 4)
    outcome = {"name": name, "command": argv, "returncode": code,
               "cwd": str(cwd), "green": green, "duration": clock() - started}
    if refused:
        outcome["error"] = output.strip()
    if launch_error is not None:
        outcome["launch_error"] = launch_error
    return outcome


def run_tools(repo, log, *, runner=subprocess.run, clock=time.monotonic, observer=None,
              status_observer=None):
    """Run every tools suite before cargo, with a deadline per suite (design.md, 2.3)."""
    started = clock()
    suites = []
    for name, argv, cwd in tools_commands(repo):
        suites.append(run_step(name, argv, cwd, log, runner=runner, clock=clock, timeout=TOOLS_TIMEOUT,
                               status_observer=status_observer))
        if observer is not None:
            observer(suites[-1])
    return {"name": "tools", "green": all(suite["green"] for suite in suites),
            "duration": clock() - started, "suites": suites}


def run_checks(repo, selected, paths, log_path, *, runner=subprocess.run, clock=time.monotonic,
               check_only=False, metadata=None, observer=None, outcomes=None, status_observer=None):
    """Run serially, logging output; nextest's empty selection is green."""
    outcomes = [] if outcomes is None else outcomes
    def record(outcome):
        outcomes.append(outcome)
        if observer is not None:
            observer(outcome)

    with log_path.open("a+") as log:
        os.chmod(log_path, 0o600)
        for name, argv, cwd in ratchet_commands(repo, paths, check_only=check_only):
            record(run_step(name, argv, cwd, log, runner=runner, clock=clock, status_observer=status_observer))
            if not outcomes[-1]["green"]:
                return outcomes
            baseline = f"{cwd.name}/scripts/old-forms.txt"
            if not check_only and git(repo, "diff", "--name-only", "--", baseline).stdout:
                git(repo, "add", "--", baseline)
                git(repo, "commit", "-m", f"Lower {cwd.name} old-form baselines")
        if selected == "full" or any(path.startswith("tools/") for path in paths):
            record(run_tools(repo, log, runner=runner, clock=clock, observer=observer,
                             status_observer=status_observer))
            if not outcomes[-1]["green"]:
                return outcomes
        for name, argv, cwd in check_commands(repo, selected, paths, metadata=metadata):
            record(run_step(name, argv, cwd, log, runner=runner, clock=clock, status_observer=status_observer))
            if not outcomes[-1]["green"]:
                break
    return outcomes


def prune_test_executables(repo, disk_floor, batch_started_ns):
    """Relink old test binaries when disk is low (design.md, 3.5)."""
    report = {"count": 0, "gb": 0.0}
    goal = disk_floor + 40
    if free_gb(repo) >= goal:
        return report
    deps = repo / "target/debug/deps"
    if any(path.is_symlink() for path in (repo / "target", repo / "target/debug", deps)):
        return report
    if not deps.is_dir():
        return report
    candidates = []
    for path in deps.iterdir():
        info = path.lstat()
        if (stat.S_ISREG(info.st_mode) and info.st_mode & 0o111 and
                path.suffix not in (".rlib", ".rmeta", ".so", ".d") and
                info.st_mtime_ns < batch_started_ns):
            candidates.append((info.st_mtime_ns, path, info))
    removed = 0
    for _, path, original in sorted(candidates):
        if free_gb(repo) >= goal:
            break
        try:
            current = path.lstat()
            if (not stat.S_ISREG(current.st_mode) or not current.st_mode & 0o111 or
                    current.st_mtime_ns >= batch_started_ns or
                    (current.st_dev, current.st_ino) != (original.st_dev, original.st_ino)):
                continue
            path.unlink()
            report["count"] += 1
            removed += current.st_size
        except FileNotFoundError:
            continue
        except OSError as error:
            report.setdefault("errors", []).append(f"{path.name}: {error}")
    report["gb"] = removed / GB
    return report


def bisect(branches, check):
    """Try each half in order, letting check land successful groups before the next."""
    if not branches:
        return [], []
    if check(branches):
        return list(branches), []
    if len(branches) == 1:
        return [], list(branches)
    middle = len(branches) // 2
    left_green, left_red = bisect(branches[:middle], check)
    right_green, right_red = bisect(branches[middle:], check)
    return left_green + right_green, left_red + right_red


def cleanup_ready(repo, branches, origin):
    """After journal confirmation, delete only still-pinned ready tips."""
    cleanup = []
    for branch in branches:
        ref = f"refs/heads/{branch['name']}"
        current = git(repo, "ls-remote", "--heads", origin, ref, check=False)
        if current.returncode:
            cleanup.append({"branch": branch["name"], "error": current.stdout})
        elif current.stdout.split()[:1] == [branch["tip"]]:
            result = git(repo, "push", "--force-with-lease=" + ref + ":" + branch["tip"],
                         origin, ":" + ref, check=False)
            cleanup.append({"branch": branch["name"], "returncode": result.returncode,
                            "output": result.stdout})
        else:
            cleanup.append({"branch": branch["name"], "outcome": "tip changed or branch absent; preserved"})
    return cleanup


def post(address, subject, body):
    result = command(["post", "send", "--as", "queue", address, subject], CONFIG, check=False, body=body)
    return {"address": address, "returncode": result.returncode,
            "sent": result.returncode in (0, 3), "output": result.stdout}


def log_batch(path, record):
    path.parent.mkdir(parents=True, exist_ok=True)
    with publication.journal_lock(path):
        previous = publication.durable.read_bytes(path) if path.exists() or path.is_symlink() else b""
        prospective = previous + publication.durable.encoded(record)
        publication.journal_records(prospective)
        publication.durable.publish(path, prospective, private_parent=False)


def utc_now():
    return datetime.now(timezone.utc).isoformat()


class Queue:
    """Persistent cycle policy and effects (tools/queue/design.md, 1–3)."""

    def __init__(self, repo, *, batch=8, full_every=5, dry=False,
                 state_path=None, log_path=None, checker=run_checks, poster=post,
                 metadata_loader=load_metadata, now=time.time, disk_floor=45, repair=None, writer_guard=None,
                 repair_hold=False, publication_root=None, read_only=False):
        if writer_guard is None:
            raise RuntimeError("Queue mutation requires an injected sole authority/startup guard")
        self.repo = Path(repo).resolve()
        self._writer_guard = writer_guard
        self.batch = batch
        self.disk_floor = disk_floor
        self.full_every = full_every
        self.dry = dry
        self.state_path = state_path or self.repo.with_name(self.repo.name + ".state.json")
        self.log_path = log_path or Path.home() / "src/fabrig/notes/queue.jsonl"
        self.repair = repair
        self.repair_consumed = False
        self.repair_hold = repair_hold
        self.hold_logged = False
        self.unknown_marker = None
        self.unknown_durable = False
        if repair is not None or repair_hold:
            try:
                supplied = repair or {}
                self.repair = validate_repair(self.repo, supplied.get("name"), supplied.get("tip"),
                                              supplied.get("reason"), hold=repair_hold)
            except ValueError as error:
                log_repair_refusal(self.log_path, repair, error)
                raise
        self.checker = checker
        self.poster = poster
        self.metadata_loader = metadata_loader
        self.now = now
        self.base = "origin/main"
        self.last_selection = None
        self.last_merged = []
        self.last_conflicts = []
        self.error_record = None
        root = publication_root or (WRITER_LEASE.path.parent / "publications" if WRITER_LEASE is not None
                                    else self.repo.with_name(self.repo.name + ".publications"))
        self.publications = publication.Store(root, self.repo, lambda *a, **kw: git(*a, **kw), self.writer_guard)
        if (self.dry or read_only) and self.publications.entries():
            raise RuntimeError("pending publication requires nondry reconciliation before plan/dry")
        # Reconcile saved authority before loading any replacement roster.
        try:
            recovered = self.publications.reconcile()
        except Exception as error:
            # Only the existing Ops notification mapping is needed to report blocked recovery.
            ops = dict(line.split() for line in lines(CONFIG / "leads.txt")).get("ops")
            if ops is not None:
                try:
                    self.poster(ops, "queue publication recovery blocked",
                                "\n".join(str(error).splitlines()[:10]) + "\n")
                except Exception:
                    pass  # The startup error still reaches the operator's process log.
            raise
        self.coordinators_bytes = (CONFIG / "coordinators.txt").read_bytes()
        publication.coordinators(self.coordinators_bytes)
        self.leads = dict(line.split() for line in lines(CONFIG / "leads.txt"))
        self.state = (read_queue_state(self.repo, self.state_path) if repair is not None else
                      json.loads(self.state_path.read_text()) if self.state_path.exists() else {})
        self.state.setdefault("tried", {})
        self.state.setdefault("batches_since_full", 0)
        for intent in recovered:
            self.finish_publication(intent)

    def writer_guard(self):
        if self.unknown_marker is not None:
            raise UnknownHeavyError("heavy completion is unresolved; recovery/reset/admission are blocked")
        authority.checkout_guard(self.repo)
        if self._writer_guard is None:
            raise RuntimeError("Queue mutation requires an injected sole authority/startup guard")
        self._writer_guard()

    def finish_publication(self, intent, record=None):
        self.writer_guard()
        directory = self.publications.root / intent["publication_id"]
        if not self.publications.confirmed(directory, intent):
            raise RuntimeError("ready cleanup requires journal confirmation")
        marker = directory / "effects-confirmation.json"
        if marker.exists() or marker.is_symlink():
            saved = publication.durable.read_json(publication.durable.read_bytes(marker))
            if (not isinstance(saved, dict) or type(saved.get("version")) is not int or
                    saved != {"version": 1, "publication_id": intent["publication_id"]}):
                raise ValueError("invalid publication effects confirmation")
            return
        effects = record if record is not None else {**intent["journal_row"], "posts": []}
        effects.update(event="publication-effects", publication=intent["publication_id"])
        for key in publication.LANDING_FIELDS:
            effects.pop(key, None)
        effects["cleanup"] = cleanup_ready(self.repo, intent["merges"], intent["origin"])
        for branch in intent["merges"]:
            self.state["tried"][branch["name"]] = branch["tip"]
        self.save()
        for branch in intent["merges"]:
            self.notify(effects, branch["name"].split("/", 2)[1], f"landed {branch['name']}",
                        f"{branch['name']} at {branch['tip']}\n"
                        f"Merge commit: {branch['commit']}\nMain: {intent['candidate']}\n"
                        f"Log: {effects.get('log', self.log_path)}\n")
        if record is None:
            effects["end"] = utc_now()
            log_batch(self.log_path, effects)
        publication.durable.publish(marker, publication.durable.encoded(
            {"version": 1, "publication_id": intent["publication_id"]}), immutable=True)

    def reconcile_publications(self):
        for intent in self.publications.reconcile():
            self.finish_publication(intent)

    def save(self):
        self.writer_guard()
        if self.dry:
            return
        temporary = self.state_path.with_suffix(self.state_path.suffix + ".tmp")
        with temporary.open("w") as output:
            os.chmod(temporary, 0o600)
            json.dump(self.state, output, sort_keys=True)
            output.flush()
            os.fsync(output.fileno())
        temporary.replace(self.state_path)

    def full_due(self):
        return (self.state["batches_since_full"] + 1 >= self.full_every or
                self.now() - self.state.get("last_full", 0) >= 3600)

    def idle_due(self):
        main = git(self.repo, "rev-parse", "origin/main").stdout.strip()
        return (self.now() - self.state.get("idle_since", self.now()) >= 600 and
                main != self.state.get("last_full_main"))

    def choose(self, paths, *, base="origin/main", candidate="HEAD", preview=False):
        """Use parent/candidate lock blobs and the candidate checkout's graph (design.md, 2.1)."""
        if self.full_due() or full_inputs(paths):
            return "full"
        # A plan has not merged the batch, so its checkout cannot resolve changed manifests.
        if preview and any(path == "Cargo.lock" or (not path.startswith("tools/") and
                           PurePosixPath(path).name == "Cargo.toml") for path in paths):
            return "full"
        # Only source-directory Markdown can select a package; other docs and tools need no graph.
        if all(path.startswith("tools/") or (path.endswith(".md") and not
               set(PurePosixPath(path).parts[:-1]) & {"src", "tests", "benches", "examples"})
               for path in paths):
            return selection(paths, {})
        if not preview:
            head, expected = git(self.repo, "rev-parse", "HEAD", f"{candidate}^{{commit}}").stdout.splitlines()
            if head != expected:
                raise ValueError("checked selection requires the candidate checkout")
        metadata = self.metadata_loader(self.repo)
        locked = None
        if "Cargo.lock" in paths:
            before = git(self.repo, "show", f"{base}:Cargo.lock").stdout
            after = git(self.repo, "show", f"{candidate}:Cargo.lock").stdout
            locked = lock_changes(before, after, metadata)
        return selection(paths, metadata, locked=locked)

    def notify(self, record, lead, subject, body):
        if self.dry:
            return
        address = self.leads.get(lead)
        if address is None:
            record["posts"].append({"lead": lead, "sent": False, "error": "unknown lead"})
            return
        try:
            record["posts"].append(self.poster(address, subject, body))
        except Exception as error:
            # A delivery failure never changes a gate result.
            record["posts"].append({"address": address, "sent": False, "error": str(error)})

    def reject(self, record, branch, detail):
        self.state["tried"][branch["name"]] = branch["tip"]
        self.save()
        self.notify(record, branch["name"].split("/", 2)[1], f"rejected {branch['name']}",
                    f"{branch['name']} at {branch['tip']}\n{detail}\nLog: {record['log']}\n"
                    "Push a new tip to retry.\n")

    def attempt(self, branches, *, idle=False, force_full=False, skip_conflicts=False, repair=None):
        self.writer_guard()
        self.reconcile_publications()
        if repair is not None and not writer_fds():
            raise RuntimeError("repair checks require held authority and checkout descriptors")
        available = free_gb(self.repo)
        if available < self.disk_floor:
            host = socket.gethostname()
            error = DiskFloorError(
                f"{host}: {available:.1f} GB free, below queue disk floor {self.disk_floor} GB",
                f"disk-floor:{host}")
            if repair is not None:
                self.error_record = {"start": utc_now(), "end": utc_now(), "branches": branches,
                                     "steps": [], "posts": [], "outcome": "error", "dry": self.dry,
                                     "repair": repair, "error": str(error)}
                log_batch(self.log_path, self.error_record)
            raise error
        batch_started_ns = time.time_ns()
        record = {"start": utc_now(), "branches": branches, "selection": None,
                  "steps": [], "posts": [], "dry": self.dry, "outcome": "error"}
        if repair is not None:
            record["repair"] = repair
        record["log"] = str(self.log_path.parent / f"queue-{uuid.uuid4().hex}.log")
        self.log_path.parent.mkdir(parents=True, exist_ok=True)
        detail = Path(record["log"])
        tried_before = dict(self.state["tried"])
        selected = None
        self.last_selection = None
        self.last_merged = []
        self.last_conflicts = []
        detail.write_text("")
        os.chmod(detail, 0o600)
        try:
            record["parent"] = git(self.repo, "rev-parse", self.base).stdout.strip()
            merged, conflicts = build_batch(self.repo, branches, self.base)
            self.last_merged, self.last_conflicts = merged, conflicts
            carrying_or_conflicted = {b["name"] for b in merged + conflicts}
            reachable = [b for b in branches if b["name"] not in carrying_or_conflicted]
            record["conflicts"] = conflicts
            detail.write_text("\n".join(conflict["error"] for conflict in conflicts))
            if conflicts and not skip_conflicts:
                for branch in conflicts:
                    self.reject(record, branch, f"failing step: {branch['step']}"
                                if "step" in branch else "merge conflict")
                record["outcome"] = "conflict"
                return False
            if not merged and not idle:
                for branch in conflicts:
                    self.reject(record, branch, f"failing step: {branch['step']}"
                                if "step" in branch else "merge conflict")
                for branch in reachable:
                    self.state["tried"][branch["name"]] = branch["tip"]
                self.save()
                if conflicts:
                    record["outcome"] = "conflict"
                else:
                    record.update(event="already-reachable", outcome="green")
                return True
            paths = changed_paths(self.repo)
            selected = "full" if idle or force_full else self.choose(paths)
            self.last_selection = selected
            record["selection"] = sorted(selected) if isinstance(selected, set) else selected
            record["changed_paths"] = paths
            check_options = {}
            if repair is not None:
                record["prepared_candidate"] = git(self.repo, "rev-parse", "HEAD").stdout.strip()
                self.unknown_paths = (WRITER_LEASE.path.parent / "queue.unresolved",
                                      self.repo / ".git/queue.unresolved")
                provenance = {
                    "version": 1, "kind": "repair-heavy-unknown", "repair": repair,
                    "repo": str(self.repo), "runtime": str(CONFIG), "pid": os.getpid(), "record": record}

                def block_unknown(step=None):
                    # Set ownership before encoding, publication, or fallible provenance reads.
                    self.unknown_marker = provenance
                    if step is not None:
                        record["steps"].append(step)
                    record["candidate"] = record["prepared_candidate"]
                    record["error"] = "heavy client terminated; completion unknown; reconciliation unsupported"
                    provenance["record"] = {**record, "steps": list(record["steps"])}
                    self.publish_unknown()
                    raise UnknownHeavyError(record["error"])

                def observe_status(step):
                    if unknown_heavy(step):
                        block_unknown(step)

                check_options = {"status_observer": observe_status, "outcomes": record["steps"]}
            record["steps"] = self.checker(self.repo, selected, paths, detail, **check_options)
            if repair is not None:
                if self.unknown_marker is not None:
                    raise UnknownHeavyError("heavy completion unresolved; checker cannot adjudicate")
                steps = [suite for step in record["steps"] for suite in step.get("suites", [step])]
                unknown = next((step for step in steps if unknown_heavy(step)), None)
                if unknown is not None:
                    block_unknown()
                launches = [suite for step in record["steps"] for suite in step.get("suites", [step])
                            if "launch_error" in suite]
                if launches:
                    raise RuntimeError("repair check could not launch: " + launches[0]["launch_error"])
            refusal = next((step["error"] for step in record["steps"] if "error" in step), None)
            if refusal is not None:
                host = socket.gethostname()
                raise DiskFloorError(
                    f"{host}: {free_gb(self.repo):.1f} GB free; heavy refused:\n{refusal}",
                    f"heavy-disk-floor:{refusal}")
            green = all(step["green"] for step in record["steps"])
            ensure_clean(self.repo)
            if selected == "full":
                self.state["last_full"] = self.now()
                self.state["batches_since_full"] = 0
                if green:
                    self.state["last_full_main"] = git(self.repo, "rev-parse", "HEAD").stdout.strip()
                    self.state["selected_passed"] = False
                elif self.state.get("selected_passed"):
                    self.notify(record, "ops", "possible queue selection gap",
                                f"A full check failed after selected checks passed.\nLog: {detail}\n"
                                "Review always.txt and read-by-tests.txt.\n")
            else:
                self.state["batches_since_full"] += 1
                if green:
                    self.state["selected_passed"] = True
            if green:
                if self.dry:
                    self.base = git(self.repo, "rev-parse", "HEAD").stdout.strip()
                if not self.dry and merged:
                    self.writer_guard()
                    record["commit"] = git(self.repo, "rev-parse", "HEAD").stdout.strip()
                    origin = publication.explicit_origin(git(self.repo, "remote", "get-url", "--push", "origin").stdout.strip())
                    intent = self.publications.prepare(origin, {**record, "journal_path": str(self.log_path)},
                                                       merged, self.coordinators_bytes, utc_now())
                    # No mutable HEAD or replacement roster participates after this boundary.
                    record["event"] = "publication-attempt"
                    self.publications.reconcile_one(intent)
                    self.finish_publication(intent, record)
                if not self.dry:
                    for branch in reachable:
                        self.state["tried"][branch["name"]] = branch["tip"]
                record["outcome"] = "green"
            else:
                record["outcome"] = "red"
                if len(merged) == 1:
                    failed = next((step["name"] for step in record["steps"] if not step["green"]), "no checks ran")
                    self.reject(record, merged[0], f"failing step: {failed}")
            for branch in conflicts:
                self.reject(record, branch, f"failing step: {branch['step']}"
                                if "step" in branch else "merge conflict")
            self.save()
            return green
        except Exception as error:
            self.state["tried"] = tried_before
            record["outcome"] = "error"
            self.error_record = record
            record["error"] = str(error)
            if self.unknown_marker is None:
                try:
                    self.save()
                except Exception as save_error:
                    record["state_error"] = str(save_error)
            with detail.open("a") as output:
                output.write(f"\n{error}\n")
            raise
        finally:
            if self.unknown_marker is not None:
                record["target_cleanup"] = {"skipped": "heavy completion unknown"}
            else:
                try:
                    self.writer_guard()
                    record["target_cleanup"] = prune_test_executables(self.repo, self.disk_floor, batch_started_ns)
                except Exception as cleanup_error:
                    record["target_cleanup"] = {"error": str(cleanup_error)}
            record["end"] = utc_now()
            log_batch(self.log_path, record)

    def recover(self, error):
        """Restore main and report each distinct error once per episode (design.md, 3.1)."""
        self.writer_guard()
        record = {**self.error_record, "event": "recovery"} if self.error_record else {
            "start": utc_now(), "branches": [], "steps": [], "posts": [],
            "outcome": "error", "error": str(error), "dry": self.dry,
        }
        try:
            self.reconcile_publications()
            if git(self.repo, "rev-parse", "--verify", "--quiet", "MERGE_HEAD", check=False).returncode == 0:
                git(self.repo, "merge", "--abort")
            git(self.repo, "switch", "--detach", "--discard-changes", "origin/main")
        except Exception as recovery_error:
            record["recovery_error"] = str(recovery_error)
        reported = self.state.setdefault("reported_errors", [])
        report_key = getattr(error, "report_key", str(error))
        if report_key not in reported:
            summary = "\n".join(str(error).splitlines()[:10])
            if record.get("log"):
                summary += f"\nLog: {record['log']}"
            self.notify(record, "ops", "queue error", summary + "\n")
            reported.append(report_key)
        try:
            self.save()
        except Exception as save_error:
            record["state_error"] = str(save_error)
        record["end"] = utc_now()
        log_batch(self.log_path, record)

    def publish_unknown(self):
        self.unknown_durable = False
        if isinstance(self.unknown_marker, dict):
            self.unknown_marker = authority.durable.encoded(self.unknown_marker)
        for path in self.unknown_paths:
            authority.durable.publish(path, self.unknown_marker, immutable=True,
                                       private_parent=path.parent != self.repo / ".git")
        self.unknown_durable = True

    def retain_unknown(self, stop, sleeper):
        """Retain live leases until durable guards exist; no absence proves release."""
        while True:
            try:
                self.publish_unknown()
            except Exception as error:
                print(f"mq: unresolved marker publication failed; retaining ownership: {error}", file=sys.stderr)
            if self.unknown_durable and stop.exists():
                return
            sleeper(60)

    def run(self, stop, *, sleeper=time.sleep):
        while True:
            if self.unknown_marker is not None:
                self.retain_unknown(stop, sleeper)
                return
            if stop.exists():
                return
            self.writer_guard()
            self.error_record = None
            try:
                worked = self.cycle()
                if self.state.get("reported_errors"):
                    self.state["reported_errors"] = []
                    self.save()
            except Exception as error:
                if self.unknown_marker is not None:
                    continue
                try:
                    self.recover(error)
                except Exception as recovery_error:
                    print(f"mq: recovery failed: {recovery_error}", file=sys.stderr)
                worked = False
            if not worked and not stop.exists():
                sleeper(60)

    def plan(self):
        self.error_record = None
        try:
            self.plan_once()
        except Exception as error:
            if self.repair is not None and self.error_record is None:
                self.error_record = log_repair_refusal(self.log_path, self.repair, error)
            raise

    def plan_once(self):
        self.writer_guard()
        self.reconcile_publications()
        if self.repair_hold and self.pending_repair() is None:
            self.enter_hold()
            print("repair hold: no admission")
            return
        git(self.repo, "fetch", "--prune", "origin")
        branches, repair = self.next_batch()
        if not branches and not self.idle_due():
            print("nothing to do")
            return
        paths = sorted({path for branch in branches for path in preview_changed_paths(self.repo, branch["tip"])})
        selected = "full" if repair or not branches else self.choose(paths, preview=True)
        print(json.dumps({"branches": branches,
                          **({"repair": repair} if repair else {}),
                          "selection": sorted(selected) if isinstance(selected, set) else selected,
                          "changed_paths": paths}, indent=2))

    def pending_repair(self):
        if (self.repair is not None and not self.repair_consumed and
                self.state["tried"].get(self.repair["name"]) != self.repair["tip"]):
            return self.repair
        return None

    def next_batch(self):
        repair = self.pending_repair()
        if repair is not None:
            try:
                advertised_repair(self.repo, repair)
                branches = list_candidates(self.repo, {})
                branch = next((branch for branch in branches if branch["name"] == repair["name"] and
                               branch["tip"] == repair["tip"]), None)
                if branch is None:
                    raise ValueError("fetched repair ready branch does not match the pinned tip")
            except Exception as error:
                self.error_record = log_repair_refusal(self.log_path, repair, error)
                raise
            return [branch], repair
        return list_candidates(self.repo, self.state["tried"])[:self.batch], None

    def cycle(self):
        self.error_record = None
        try:
            return self.cycle_once()
        except Exception as error:
            repair = self.pending_repair()
            if repair is not None and self.error_record is None:
                self.error_record = {"start": utc_now(), "end": utc_now(), "branches": [], "steps": [],
                                     "posts": [], "repair": repair, "outcome": "error", "error": str(error)}
                log_batch(self.log_path, self.error_record)
            raise

    def cycle_once(self):
        self.writer_guard()
        self.reconcile_publications()
        if self.repair_hold and self.pending_repair() is None:
            self.enter_hold()
            return False
        git(self.repo, "fetch", "--prune", "origin")
        branches, repair = self.next_batch()
        if not branches:
            self.state.setdefault("idle_since", self.now())
            if not self.dry and self.idle_due():
                self.attempt([], idle=True)
                self.state["idle_since"] = self.now()
                self.save()
                return True
            self.save()
            print("nothing to do")
            return False
        ensure_clean(self.repo)
        original = git(self.repo, "symbolic-ref", "--quiet", "--short", "HEAD", check=False).stdout.strip()
        original_tip = git(self.repo, "rev-parse", "HEAD").stdout.strip()
        try:
            initial_green = self.attempt(branches, skip_conflicts=True, force_full=repair is not None,
                                         repair=repair)
            if repair is not None:
                self.repair_consumed = True
            merged, conflicts = self.last_merged, self.last_conflicts
            first = True
            force_full = not initial_green and self.last_selection == "full"

            def check(group):
                nonlocal first, force_full
                if first:
                    first = False
                    return initial_green
                green = self.attempt(group, force_full=force_full)
                if not green and self.last_selection == "full":
                    force_full = True
                return green

            green, red = bisect(merged, check)
            print(json.dumps({"green": [branch["name"] for branch in green],
                              "red": [branch["name"] for branch in red],
                              "conflicts": [branch["name"] for branch in conflicts], "dry": self.dry}))
            self.state["idle_since"] = self.now()
            self.save()
            if repair is not None and self.repair_hold:
                self.enter_hold()
            return True
        finally:
            if self.dry and self.unknown_marker is None:
                git(self.repo, "switch", original) if original else git(self.repo, "switch", "--detach", original_tip)

    def enter_hold(self):
        if not self.hold_logged:
            log_batch(self.log_path, {"start": utc_now(), "end": utc_now(), "event": "repair-hold",
                                     "repair": self.repair, "branches": [], "dry": self.dry,
                                     "message": "Admission held until official restart; hold is not completion evidence"})
            self.hold_logged = True


@contextmanager
def queue_lock(path):
    with authority.Lock(path):
        yield


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="action", required=True)
    for name in ("run", "once", "plan"):
        sub = subparsers.add_parser(name)
        sub.add_argument("--repo", type=Path, default=Path.home() / "src/fabrig/queue")
        sub.add_argument("--authority-dir", type=Path,
                         help="shared queue authority directory; never per clone")
        sub.add_argument("--authority-fd", type=int, help=argparse.SUPPRESS)
        sub.add_argument("--startup-fd", type=int, help=argparse.SUPPRESS)
        sub.add_argument("--batch", type=positive, default=8)
        sub.add_argument("--full-every", type=positive, default=5)
        sub.add_argument("--disk-floor", type=positive, default=45)
        repair_options(sub)
        if name == "once":
            sub.add_argument("--dry", action="store_true")
    args = parser.parse_args()
    admitted = False
    refusal_logged = False
    raw = {"name": args.repair_ready, "tip": args.repair_tip, "reason": args.repair_reason}
    repair = raw if args.repair_hold or any(value is not None for value in raw.values()) else None
    try:
        if args.action == "run":
            for name in ("cargo", "heavy", "post", "git"):
                if shutil.which(name) is None:
                    error = RuntimeError(f"missing {name} on PATH; invoke from bash -lc")
                    if repair is not None:
                        refusal_logged = True
                        log_repair_refusal(Path.home() / "src/fabrig/notes/queue.jsonl", repair, error)
                    print(f"mq: {error}", file=sys.stderr)
                    return 2
        repo = args.repo.expanduser().resolve()
        repair = raw
        try:
            repair = validate_repair(repo, args.repair_ready, args.repair_tip, args.repair_reason,
                                     hold=args.repair_hold)
        except ValueError as error:
            refusal_logged = True
            log_repair_refusal(Path.home() / "src/fabrig/notes/queue.jsonl", repair, error)
            raise
        if git(repo, "rev-parse", "--show-toplevel").stdout.strip() != str(repo):
            raise RuntimeError("--repo must name the checkout root")
        layout = authority.Layout(args.authority_dir)
        with (layout.acquire(inherited=args.authority_fd) as lease,
              authority.checkout_lock(repo) as checkout, writer_authority(lease, checkout)):
            if args.authority_fd is not None:
                os.close(args.authority_fd)
            lease.guard()
            layout.legacy_guard(repo)
            queue = Queue(repo, batch=args.batch, full_every=args.full_every, disk_floor=args.disk_floor,
                          dry=getattr(args, "dry", False), repair=repair,
                          repair_hold=args.repair_hold, publication_root=layout.root / "publications",
                          read_only=args.action == "plan",
                          writer_guard=lambda: (lease.guard(), layout.legacy_guard(repo)))
            admitted = True
            if args.action == "plan":
                queue.plan()
                return 0
            if args.startup_fd is not None:
                os.write(args.startup_fd, b"READY\n")
                os.close(args.startup_fd)
            if args.action == "once":
                try:
                    queue.cycle()
                except Exception:
                    if queue.unknown_marker is not None and not queue.unknown_durable:
                        queue.retain_unknown(Path.home() / "src/fabrig/queue.stop", time.sleep)
                    raise
                return 0
            stop = Path.home() / "src/fabrig/queue.stop"
            queue.run(stop)
        return 0
    except (OSError, ValueError, RuntimeError) as error:
        if repair is not None and not admitted and not refusal_logged:
            log_repair_refusal(Path.home() / "src/fabrig/notes/queue.jsonl", repair, error)
        print(f"mq: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
