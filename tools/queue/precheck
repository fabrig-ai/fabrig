#!/usr/bin/env python3
"""Check a pinned uncommitted candidate and restore its slot (precheck.md, 1–4)."""

import argparse
from contextlib import ExitStack, contextmanager
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True
DEFAULT_MIN_FREE_BYTES = 80_000_000_000
# Load the lifetime implementation before a candidate can switch this checkout.
SLOT_LIFETIME = {"__name__": "slot_lifetime"}
exec(compile((Path(__file__).resolve().parents[1] / "slots/lifetime.py").read_text(),
             "tools/slots/lifetime.py", "exec"), SLOT_LIFETIME)


def policy():
    # Load code and lists before a slot containing this executable can be switched.
    directory = Path(__file__).resolve().parent
    loader = importlib.machinery.SourceFileLoader("precheck_mq", str(directory / "mq"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    exec(compile(loader.get_source(loader.name), str(directory / "mq"), "exec"), module.__dict__)
    return module, tuple(module.lines(directory / "always.txt")), tuple(
        module.lines(directory / "read-by-tests.txt"))


class InfrastructureError(RuntimeError):
    pass


class CheckFailure(RuntimeError):
    pass


class UnknownCompletion(InfrastructureError):
    pass


def positive_bytes(value):
    try:
        number = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a positive integer byte count") from error
    if number <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer byte count")
    return number


def no_symlinks(path):
    if any(part.is_symlink() for part in (path, *path.parents)):
        raise InfrastructureError(f"symlink in path: {path}")


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_private(path, value):
    temporary = path.with_name(path.name + ".tmp")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as output:
        os.fchmod(output.fileno(), 0o600)
        json.dump(value, output, indent=2)
        output.write("\n")
        output.flush()
        os.fsync(output.fileno())
    os.replace(temporary, path)
    sync_directory(path.parent)


@contextmanager
def lock(path):
    no_symlinks(path)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a+") as output:
        os.fchmod(output.fileno(), 0o600)
        try:
            fcntl.flock(output, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise InfrastructureError(f"checkout ownership conflict: {path}") from error
        yield


def heavy_busy(repo):
    """Observe service WorkingDirectory, not client absence, when systemd is available."""
    result = subprocess.run(["systemctl", "--user", "list-units", "--type=service", "--plain", "--no-legend",
                             "--state=active,activating"], text=True, capture_output=True,
                            stdin=subprocess.DEVNULL)
    if result.returncode:
        # Machines without a user bus cannot supply this additional observation.
        if "Failed to connect to bus" in result.stderr:
            return "unavailable (no user bus); slot ownership is required"
        raise InfrastructureError(f"cannot inspect heavy units: {result.stderr.strip()}")
    vanished = 0
    for row in result.stdout.splitlines():
        name = row.split()[0]
        if not name.endswith(".service") or "-heavy-" not in name:
            continue
        # The installed reconciler observes jobs; it owns no slot build cwd.
        if name.endswith("-reconcile.service"):
            continue
        detail = subprocess.run(["systemctl", "--user", "show", "-p",
                                 "WorkingDirectory,ActiveState,LoadState", name], text=True,
                                capture_output=True, stdin=subprocess.DEVNULL)
        properties = dict(line.split("=", 1) for line in detail.stdout.splitlines() if "=" in line)
        # A collected service can disappear between list and show. Only a successful,
        # explicit unloaded + inactive observation permits ignoring that service.
        if (detail.returncode == 0 and properties.get("LoadState") == "not-found"
                and properties.get("ActiveState") == "inactive"):
            vanished += 1
            continue
        states = {"active", "activating", "reloading", "deactivating", "refreshing", "inactive", "failed"}
        if (detail.returncode or not {"WorkingDirectory", "ActiveState", "LoadState"} <= properties.keys()
                or properties["LoadState"] != "loaded" or properties["ActiveState"] not in states):
            raise InfrastructureError(f"cannot inspect heavy unit {name}")
        directory = properties["WorkingDirectory"]
        if properties["ActiveState"] not in ("inactive", "failed"):
            if not directory or not Path(directory).is_absolute():
                raise InfrastructureError(f"cannot inspect heavy unit {name}: missing absolute WorkingDirectory")
            if SLOT_LIFETIME["canonical"](directory).is_relative_to(repo):
                raise InfrastructureError(f"live heavy unit uses this slot: {name}")
    return (f"no active heavy service observed; {vanished} unloaded inactive service(s); "
            "slot ownership is required")


class Executor:
    """Drain a known child on signals; abnormal heavy exits retain source ownership."""

    def __init__(self, before, after):
        self.before = before
        self.after = after
        self.interrupted = None
        self.unknown = False

    @contextmanager
    def signals(self):
        def interrupted(number, frame):
            self.interrupted = number
        previous = {number: signal.signal(number, interrupted)
                    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
        try:
            yield
        finally:
            for number, handler in previous.items():
                signal.signal(number, handler)

    def __call__(self, argv, **options):
        if self.interrupted:
            raise InfrastructureError(f"interrupted by signal {self.interrupted}; child drained")
        heavy = argv[0] == "heavy"
        self.before(argv, options["cwd"])
        timeout = options.pop("timeout", None)
        try:
            child = subprocess.Popen(argv, start_new_session=True, **options)
        except OSError as error:
            self.after("launch-error", str(error))
            raise InfrastructureError(f"cannot launch {shlex.join(argv)}: {error}") from error
        except BaseException as error:
            self.unknown = True
            raise UnknownCompletion(f"launch completion unknown: {error}") from error
        try:
            try:
                code = child.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                # Only tools suites have mq's existing timeout; never cancel heavy here.
                child.kill()
                child.wait()
                self.after("timeout", child.returncode)
                raise
        except subprocess.TimeoutExpired:
            raise
        except BaseException as error:
            self.unknown = True
            raise UnknownCompletion(f"child completion unknown: {error}") from error
        if heavy and (code < 0 or code in (137, 143, 129, 130)):
            self.unknown = True
            raise UnknownCompletion(f"heavy client exited {code}; build completion unknown")
        self.after("completed", code)
        if self.interrupted:
            raise InfrastructureError(f"interrupted by signal {self.interrupted}; child drained")
        return subprocess.CompletedProcess(argv, code)


class Precheck:
    def __init__(self, repo, base, tip, *, mq, always, read_by_tests,
                 runner=None, metadata=None, busy=heavy_busy,
                 min_free_bytes=DEFAULT_MIN_FREE_BYTES):
        if type(min_free_bytes) is not int or min_free_bytes <= 0:
            raise ValueError("min_free_bytes must be a positive integer byte count")
        for name in ("GIT_DIR", "GIT_COMMON_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_NAMESPACE",
                     "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"):
            if name in os.environ:
                raise InfrastructureError(f"Git environment override is unsupported: {name}")
        supplied = Path(repo).expanduser().absolute()
        no_symlinks(supplied)
        self.repo = Path(os.path.abspath(supplied))
        self.base_ref, self.tip_ref = base, tip
        self.mq, self.always, self.read_by_tests = mq, always, read_by_tests
        self.metadata = metadata or mq.load_metadata
        self.busy = busy
        self.min_free_bytes = min_free_bytes
        self.record = {"restored": False, "steps": [], "outcome": "infrastructure-error",
                       "min_free_bytes": min_free_bytes, "admissions": []}
        self.executor = Executor(self.started, self.completed)
        self.runner = runner or self.executor
        self.mutated = False
        self.unexpected = False
        self.log_directory = None

    def git(self, *args, check=True):
        return self.mq.git(self.repo, "--no-optional-locks", *args, check=check).stdout.rstrip("\n")

    def oid(self, ref):
        value = self.git("rev-parse", "--verify", "--end-of-options", ref + "^{commit}")
        if len(value) not in (40, 64) or any(c not in "0123456789abcdef" for c in value):
            raise InfrastructureError(f"not a full commit object: {ref}")
        return value

    def state_path(self, name):
        return self.gitdir / name

    def clean(self):
        if self.git("status", "--porcelain=v1", "--untracked-files=all", "--ignore-submodules=none"):
            raise InfrastructureError("slot has dirty, staged, or untracked files")
        for name in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge", "rebase-apply",
                     "sequencer", "BISECT_LOG", "index.lock"):
            if self.state_path(name).exists() or self.state_path(name).is_symlink():
                raise InfrastructureError(f"in-progress checkout state: {name}")
        entries = self.git("ls-files", "-v", "-z").split("\0")
        if any(entry and not entry.startswith("H ") for entry in entries):
            raise InfrastructureError("slot has hidden index flags or unmerged entries")
        if any(entry.startswith("160000 ") for entry in self.git("ls-files", "--stage").splitlines()):
            raise InfrastructureError("submodule slots are unsupported")
        if self.git("config", "--get", "core.sparseCheckout", check=False) == "true":
            raise InfrastructureError("sparse checkout is unsupported")

    def protect_ignored(self):
        original = set(self.git("ls-files", "-z").split("\0"))
        # A directory rename can introduce paths present in neither parent. Inspect the
        # merged tree object before checkout so even those paths cannot consume caches.
        preview = self.mq.git(self.repo, "-c", "core.hooksPath=/dev/null", "-c", "rerere.enabled=false",
                              "merge-tree", "--write-tree", "--messages", "-z", self.base, self.tip,
                              check=False)
        merged = preview.stdout.split("\0", 1)[0]
        if preview.returncode not in (0, 1) or len(merged) not in (40, 64) or any(
                c not in "0123456789abcdef" for c in merged):
            raise InfrastructureError(f"cannot preview merged paths: {preview.stdout}")
        self.merged_tree = merged
        for tree in (self.base, self.tip, merged):
            for name in self.git("ls-tree", "-r", "--name-only", "-z", tree).split("\0"):
                if not name or name in original:
                    continue
                path = self.repo / name
                # Git merge's ignore-overwrite flag is insufficient for all merge strategies.
                if path.exists() or path.is_symlink():
                    raise InfrastructureError(f"candidate would replace existing ignored path: {name}")
                for parent in path.parents:
                    if parent == self.repo:
                        break
                    if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
                        raise InfrastructureError(f"candidate would replace ignored parent: {parent}")

    def refs(self):
        return self.git("for-each-ref", "--format=%(refname) %(objectname)", "refs/heads/")

    def worktree(self, *, exclude=()):
        result = {}
        for name in self.git("ls-files", "-z").split("\0"):
            if not name or name in exclude:
                continue
            path = self.repo / name
            no_symlinks(path.parent)
            try:
                mode = path.lstat().st_mode
            except FileNotFoundError:
                result[name] = None
                continue
            if stat.S_ISLNK(mode):
                body = os.fsencode(os.readlink(path))
            elif stat.S_ISREG(mode):
                body = path.read_bytes()
            else:
                raise InfrastructureError(f"unsupported worktree entry: {name}")
            result[name] = [stat.S_IFMT(mode), stat.S_IMODE(mode), hashlib.sha256(body).hexdigest()]
        return result

    def backup_worktree(self):
        paths = {f"{tree}/scripts/old-forms.txt" for tree in self.mq.TREES}
        for tree in (self.base, self.merged_tree):
            paths.update(self.git("diff", "--name-only", "--no-renames", "-z", self.original,
                                  tree, "--").split("\0"))
        self.backups = {}
        blobs = self.log_directory / "original.files"
        blobs.mkdir(mode=0o700)
        for name in sorted(paths & self.original_worktree.keys()):
            kind, _, digest = self.original_worktree[name]
            if kind != stat.S_IFREG:
                continue
            path = self.repo / name
            no_symlinks(path)
            body = path.read_bytes()
            if hashlib.sha256(body).hexdigest() != digest:
                raise InfrastructureError("source changed while saving restoration inputs")
            destination = blobs / digest
            with destination.open("wb") as output:
                os.fchmod(output.fileno(), 0o600)
                output.write(body)
                output.flush()
                os.fsync(output.fileno())
            self.backups[name] = digest
        sync_directory(blobs)
        self.record["original_files"] = self.backups

    def restore_worktree(self):
        for name, digest in self.backups.items():
            path = self.repo / name
            no_symlinks(path)
            body = (self.log_directory / "original.files" / digest).read_bytes()
            if hashlib.sha256(body).hexdigest() != digest:
                raise InfrastructureError("restoration file checksum mismatch")
            fd, temporary = tempfile.mkstemp(prefix=".precheck-restore-", dir=path.parent)
            try:
                with os.fdopen(fd, "wb") as output:
                    output.write(body)
                    output.flush()
                    os.fsync(output.fileno())
                os.replace(temporary, path)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
        for name, entry in self.original_worktree.items():
            if entry[0] == stat.S_IFREG:
                path = self.repo / name
                no_symlinks(path)
                os.chmod(path, entry[1], follow_symlinks=False)

    def identity(self, *, exclude_worktree=()):
        # Git's diff includes staged additions, unstaged contents and mode changes.
        # A non-UTF8 golden without NUL bytes can be emitted as a text patch.
        patch = subprocess.run(["git", "--no-optional-locks", "diff", "--binary", "--no-ext-diff",
                                "--no-textconv", "HEAD", "--",
                                *[f":(exclude){path}" for path in exclude_worktree]],
                               cwd=self.repo, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if patch.returncode:
            raise InfrastructureError(f"git diff exited {patch.returncode}: "
                                      f"{patch.stderr.decode('utf-8', errors='replace')}")
        return (self.oid("HEAD"), self.git("symbolic-ref", "-q", "HEAD", check=False),
                self.refs(), self.git("ls-files", "--stage", "-z"), self.git("ls-files", "-v", "-z"),
                self.worktree(exclude=exclude_worktree),
                patch.stdout,
                self.git("ls-files", "--others", "--exclude-standard", "-z"))

    def save(self):
        write_private(self.log_directory / "result.json", self.record)
        if self.marker.exists():
            write_private(self.marker, {**self.record, "logs": str(self.log_directory),
                                       "pid": os.getpid(), "reconciliation": self.reconciliation()})

    def reconciliation(self):
        return (f"Do not reuse or reset {self.repo}. In this submitting directory use supported "
                "heavy status inspection / heavy --cancel TOKEN, and operator heavy --check-recovery / "
                "--reconcile as needed. Never kill units or edit heavy state. Establish build "
                "completion before restoring the recorded original HEAD and index; verify clean "
                "checkout and original branch refs before removing precheck.unresolved. Leave "
                "mq-worker-unresolved.json intact for separate worker reconciliation.")

    def started(self, argv, cwd):
        self.record["active_command"] = {"argv": argv, "cwd": str(cwd), "completion": "unknown"}
        self.save()

    def completed(self, status, code):
        self.record["active_command"].update(completion=status, returncode=code)
        self.save()

    def admit(self, name, log):
        free = shutil.disk_usage(self.repo).free
        admitted = free >= self.min_free_bytes
        self.record["admissions"].append({"name": name, "free_bytes": free,
                                           "min_free_bytes": self.min_free_bytes,
                                           "admitted": admitted})
        message = (f"[{name}] {'admitted' if admitted else 'deferred'}: {free} free bytes; "
                   f"admission minimum {self.min_free_bytes} bytes")
        log.write(message + "\n")
        log.flush()
        self.save()
        print(message, flush=True)
        if not admitted:
            raise InfrastructureError(message)

    def step(self, name, argv, cwd, log, *, timeout=None):
        print(f"[{name}] {shlex.join(argv)} (cwd {cwd})", flush=True)
        if argv[0] == "heavy":
            self.admit(name, log)
        result = self.mq.run_step(name, argv, cwd, log, runner=self.runner,
                                  clock=time.monotonic, timeout=timeout)
        self.record["steps"].append(result)
        self.save()
        print(f"[{name}] exit {result['returncode']}: {'pass' if result['green'] else 'fail'}", flush=True)
        if result.get("error") or result["returncode"] == 127:
            raise InfrastructureError(result.get("error", f"{name}: command launch failed"))
        return result["green"]

    def paths(self):
        # One revision means index + worktree against that revision, including merged entries.
        output = self.git("diff", "--name-only", "--no-renames", "-z", self.base, "--")
        return output.split("\0")[:-1] if output else []

    def prepare(self, log):
        self.mutated = True
        self.git("-c", "core.hooksPath=/dev/null", "switch", "--no-overwrite-ignore", "--detach", self.base)
        result = self.mq.git(self.repo, "-c", "core.hooksPath=/dev/null", "-c", "merge.autoStash=false",
                             "-c", "rerere.enabled=false", "merge", "--no-overwrite-ignore", "--no-ff", "--no-commit", self.tip,
                             check=False)
        log.write(result.stdout)
        log.flush()
        selection_paths = self.paths()
        ratchet_paths = set(selection_paths)
        if result.returncode:
            conflicts = self.git("diff", "--name-only", "--diff-filter=U", "-z").split("\0")[:-1]
            baselines = {f"{tree}/scripts/old-forms.txt" for tree in self.mq.TREES}
            if not conflicts:
                raise InfrastructureError(f"merge failed: {result.stdout}")
            if not set(conflicts) <= baselines:
                raise CheckFailure(f"merge conflict: {', '.join(conflicts)}; {result.stdout}")
            self.git("checkout", "--ours", "--", *conflicts)
            # Resolve the index without making a merge or ratchet commit.
            self.git("add", "--", *conflicts)
        # Keep supplied/conflicted paths before recounts add generated baseline diffs.
        self.record["selection_paths"] = selection_paths
        self.save()
        for name, argv, cwd in self.mq.ratchet_commands(self.repo, ratchet_paths):
            baseline = f"{cwd.name}/scripts/old-forms.txt"
            before = self.identity(exclude_worktree=(baseline,))
            passed = self.step(name, argv, cwd, log)
            if self.identity(exclude_worktree=(baseline,)) != before:
                self.unexpected = True
                raise InfrastructureError("ratchet modified source outside its baseline")
            if not passed:
                raise CheckFailure(f"{name} failed")
        self.assert_head()

    def assert_head(self):
        if self.oid("HEAD") != self.base or self.git("symbolic-ref", "-q", "HEAD", check=False) or self.refs() != self.original_refs:
            self.unexpected = True
            raise InfrastructureError("source HEAD or branch refs unexpectedly changed")

    def choose(self):
        paths = self.record["selection_paths"]
        # Use the queue's graph-free docs/tools/full ownership cases.
        graph_free = self.mq.full_inputs(paths) or all(
            path.startswith("tools/") or (path.endswith(".md") and not
            set(Path(path).parts[:-1]) & {"src", "tests", "benches", "examples"})
            for path in paths)
        metadata = {} if graph_free and "Cargo.lock" not in paths else self.metadata(self.repo)
        self.assert_head()
        locked = None
        if "Cargo.lock" in paths:
            before = self.mq.git(self.repo, "show", f"{self.base}:Cargo.lock", check=False)
            if before.returncode:
                raise InfrastructureError("base Cargo.lock is missing or unreadable")
            candidate = self.repo / "Cargo.lock"
            no_symlinks(candidate)
            locked = self.mq.lock_changes(before.stdout, candidate.read_text(), metadata)
        selected = self.mq.selection(paths, metadata, always=self.always,
                                     read_by_tests=self.read_by_tests, locked=locked)
        self.record.update(paths=self.paths(), selection=sorted(selected) if isinstance(selected, set) else selected)
        print(f"selection: {self.record['selection']}", flush=True)
        self.save()
        commands = []
        if selected == "full" or any(path.startswith("tools/") for path in paths):
            commands.extend((name, argv, cwd, self.mq.TOOLS_TIMEOUT)
                            for name, argv, cwd in self.mq.tools_commands(self.repo))
        checks = self.mq.check_commands(self.repo, selected, paths, metadata=metadata)
        names = [name for name, _, _ in checks]
        if selected != "docs" and selected and (names.count("clippy") != 1 or names.count("build") != 1):
            raise InfrastructureError("incomplete queue check plan")
        for name, argv, cwd in checks:
            if name in ("default", "fuzzy"):
                continue
            if name not in ("fmt", "clippy", "build"):
                raise InfrastructureError(f"unknown queue check step: {name}")
            if argv[:2] == ["heavy", "--gate"]:
                argv = [argv[0], *argv[2:]]
            if name in ("clippy", "build") and argv[:2] != ["heavy", "cargo"]:
                raise InfrastructureError("build plan bypasses ordinary heavy")
            if name == "build" and "--no-run" not in argv:
                raise InfrastructureError("build plan would execute tests")
            commands.append((name, argv, cwd, None))
        self.record["plan"] = [{"name": name, "argv": argv, "cwd": str(cwd), "timeout": timeout}
                               for name, argv, cwd, timeout in commands]
        self.save()
        return commands

    def restore(self):
        if self.refs() != self.original_refs:
            raise InfrastructureError("original branch refs changed; manual restoration required")
        self.git("-c", "core.hooksPath=/dev/null", "reset", "--hard", self.original)
        if self.symbolic:
            self.git("-c", "core.hooksPath=/dev/null", "switch", self.symbolic.removeprefix("refs/heads/"))
        else:
            self.git("-c", "core.hooksPath=/dev/null", "switch", "--detach", self.original)
        self.restore_worktree()
        # Preserve the original index bytes, including its stat cache/extensions.
        index = self.state_path("index")
        no_symlinks(index)
        with index.open("wb") as output:
            output.write(self.index_bytes)
            output.flush()
            os.fsync(output.fileno())
        self.clean()
        if (self.oid("HEAD") != self.original or
                self.git("symbolic-ref", "-q", "HEAD", check=False) != self.symbolic or
                self.refs() != self.original_refs or
                self.git("ls-files", "--stage", "-z") != self.original_entries or
                self.worktree() != self.original_worktree):
            raise InfrastructureError("restoration verification failed")
        self.record["restored"] = True
        self.save()
        self.marker.unlink()
        sync_directory(self.gitdir)

    def run(self):
        no_symlinks(self.repo)
        if not self.repo.is_dir() or self.git("rev-parse", "--show-toplevel") != str(self.repo):
            raise InfrastructureError("SLOT must be the canonical checkout root")
        self.gitdir = Path(self.git("rev-parse", "--absolute-git-dir"))
        no_symlinks(self.gitdir)
        no_symlinks(self.repo / ".git")
        no_symlinks(self.state_path("index"))
        no_symlinks(self.state_path("HEAD"))
        self.marker = self.state_path("precheck.unresolved")
        with ExitStack() as stack:
            lifetime = stack.enter_context(SLOT_LIFETIME["Lease"](self.repo))
            for path in (self.repo.with_name(self.repo.name + ".queue.lock"),
                         self.repo.with_name(self.repo.name + ".worker.lock"),
                         self.state_path("worker.lock"), self.state_path("precheck.lock")):
                stack.enter_context(lock(path))
            markers = [self.marker, self.state_path("mq-worker-unresolved.json"),
                       self.state_path("worker.unresolved"), self.state_path("queue.unresolved")]
            markers.extend(self.repo.with_name(self.repo.name + suffix) for suffix in
                           (".precheck.unresolved", ".worker.unresolved", ".queue.unresolved"))
            for marker in markers:
                if marker.exists() or marker.is_symlink():
                    raise InfrastructureError(f"durable unresolved ownership: {marker}")
            self.clean()
            self.base, self.tip = self.oid(self.base_ref), self.oid(self.tip_ref)
            self.protect_ignored()
            self.original = self.oid("HEAD")
            self.symbolic = self.git("symbolic-ref", "-q", "HEAD", check=False)
            if self.symbolic and not self.symbolic.startswith("refs/heads/"):
                raise InfrastructureError("HEAD is not a local branch or detached commit")
            self.original_refs = self.refs()
            self.original_entries = self.git("ls-files", "--stage", "-z")
            self.index_bytes = self.state_path("index").read_bytes()
            self.original_worktree = self.worktree()
            observation = self.busy(self.repo)
            logs = self.repo.with_name(self.repo.name + ".precheck-logs")
            no_symlinks(logs)
            logs.mkdir(mode=0o700, exist_ok=True)
            os.chmod(logs, 0o700)
            self.log_directory = Path(tempfile.mkdtemp(prefix="run-", dir=logs))
            self.record.update(base=self.base, tip=self.tip, original=self.original,
                               symbolic=self.symbolic, original_refs=self.original_refs,
                               original_index_sha256=hashlib.sha256(self.index_bytes).hexdigest(),
                               heavy_observation=observation, slot=str(self.repo), started=self.mq.utc_now())
            index_copy = self.log_directory / "original.index"
            with index_copy.open("wb") as output:
                os.fchmod(output.fileno(), 0o600)
                output.write(self.index_bytes)
                output.flush()
                os.fsync(output.fileno())
            write_private(self.log_directory / "original.worktree.json", self.original_worktree)
            self.backup_worktree()
            # Exclusive create plus fsync before the first source mutation.
            fd = os.open(self.marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            os.close(fd)
            self.save()
            print(f"base: {self.base}\ntip: {self.tip}\nlogs: {self.log_directory}\n"
                  f"admission minimum: {self.min_free_bytes} bytes before each heavy command\n"
                  "No tests executed beyond selected tools suites; Cargo steps compile/lint only.", flush=True)
            stack.enter_context(self.executor.signals())
            prepared = None
            try:
                with (self.log_directory / "commands.log").open("a+") as log:
                    os.fchmod(log.fileno(), 0o600)
                    self.prepare(log)
                    prepared = self.identity()
                    commands = self.choose()
                    if self.identity() != prepared:
                        self.unexpected = True
                        raise InfrastructureError("source modified during planning")
                    tools_failed = False
                    for name, argv, cwd, timeout in commands:
                        if tools_failed and timeout is None:
                            raise CheckFailure("tools suites failed")
                        passed = self.step(name, argv, cwd, log, timeout=timeout)
                        if self.identity() != prepared:
                            self.unexpected = True
                            raise InfrastructureError("source modified beyond prepared plan")
                        if not passed:
                            if timeout is not None:
                                tools_failed = True
                            else:
                                raise CheckFailure(f"{name} failed")
                    if tools_failed:
                        raise CheckFailure("tools suites failed")
                if self.executor.interrupted:
                    raise InfrastructureError(f"interrupted by signal {self.executor.interrupted}; child drained")
                self.record["outcome"] = "passed"
            except CheckFailure as error:
                self.record.update(outcome="failed", error=str(error))
            except BaseException as error:
                self.record.update(outcome="infrastructure-error", error=str(error))
            finally:
                if prepared is not None and not self.executor.unknown:
                    try:
                        if self.identity() != prepared:
                            self.unexpected = True
                    except BaseException:
                        self.unexpected = True
                if self.executor.unknown or self.unexpected:
                    self.record.update(outcome="unresolved", reconciliation=self.reconciliation())
                else:
                    try:
                        self.restore()
                    except BaseException as error:
                        self.record.update(outcome="unresolved", restoration_error=str(error),
                                           reconciliation=self.reconciliation())
                self.save()
            print(json.dumps(self.record, indent=2), flush=True)
            lifetime.clean = self.record["restored"] and self.record["outcome"] != "unresolved"
            return 0 if self.record["outcome"] == "passed" and self.record["restored"] else 1


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--min-free-bytes", type=positive_bytes, default=DEFAULT_MIN_FREE_BYTES,
                        metavar="INTEGER", help="free bytes required before each heavy command (default: %(default)s)")
    parser.add_argument("slot", type=Path)
    parser.add_argument("tip")
    args = parser.parse_args()
    try:
        mq, always, read_by_tests = policy()
        return Precheck(args.slot, args.base, args.tip, mq=mq, always=always,
                        read_by_tests=read_by_tests, min_free_bytes=args.min_free_bytes).run()
    except (OSError, ValueError, RuntimeError) as error:
        print(f"precheck: infrastructure-error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
