#!/usr/bin/env python3
"""session-context: how full a Claude Code session's context window is (agents/operations.md, 7).

Reads the session's own transcript (~/.claude/projects/<cwd>/<session>.jsonl)
and prints the context of its latest model call: input, cache read and cache
creation tokens, plus that call's output.

  session-context                 the newest session started from this directory
  session-context SESSION_ID      a session by (a prefix of) its id
  session-context --name lead/jig a running background session by its name
Options: --window N (default 1000000), --threshold F (default 0.75).
Exit 0 below the threshold, 3 at or past it.
"""
import json, os, subprocess, sys

def project_dir(cwd):
    return os.path.expanduser('~/.claude/projects/') + cwd.replace('/', '-').replace('.', '-')

def by_name(name):
    out = subprocess.run(['claude', 'agents', '--json'], capture_output=True, text=True, timeout=30).stdout
    for a in json.loads(out or '[]'):
        if a.get('name') == name and a.get('sessionId'):
            return a['sessionId'], a.get('cwd')
    sys.exit(f'session-context: no running session named {name}')

def find(session, cwd):
    d = project_dir(cwd)
    if session:
        for root in ([d] if os.path.isdir(d) else []) + [os.path.expanduser('~/.claude/projects/')]:
            for dirpath, _, files in os.walk(root):
                for f in files:
                    if f.startswith(session) and f.endswith('.jsonl'):
                        return os.path.join(dirpath, f)
        sys.exit(f'session-context: no transcript for {session}')
    files = [os.path.join(d, f) for f in os.listdir(d) if f.endswith('.jsonl')] if os.path.isdir(d) else []
    if not files:
        sys.exit(f'session-context: no transcript under {d}')
    return max(files, key=os.path.getmtime)

def latest(path):
    last = None; calls = 0; compactions = 0
    with open(path) as f:
        for line in f:
            if '"usage"' not in line and 'compact' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get('type') == 'system' and 'compact' in str(d.get('subtype', '')) + str(d.get('content', ''))[:200].lower():
                compactions += 1
            m = d.get('message')
            u = m.get('usage') if isinstance(m, dict) else None
            if u:
                calls += 1
                last = (d.get('timestamp', ''), u)
    return last, calls, compactions

def main(argv):
    window, threshold, session, cwd = 1_000_000, 0.75, None, os.getcwd()
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == '--window': window = int(argv[i + 1]); i += 2
        elif a == '--threshold': threshold = float(argv[i + 1]); i += 2
        elif a == '--name': session, cwd = by_name(argv[i + 1]); i += 2
        elif a in ('-h', '--help'): print(__doc__); return 0
        else: session = a; i += 1
    path = find(session, cwd)
    last, calls, compactions = latest(path)
    if not last:
        sys.exit(f'session-context: no model call yet in {path}')
    ts, u = last
    used = u.get('input_tokens', 0) + u.get('cache_read_input_tokens', 0) + u.get('cache_creation_input_tokens', 0) + u.get('output_tokens', 0)
    share = used / window
    print(f'{os.path.basename(path)[:8]}: {used:,} of {window:,} tokens ({share:.0%}) at {ts[:19]}Z; '
          f'{calls} calls; {compactions} compaction(s); threshold {threshold:.0%}'
          + (' REACHED: end now' if share >= threshold else ''))
    return 3 if share >= threshold else 0

if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
