#!/usr/bin/env python3
"""Heavy's optional installation and plain execution in disposable trees."""
import sys

sys.dont_write_bytecode = True
from case_runner import HUNG_TOOL_S
import hashlib
import json
import os
import runpy
import shutil
from pathlib import Path
import subprocess
import tempfile
import unittest
from types import SimpleNamespace
from unittest.mock import patch


KIT = Path(__file__).resolve().parent
PLAIN = 'heavy: not installed here; running it directly\n'


class Plain(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='agents-heavy-plain-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.home = self.root / 'home'
        self.bin = self.root / 'bin'
        self.cwd = self.root / 'caller'
        self.tmp = self.root / 'tmp'
        for path in (self.home, self.bin, self.cwd, self.tmp):
            path.mkdir()
        self.state = self.tmp / 'heavy' / 'state.json'
        self.env = {'PATH': str(self.bin) + ':' + os.defpath, 'HOME': str(self.home),
                    'DEV_ROOT': str(self.root), 'DEV_TMP': str(self.tmp)}

    def heavy(self, *args, extra=None):
        return subprocess.run([str(KIT / 'heavy'), *args], cwd=self.cwd,
                              env=self.env | (extra or {}), text=True, capture_output=True,
                              stdin=subprocess.DEVNULL, timeout=HUNG_TOOL_S)

    def ledger(self, installation=None, version=1):
        self.state.parent.mkdir(exist_ok=True)
        self.state.write_text(json.dumps({
            'version': version, 'queue': hashlib.sha256(str(self.state.parent).encode()).hexdigest(),
            'next_id': 1, 'tasks': {}, 'maintenance': {}, 'gate': None, 'pending': [],
            'installation': installation}))

    def installation(self):
        return {'boot': Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
                'interval': '5s', 'probe': [], 'units': str(self.home / 'units')}

    def assert_query(self, status, stderr=''):
        before = (self.state.read_bytes(), self.state.stat().st_mtime_ns)
        entries = sorted(self.root.rglob('*'))
        result = self.heavy('--installed')
        self.assertEqual((result.returncode, result.stdout, result.stderr), (status, '', stderr))
        self.assertEqual((self.state.read_bytes(), self.state.stat().st_mtime_ns), before)
        self.assertEqual(sorted(self.root.rglob('*')), entries)

    def assert_no_state(self):
        self.assertFalse(self.state.parent.exists())
        self.assertFalse((self.tmp / 'logs').exists())

    def test_no_state_directory_is_not_installed(self):
        result = self.heavy('--installed')
        self.assertEqual((result.returncode, result.stdout, result.stderr), (1, '', ''))
        self.assert_no_state()
        self.state.parent.mkdir()
        result = self.heavy('--installed')
        self.assertEqual((result.returncode, result.stdout, result.stderr), (1, '', ''))
        self.assertEqual(list(self.state.parent.iterdir()), [])

    def test_ledger_without_installation_is_not_installed(self):
        self.ledger()
        self.assert_query(1)

    def test_ledger_with_installation_is_installed(self):
        self.ledger(self.installation())
        self.assert_query(0)

    def test_unreadable_ledger_cannot_tell(self):
        self.ledger()
        self.state.write_text('invalid JSON containing private path contents')
        self.assert_query(2, 'heavy: cannot tell whether heavy is installed: cannot parse host ledger\n')
        self.ledger(version=2)
        self.assert_query(2, 'heavy: cannot tell whether heavy is installed: unsupported host ledger version\n')

    def test_not_installed_runs_the_command_directly(self):
        result = self.heavy('sh', '-c', 'echo out; echo err >&2; exit 7')
        self.assertEqual((result.returncode, result.stdout, result.stderr), (7, 'out\n', PLAIN + 'err\n'))
        self.assert_no_state()

    def test_not_installed_strips_heavy_options(self):
        for lane in ('--gate', '--land'):
            for tail in ('5', '-0', ' 5 ', '1_0'):
                with self.subTest(lane=lane, tail=tail):
                    result = self.heavy(lane, '--tail', tail, '--', 'printf', '%s', 'x')
                    self.assertEqual((result.returncode, result.stdout, result.stderr), (0, 'x', PLAIN))
                    self.assert_no_state()

    def test_not_installed_runs_in_the_callers_directory_and_environment(self):
        result = self.heavy('sh', '-c', 'pwd; printf "%s\\n" "$PLAIN_VALUE"',
                            extra={'PLAIN_VALUE': 'from caller'})
        self.assertEqual((result.returncode, result.stdout, result.stderr),
                         (0, str(self.cwd) + '\nfrom caller\n', PLAIN))
        self.assert_no_state()

    def test_not_installed_skips_the_disk_floor(self):
        (self.tmp / 'machine.env').write_text('PLAN_MIN_DISK_GB=999999999\n')
        result = self.heavy('printf', '%s', 'x')
        self.assertEqual((result.returncode, result.stdout, result.stderr), (0, 'x', PLAIN))
        self.assert_no_state()

    def test_explicit_minimum_requires_reconciler_instead_of_plain_execution(self):
        marker = self.cwd / 'payload'
        result = self.heavy('touch', str(marker), extra={'HEAVY_MIN_FREE_BYTES': '0'})
        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
        self.assertIn('containment/reconciler not installed', result.stderr)
        self.assertFalse(marker.exists())
        self.assertEqual(json.loads(self.state.read_text())['tasks'], {})

    def test_installed_but_broken_still_refuses(self):
        self.ledger(self.installation())
        result = self.heavy('true', extra={'PLAN_MIN_DISK_GB': '0'})
        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
        self.assertIn('heavy: independent reconciler timer is not active', result.stderr)
        self.assertNotIn('running it directly', result.stderr)

    def test_installation_layouts_share_default_queue(self):
        # Intercept Python before --installed can read a ledger. Importing the
        # helper computes its own canonical paths and identity without main().
        probe = self.bin / 'python3'
        probe.write_text("#!/usr/bin/python3 -B\n"
                         "import json, runpy, sys\nfrom pathlib import Path\n"
                         "sys.path.insert(0, str(Path(sys.argv[2]).parent))\n"
                         "m = runpy.run_path(sys.argv[2])\n"
                         "print(json.dumps({k: str(m[k]) for k in "
                         "('ROOT', 'TMP', 'BASE', 'QUEUE', 'PREFIX')}))\n")
        probe.chmod(0o700)
        env = {'PATH': str(self.bin) + ':' + os.defpath, 'HOME': str(self.home)}
        layouts = (self.home / 'src/rust/agents/scripts/devel',
                   self.home / 'src/fabrig/main/tools/heavy')
        identities = []
        for index, layout in enumerate(layouts):
            layout.mkdir(parents=True)
            for name in ('heavy', 'heavy-recovery.py', 'kit.sh', 'recovery_message.py', 'receipt_inputs.py'):
                source = KIT / 'fixtures/agents-heavy' if index == 0 and name == 'heavy' else KIT / name
                shutil.copy2(source, layout / name)
            # Resolve the installed symlink as the entrypoint does in production.
            link = self.bin / ('heavy-' + str(index))
            link.symlink_to(layout / 'heavy')
            result = subprocess.run([str(link), '--installed'], env=env, cwd=self.cwd,
                                    text=True, capture_output=True, stdin=subprocess.DEVNULL,
                                    timeout=HUNG_TOOL_S)
            self.assertEqual(result.returncode, 0, result.stderr)
            identities.append(json.loads(result.stdout))
        expected = self.home / 'src/rust'
        self.assertEqual(identities[0], identities[1])
        self.assertEqual(identities[1]['ROOT'], str(expected))
        self.assertEqual(identities[1]['TMP'], str(expected / 'tmp'))
        self.assertEqual(identities[1]['BASE'], str(expected / 'tmp/heavy'))
        queue = hashlib.sha256(str(expected / 'tmp/heavy').encode()).hexdigest()
        self.assertEqual(identities[1]['QUEUE'], queue)
        self.assertEqual(identities[1]['PREFIX'], 'skein-heavy-' + queue[:12])
        self.assertFalse((expected / 'tmp').exists())

    def test_empty_command_is_refused(self):
        result = self.heavy('--gate')
        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
        self.assertIn('heavy: usage: heavy ', result.stderr)
        self.assertNotIn('running it directly', result.stderr)


class ByteMinimum(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='heavy-byte-minimum-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.env = {'HOME': str(self.root), 'DEV_ROOT': str(self.root),
                    'DEV_TMP': str(self.root / 'tmp'), 'PATH': os.defpath}
        self.environment = patch.dict(os.environ, self.env, clear=True)
        self.environment.start()
        self.addCleanup(self.environment.stop)
        self.module = runpy.run_path(str(KIT / 'heavy-recovery.py'))
        self.globals = self.module['free_bytes'].__globals__

    def test_exact_bytes_use_command_filesystem(self):
        # The workspace and command can be on different filesystems. Neither
        # df rounding nor root observations may substitute for the cwd's bytes.
        stats = SimpleNamespace(f_bavail=3, f_frsize=4096)
        task = {'repo': str(self.root / 'command-filesystem')}
        with patch.object(os, 'statvfs', return_value=stats) as stat:
            self.assertEqual(self.module['free_bytes'](task), 12288)
        stat.assert_called_once_with(task['repo'])

    def test_fixture_override_cannot_affect_live_home_or_queue(self):
        override = self.root / 'tmp/free-bytes'
        override.parent.mkdir()
        override.write_text('123')
        task = {'repo': str(self.root)}
        with patch.dict(os.environ, HEAVY_DISK_FREE_BYTES_FILE=str(override)):
            with self.assertRaises(self.module['Refusal']):
                self.module['free_bytes'](task)
            with patch.dict(os.environ, HEAVY_RECOVERY_FIXTURE='1'):
                self.assertEqual(self.module['free_bytes'](task), 123)
                # Model the account's live HOME without reading its contents.
                with patch.object(Path, 'home', return_value=Path('/live-home')), patch.object(
                        self.globals['pwd'], 'getpwuid', return_value=SimpleNamespace(pw_dir='/live-home')):
                    with self.assertRaises(self.module['Refusal']):
                        self.module['free_bytes'](task)
                with patch.dict(self.globals, TMP=Path('/outside-fixture')):
                    with self.assertRaises(self.module['Refusal']):
                        self.module['free_bytes'](task)

    def test_absent_empty_and_decimal_zero(self):
        parse = self.module['submitted_min_free_bytes']
        self.assertIsNone(parse())
        for value, expected in (('', None), ('0', 0), ('00123', 123)):
            with self.subTest(value=value), patch.dict(os.environ, HEAVY_MIN_FREE_BYTES=value):
                self.assertEqual(parse(), expected)

    def test_old_task_ignores_caller_override_and_keeps_rounded_floor(self):
        task = {'repo': str(self.root), 'token': 'old', 'id': '1', 'label': 'land repo',
                'lane': 'build', 'state': 'waiting', 'floor_gb': 40, 'room_gb': 30}
        ledger = SimpleNamespace(tasks={'old': task}, data={'maintenance': {}, 'gate': None})
        with patch.dict(os.environ, HEAVY_MIN_FREE_BYTES='invalid'), patch.dict(
                self.globals, free_gb=lambda: 40, free_bytes=lambda task: self.fail('old task used bytes')):
            self.assertTrue(self.module['admissible'](ledger, task))
        self.assertNotIn('min_free_bytes', task)



if __name__ == '__main__':
    unittest.main()
