    def test_boot_change_reports_unknown_not_zero(self):
        self.task()
        self.observe(0, 99)
        self.observe(4, 100)
        self.observe(5, 99)
        self.world.g['boot'] = lambda: 'changed-boot'
        ledger, task = self.observe(100, 99)
        summary = self.world.module['byte_wait_summary'](task)
        self.assertFalse(summary['complete'])
        self.assertIsNone(summary['elapsed_seconds'])
