    def test_payload_exit_two_remains_completed_not_a_capacity_refusal(self):
        self.task(cap=3)
        self.observe(0, 99)
        ledger, task = self.observe(1, 100)
        w = self.world
        task['state'] = 'launching'
        task['admission_free_bytes'] = 100
        marker = self.root / 'payload-starts'
        task['args'] = [sys.executable, '-c', 'from pathlib import Path; import sys; '
                        'Path(' + repr(str(marker)) + ').write_text("start\\n"); sys.exit(2)']
        w.populate(task)
        ledger.save()
        read_text = Path.read_text
        def group(path, *args, **kwargs):
            return ('0::' + task['cgroup'] + '\n' if str(path) == '/proc/self/cgroup'
                    else read_text(path, *args, **kwargs))
        with patch.object(Path, 'read_text', group), patch.dict(w.g,
                capture_inputs=lambda repo: {}, subreaper=lambda: None, gc=lambda *args: None):
            self.assertEqual(w.module['payload'](self.token), 2)
        self.assertEqual(marker.read_text(), 'start\n')
        self.assertEqual(w.module['payload'](self.token), 137)
        self.clock(5000)
        receipt = self.release(w.ledger())
        self.assertEqual((receipt['code'], receipt['outcome']), (2, 'completed'))
        self.assertTrue(receipt['payload_started'])
        self.assertTrue(receipt['payload_ended'])
        self.assertNotIn('failure_class', receipt)
        self.assertNotIn('refusal_reason', receipt)
        self.assertEqual((receipt['wait_below_min_s'], receipt['wait_cap_s'],
                          receipt['observed_free_bytes']), (1, 3, 100))

    def test_only_pinned_wait_keys_are_submission_controls(self):
        # Only the pinned keys control admission; undeclared aliases have no effect.
        with patch.dict(os.environ, HEAVY_DISK_WAIT_CAP_SECONDS='1'):
            self.assertIsNone(self.world.module['submission_policy']()['cap_seconds'])
        self.slot()
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=1\nHEAVY_SLOT_DISK_WAIT_CAP_SECONDS=1\n')
        self.assertEqual(self.policy_module()['submission_policy']()['cap_seconds'], 1200)

    def policy_module(self):
        # An independent import uses the real local machine_setting reader,
        # while every queue transition above uses fake service neighbours.
        return runpy.run_path(str(KIT / 'heavy-recovery.py'))

    def slot(self, name='5'):
        path = self.root / 'src/fabrig/slots' / name / 'nested'
        path.mkdir(parents=True)
        os.chdir(path)
        return path

    def settings(self, text):
        tmp = self.root / 'tmp'
        tmp.mkdir(exist_ok=True)
        (tmp / 'machine.env').write_text(text)

    def test_slot_policy_fresh_scope_nested_and_floor_composition(self):
        self.slot()
        m = self.policy_module()
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=1\nHEAVY_SLOT_MIN_FREE_WAIT_S=23\n')
        policy = m['submission_policy']()
        self.assertEqual((policy['min_free_bytes'], policy['cap_seconds'], policy['automatic']),
                         (80_000_000_000, 23, True))
        self.assertEqual(policy['slot'], str(self.root / 'src/fabrig/slots/5'))
        self.assertEqual(m['minimum_bytes'](dict(min_free_bytes=policy['min_free_bytes'], floor_gb=90)),
                         90 * 2**30)
        for explicit in (0, 1, 80_000_000_001):
            with patch.dict(os.environ, HEAVY_MIN_FREE_BYTES=str(explicit), HEAVY_MIN_FREE_WAIT_S='0007'):
                value = m['submission_policy']()
                self.assertEqual(value['min_free_bytes'], max(80_000_000_000, explicit))
                self.assertEqual(value['cap_seconds'], 7)
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=0\n')
        self.assertIsNone(m['submission_policy']()['min_free_bytes'])
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=1\n')
        self.assertEqual(m['submission_policy']()['cap_seconds'], 1200)
        self.assertIsNone(m['submission_policy'](False)['min_free_bytes'])
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=1\nHEAVY_SLOT_MIN_FREE_WAIT_S=0\n')
        with self.assertRaises(m['SubmissionRefusal']):
            m['submission_policy']()

    def test_non_slot_and_symlink_escape_never_default(self):
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=1\n')
        m = self.policy_module()
        self.assertFalse(m['submission_policy']()['automatic'])
        self.slot('five')
        self.assertFalse(m['submission_policy']()['automatic'])
        outside = self.root / 'outside'
        outside.mkdir()
        (self.root / 'src/fabrig/slots/7').symlink_to(outside, target_is_directory=True)
        os.chdir(self.root / 'src/fabrig/slots/7')
        self.assertFalse(m['submission_policy']()['automatic'])
        self.assertIsNone(m['physical_slot']())
        # Resolving the slots directory itself through a symlink also cannot
        # turn an unrelated physical directory into an admitted slot tree.
        slots = self.root / 'src/fabrig/slots'
        os.chdir(outside)
        slots.rename(slots.with_name('saved-slots'))
        slots.symlink_to(outside, target_is_directory=True)
        (outside / '8').mkdir()
        os.chdir(slots / '8')
        self.assertIsNone(m['physical_slot']())

    def test_invalid_cap_and_floor_refuse_before_any_state_change(self):
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=1\n')
        self.slot()
        base = self.root / 'tmp/heavy'
        for key, values in [('HEAVY_MIN_FREE_WAIT_S', ['0', '00', '-1', '+1', ' 1', '1.0', '١', '1' * 641]),
                            ('HEAVY_MIN_FREE_BYTES', ['invalid'])]:
            for value in values:
                with self.subTest(key=key, value=value):
                    env = dict(os.environ, **{key: value})
                    result = subprocess.run([str(KIT / 'heavy'), 'true'], env=env,
                        text=True, capture_output=True, stdin=subprocess.DEVNULL, timeout=HUNG_TOOL_S)
                    self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
                    self.assertFalse(base.exists())
        # Control queries do not resolve defaults or declarations at all.
        env = dict(os.environ, HEAVY_MIN_FREE_WAIT_S='invalid', HEAVY_MIN_FREE_BYTES='invalid')
        result = subprocess.run([str(KIT / 'heavy'), '--installed'], env=env,
            text=True, capture_output=True, stdin=subprocess.DEVNULL, timeout=HUNG_TOOL_S)
        self.assertEqual(result.returncode, 1)
        self.assertFalse(base.exists())

    def test_bash_slot_default_refuses_plain_fallback_but_fmt_stays_direct(self):
        self.slot()
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=1\n')
        bin_path = self.root / 'bin'
        bin_path.mkdir()
        cargo = bin_path / 'cargo'
        cargo.write_text('#!/bin/sh\nprintf "fmt:%s min:%s cap:%s\\n" "$1" "${HEAVY_MIN_FREE_BYTES-}" "${HEAVY_MIN_FREE_WAIT_S-}"\n')
        cargo.chmod(0o700)
        env = dict(os.environ, PATH=str(bin_path) + ':' + os.defpath)
        result = subprocess.run([str(KIT / 'heavy'), 'cargo', 'fmt'], env=env,
            text=True, capture_output=True, stdin=subprocess.DEVNULL, timeout=HUNG_TOOL_S)
        self.assertEqual((result.returncode, result.stdout), (0, 'fmt:fmt min: cap:\n'))
        self.assertFalse(self.world.g['BASE'].exists())
        # A scoped byte submission cannot silently run without containment.
        # World normally intercepts services; this child gets a local stub.
        control = bin_path / 'systemctl'
        control.write_text('#!/bin/sh\nexit 1\n')
        control.chmod(0o700)
        marker = Path.cwd() / 'payload'
        result = subprocess.run([str(KIT / 'heavy'), 'touch', str(marker)], env=env,
            text=True, capture_output=True, stdin=subprocess.DEVNULL, timeout=HUNG_TOOL_S)
        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
        self.assertIn('containment/reconciler not installed', result.stderr)
        self.assertFalse(marker.exists())
        self.assertEqual(self.world.ledger().tasks, {})

