#!/usr/bin/env python3
"""Offline slot admission and cumulative disk waits with deterministic neighbours."""
import sys
sys.dont_write_bytecode = True

import hashlib
import json
import os
from pathlib import Path
import runpy
import subprocess
import unittest
from unittest.mock import patch
from case_runner import HUNG_TOOL_S

KIT = Path(__file__).resolve().parent
FIXTURES = runpy.run_path(str(KIT / 'test-heavy-byte-repairs'))


class WaitCap(unittest.TestCase):
    setUp = FIXTURES['Repairs'].setUp

    def clock(self, seconds):
        self.now = seconds * 1_000_000_000

    def task(self, cap=1200, state='waiting', lane='build'):
        w = self.world
        self.clock(0)
        w.g['time'].monotonic_ns = lambda: self.now
        self.free = 99
        w.g['observe_bytes'] = lambda task: self.free
        task = w.task(1, state=state, lane=lane)
        ledger = w.ledger()
        task = ledger.tasks[task['token']]
        w.module['start_byte_accounting'](task, dict(min_free_bytes=100,
            cap_seconds=cap, slot=None, automatic=False))
        ledger.save()
        self.token = task['token']
        return task

    def observe(self, seconds, free):
        self.clock(seconds)
        self.free = free
        ledger = self.world.ledger()
        task = ledger.tasks[self.token]
        self.world.module['track_byte_wait'](ledger, task, free)
        return ledger, task

    def release(self, ledger):
        self.world.module['reconcile'](ledger)
        self.world.ledger()
        return self.world.receipt(ledger.tasks[self.token])

    def test_absent_cap_preserves_unbounded_wait_and_old_unknown(self):
        self.task(cap=None)
        ledger, task = self.observe(0, 99)
        ledger, task = self.observe(10_000, None)
        self.assertEqual(task['state'], 'waiting')
        self.assertEqual(self.world.module['byte_wait_summary'](task)['elapsed_seconds'], 10_000)
        old = self.world.task(2)
        self.world.module['track_byte_wait'](ledger, old, 0)
        self.assertIsNone(self.world.module['byte_wait_summary'](old))
        self.assertNotIn('disk_wait_accounting', old)

    def test_cap_exact_boundary_no_start_and_durable_once(self):
        self.task()
        self.observe(0, 99)
        ledger, task = self.observe(1199, 99)
        self.assertEqual(task['state'], 'waiting')
        ledger, task = self.observe(1200, 100)
        self.assertEqual((task['state'], task['code']), ('closing', 2))
        self.assertFalse(self.world.module['admissible'](ledger, task))
        receipt = self.release(ledger)
        self.assertEqual((receipt['outcome'], receipt['failure_class'], receipt['refusal_reason']),
                         ('disk-wait-cap', 'operational-capacity', 'disk-wait-cap'))
        self.assertFalse(receipt['payload_started'])
        self.assertFalse(receipt['payload_ended'])
        self.assertEqual(receipt['disk_wait_accounting']['elapsed_seconds'], 1200)
        self.assertEqual(receipt['disk_wait_accounting']['episodes'], 1)
        self.assertEqual((receipt['min_free_bytes'], receipt['observed_free_bytes'],
                          receipt['wait_below_min_s'], receipt['wait_cap_s']),
                         (100, 100, 1200, 1200))
        log = Path(receipt['log']).read_bytes()
        self.assertEqual(hashlib.sha256(log).hexdigest(), receipt['log_sha256'])
        self.assertEqual(log.count(b'heavy: disk wait accounting '), 1)
        self.release(self.world.ledger())
        with patch.object(subprocess, 'Popen', side_effect=AssertionError('payload launch after cap')):
            self.assertEqual(self.world.module['wrapper_attempt'](self.token), 2)
        self.assertEqual(self.world.receipt(task), receipt)
        self.assertEqual(Path(receipt['log']).read_bytes(), log)

    def test_cumulative_episodes_exclude_cpu_queue_and_payload(self):
        self.task(cap=10)
        self.observe(0, 99)
        w = self.world
        occupying = w.task(2, state='active')
        ledger = w.ledger()
        w.populate(ledger.tasks[occupying['token']])
        ledger.save()
        self.clock(4)
        self.free = 100
        w.module['reconcile'](ledger)
        task = ledger.tasks[self.token]
        self.assertFalse(w.module['admissible'](ledger, task))
        # The only build slot is occupied, but space is sufficient.
        self.clock(1004)
        w.module['reconcile'](ledger)
        self.assertFalse(w.module['admissible'](ledger, task))
        self.assertEqual(w.module['byte_wait_summary'](task)['elapsed_seconds'], 4)
        w.module['request_cancel'](ledger, ledger.tasks[occupying['token']], 'fixture CPU task ended')
        w.module['reconcile'](ledger)
        self.observe(1004, 99)
        ledger, task = self.observe(1009, 100)
        self.assertEqual(task['state'], 'waiting')
        ledger.tasks[self.token].update(state='finishing', payload_started=1,
                                        payload_ended=2001, code=0)
        ledger.save()
        self.clock(5000)
        receipt = self.release(ledger)
        accounting = receipt['disk_wait_accounting']
        self.assertEqual((accounting['episodes'], accounting['elapsed_seconds'], accounting['elapsed_minutes']),
                         (2, 9, 9 / 60))
        self.assertEqual((receipt['code'], receipt['outcome']), (0, 'completed'))
        self.assertEqual((receipt['wait_below_min_s'], receipt['wait_cap_s'],
                          receipt['observed_free_bytes']), (9, 10, 100))

    def test_retry_retains_clock_and_gate_hold_until_empty(self):
        task = self.task(cap=10, state='active', lane='gate')
        w = self.world
        ledger = w.ledger()
        task = ledger.tasks[self.token]
        w.populate(task)
        ledger.data['gate'] = self.token
        w.held.add(task['unit'])
        self.assertFalse(w.module['payload_byte_floor'](ledger, task))
        self.assertEqual(task['state'], 'disk-retry')
        self.clock(6)
        w.module['reconcile'](ledger)
        self.assertEqual(task['state'], 'disk-retry')
        self.assertEqual(ledger.data['gate'], self.token)
        w.held.clear()
        w.module['reconcile'](ledger)
        self.assertEqual(task['state'], 'waiting')
        self.assertIsNone(ledger.data['gate'])
        self.clock(10)
        receipt = self.release(ledger)
        self.assertEqual((receipt['code'], receipt['disk_wait_accounting']['episodes'],
                          receipt['disk_wait_accounting']['elapsed_seconds']), (2, 1, 10))
        self.assertFalse(receipt['payload_started'])
        self.assertEqual(task['payload_attempt'], 1)

