    def test_cancel_uses_saved_cap_and_excludes_cleanup(self):
        self.task()
        self.observe(0, 99)
        self.clock(7)
        with patch.dict(os.environ, HEAVY_MIN_FREE_WAIT_S='invalid', HEAVY_MIN_FREE_BYTES='invalid'):
            self.assertEqual(self.world.module['cancel'](self.token), 0)
        self.clock(100)
