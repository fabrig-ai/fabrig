    def test_submission_saves_cap_floor_and_clock_before_wrapper(self):
        self.slot()
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=1\nHEAVY_SLOT_MIN_FREE_WAIT_S=17\n')
        w = self.world
        w.g['read_setting'] = self.policy_module()['read_setting']
        w.g['setting'] = lambda key, default: 90 if key == 'PLAN_MIN_DISK_GB' else 0
        self.now = 0
        w.g['time'].monotonic_ns = lambda: self.now
        w.g['observe_bytes'] = lambda task: 80_000_000_000
        def submitted(task):
            raise FIXTURES['Submitted']()
        with patch.dict(w.g, start_wrapper=submitted):
            with self.assertRaises(FIXTURES['Submitted']):
                w.module['main'](['true'])
        ledger = w.ledger()
        task = next(iter(ledger.tasks.values()))
        self.assertEqual(task['minimum_free_bytes'], 90 * 2**30)
        accounting = task['disk_wait_accounting']
        self.assertEqual((accounting['cap_seconds'], accounting['episodes'], accounting['since_ns']),
                         (17, 1, 0))
        self.assertTrue(accounting['declaration']['automatic'])
        self.settings('HEAVY_SLOT_BYTE_ADMISSION=0\nHEAVY_SLOT_MIN_FREE_WAIT_S=1\n')
        self.now = 17_000_000_000
        with patch.dict(os.environ, HEAVY_MIN_FREE_WAIT_S='1'):
            w.module['reconcile'](ledger)
        w.ledger()
        receipt = w.receipt(task)
        self.assertEqual(receipt['code'], 2)
        self.assertEqual(receipt['disk_wait_accounting']['cap_seconds'], 17)
        self.assertEqual(receipt['disk_wait_accounting']['host'], os.uname().nodename)

