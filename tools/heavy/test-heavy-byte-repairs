    def test_age_helper_ages_nanosecond_wait_without_timeout(self):
        w = self.world
        task = w.task(1, missing=True)
        ledger = w.ledger()
        w.module['reconcile'](ledger)
        before = ledger.tasks[task['token']]['byte_wait']
        module = runpy.run_path(str(KIT / 'test-heavy-recovery'))
        lab = module['Lab'].__new__(module['Lab'])
        lab.base = w.g['BASE']
        lab.age(task['label'], 86400)
        ledger = w.ledger()
        self.assertEqual(ledger.tasks[task['token']]['byte_wait'], before - 86400 * 1_000_000_000)
        w.module['reconcile'](ledger)
        self.assertEqual(ledger.tasks[task['token']]['state'], 'waiting')
        self.assertEqual(ledger.tasks[task['token']]['byte_wait'], before - 86400 * 1_000_000_000)

    def test_pinned_pre_feature_writers_require_exclusion(self):
        w = self.world
        source = subprocess.check_output(['git', 'show', PRE_FEATURE + ':tools/heavy/heavy-recovery.py'],
            cwd=KIT.parent.parent, stdin=subprocess.DEVNULL)
        path = self.root / 'pinned-heavy-recovery.py'
        path.write_bytes(source)
        base = {'__file__': str(path), '__name__': 'pinned_heavy_fixture'}
        exec(compile(source, str(path), 'exec'), base)
        # Execute the pinned writer only on this disposable ledger, with all
        # service/cgroup neighbours replaced by the same file-backed fake.
        for name in ('ROOT', 'TMP', 'BASE', 'LOGS', 'QUEUE', 'PREFIX', 'CGROOT',
                     'boot', 'alive', 'identity', 'properties', 'run', 'available_memory', 'setting'):
            base[name] = w.g[name]
        base['free_gb'] = lambda: 0
        retiring = w.task(1, state='disk-retry')
        younger = dict(retiring, token=f'{2:032x}', id='2', state='waiting')
        ledger = w.ledger()
        self.assertEqual(base['room'](ledger, younger), 1)
        self.assertEqual(w.module['room'](ledger, younger), 0)
        landing = w.task(2, lane='gate', missing=True)
        ledger = w.ledger()
        ledger.tasks[landing['token']]['floor_gb'] = 1
        ledger.tasks[landing['token']]['byte_wait'] = time.time_ns() - 86400 * 1_000_000_000
        ledger.data['maintenance']['gate'] = True
        ledger.save()
        base['reconcile'](ledger)
        self.assertIn('disk_wait', ledger.tasks[landing['token']])
        ledger.tasks[landing['token']]['disk_wait'] -= 1201
        ledger.save()
        base['reconcile'](ledger)
        receipt = w.receipt(landing)
        self.assertEqual(receipt['code'], 2)
        self.assertNotIn('min_free_bytes', receipt)
        self.assertNotIn('minimum_free_bytes', receipt)
        self.assertTrue(ledger.data['maintenance']['gate'])
        self.assertEqual(ledger.data['queue'], w.g['QUEUE'])
        before = (w.g['BASE'] / 'receipts' / (landing['token'] + '.json')).read_bytes()
        w.module['publish_receipt'](ledger, ledger.tasks[landing['token']])
        self.assertEqual((w.g['BASE'] / 'receipts' / (landing['token'] + '.json')).read_bytes(), before)
        (self.root / 'pinned-boundary.json').write_text(json.dumps(dict(base=PRE_FEATURE,
            source_sha256=hashlib.sha256(source).hexdigest(),
            old_retry_capacity=1, new_retry_capacity=0, old_landing_timed_out=True,
            old_receipt_missing_byte_evidence=True, existing_receipt_not_rewritten=True,
            mixed_writers_safe=False), indent=2) + '\n')

    def child(self, mode, value=None, limit=None):
        env = dict(os.environ, DEV_ROOT=str(self.root), DEV_TMP=str(self.root / 'tmp'))
        if value is not None:
            env['HEAVY_MIN_FREE_BYTES'] = value
        if limit is not None:
            env['PYTHONINTMAXSTRDIGITS'] = limit
        result = subprocess.run([sys.executable, '-B', str(Path(__file__).resolve()), mode, str(self.root)],
            env=env, cwd=self.world.cwd, stdin=subprocess.DEVNULL, text=True, capture_output=True)
        with (self.root / 'subprocesses.jsonl').open('a') as out:
            out.write(json.dumps(dict(mode=mode, digits=len(value) if value else 0, limit=limit,
                code=result.returncode, stdout=result.stdout, stderr=result.stderr)) + '\n')
        return result

    def test_permissive_submit_default_reconcile_cannot_poison_json(self):
        rejected = self.child('--decimal-submit', '9' * 5000, '0')
        self.assertEqual(rejected.returncode, 2, rejected.stderr)
        self.assertFalse(self.world.ledger().tasks)
        self.assertEqual(self.child('--decimal-reconcile').returncode, 0)
        accepted = self.child('--decimal-submit', '9' * 640, '0')
        self.assertEqual(accepted.returncode, 0, accepted.stderr)
        self.assertEqual(len(str(next(iter(self.world.ledger().tasks.values()))['min_free_bytes'])), 640)
        self.assertEqual(self.child('--decimal-reconcile').returncode, 0)
        self.assertEqual(self.child('--decimal-reconcile', limit='640').returncode, 0)
        self.assertEqual(self.child('--decimal-cancel', value='invalid', limit='640').returncode, 0)

    def test_decimal_normalization_and_rejection_are_independent_of_limit(self):
        for limit in ('0', '640'):
            with self.subTest(limit=limit):
                self.assertEqual(self.child('--decimal-parse', '0' * 5000, limit).returncode, 0)
                self.assertEqual(self.child('--decimal-parse', '1' * 641, limit).returncode, 2)


# Subprocesses execute production parsing/submission/reconciliation with only
# service/Git neighbours replaced. No systemd connection is possible here.
def decimal_child(mode, root):
    w = World(root)
    try:
        if mode == '--decimal-parse':
            w.module['submitted_min_free_bytes']()
        elif mode == '--decimal-submit':
            def submitted(task):
                raise Submitted()
            with patch.dict(w.g, start_wrapper=submitted):
                try:
                    w.module['main'](['true'])
                except Submitted:
                    pass
        elif mode == '--decimal-reconcile':
            return w.module['main'](['--reconcile'])
        elif mode == '--decimal-cancel':
            token = next(iter(w.ledger().tasks))
            return w.module['main'](['--cancel', token])
        else:
            raise AssertionError(mode)
        return 0
    except w.module['Refusal'] as error:
        print(str(error), file=sys.stderr)
        return 2
    finally:
        w.close()


if __name__ == '__main__':
    os.umask(0o077)
    if len(sys.argv) == 3 and sys.argv[1].startswith('--decimal-'):
        sys.exit(decimal_child(sys.argv[1], Path(sys.argv[2])))
    unittest.main(verbosity=2)
