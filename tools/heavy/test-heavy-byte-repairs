class Submitted(Exception):
    pass


class Crash(Exception):
    pass


class SettleNeighbour:
    """Own load, affinity and elapsed time; only child polling waits for real time."""
    def __init__(self):
        self.loads = [0.0]
        self.now = 0.0
        self.waits = []
        self.poll_sleep = time.sleep

    def loadavg(self):
        load = self.loads[0]
        if len(self.loads) > 1:
            self.loads.pop(0)
        return (load, load, load)

    def sleep(self, seconds):
        self.now += seconds
        if seconds >= 1:
            self.waits.append(seconds)
        else:
            self.poll_sleep(seconds)


class World:
    """Production ledger and transitions, with a file-backed cgroup neighbour."""
    def __init__(self, root):
        self.root = root
        self.cwd = root / 'cwd'
        self.cwd.mkdir(parents=True, exist_ok=True)
        self.held = set()
        self.calls = []
        self.property_queries = []
        self.owner = {'pid': 1, 'ticks': 'fixture', 'boot': 'fixture'}
        self.owner_alive = True
        self.patches = contextlib.ExitStack()
        self.patches.enter_context(patch.dict(os.environ, HOME=str(root), DEV_ROOT=str(root),
            DEV_TMP=str(root / 'tmp'), HEAVY_BUILD_SLOTS_EFFECTIVE='1'))
        self.module = runpy.run_path(str(KIT / 'heavy-recovery.py'))
        self.g = self.module['Ledger'].__init__.__globals__
        self.settle = SettleNeighbour()
        fixture_os = SimpleNamespace(**vars(os))
        fixture_os.getloadavg = self.settle.loadavg
        fixture_os.sched_getaffinity = lambda pid: {0}
        fixture_time = SimpleNamespace(**vars(time))
        fixture_time.monotonic = lambda: self.settle.now
        fixture_time.sleep = self.settle.sleep
        self.patches.enter_context(patch.dict(self.g, boot=lambda: 'fixture',
            identity=lambda: self.owner, alive=lambda owner: self.owner_alive,
            properties=self.properties, run=self.run, CGROOT=root / 'cgroups',
            available_memory=lambda: 123, ensure_reconciler=lambda ledger: None,
            setting=lambda key, default: 0, os=fixture_os, time=fixture_time))

    def close(self):
        with (self.root / 'fixture-neighbours.jsonl').open('a') as out:
            out.write(json.dumps(dict(commands=self.calls, property_queries=self.property_queries,
                real_service_calls=0)) + '\n')
        self.patches.close()

    def group(self, unit):
        return self.root / 'cgroups/user.slice' / unit

    def properties(self, unit):
        self.property_queries.append(unit)
        group = self.group(unit)
        if unit.endswith('-wrapper.service'):
            return {'ActiveState': 'active'}
        return {'ActiveState': 'active' if group.exists() else 'inactive',
                'ControlGroup': '/user.slice/' + unit if group.exists() else ''}

    def run(self, args, **kwargs):
        self.calls.append([str(x) for x in args])
        if args[0] == 'systemctl':
            assert args[1:3] in (['--user', 'kill'], ['--user', 'stop']), args
            if args[-1] not in self.held and self.group(args[-1]).exists():
                (self.group(args[-1]) / 'cgroup.events').write_text('populated 0\n')
            return SimpleNamespace(returncode=0, stdout='', stderr='')
        if args[0] == 'git':
            return SimpleNamespace(returncode=1, stdout='', stderr='')
        raise AssertionError('unexpected neighbour call: ' + str(args[:3]))

    def ledger(self):
        with self.module['locked']() as ledger:
            return ledger

    def task(self, number, state='waiting', lane='build', missing=False, minimum=100):
        token = f'{number:032x}'
        repo = self.root / ('missing-' + token) if missing else self.cwd
        logs = self.g['LOGS']
        logs.mkdir(parents=True, exist_ok=True)
        task = dict(token=token, id=str(number), queue=self.g['QUEUE'], boot='fixture',
            wrapper=dict(self.owner), wrapper_unit=self.module['wrapper_unit'](token),
            unit=self.g['PREFIX'] + '-' + token + '.service', state=state, lane=lane,
            label='land repo' if lane == 'gate' else 'build', exclusive=lane == 'gate',
            repo=str(repo), tree='unversioned', commit='unversioned', policy='fixture',
            floor_gb=0, room_gb=0, min_free_bytes=minimum, minimum_free_bytes=minimum,
            args=['true'], submitted=time.time(), log=str(logs / (token + '.log')),
            capture=str(logs / (token + '.capture')))
        Path(task['capture']).touch()
        ledger = self.ledger()
        ledger.tasks[token] = task
        ledger.data['next_id'] = number + 1
        ledger.event(task, 'submit')
        ledger.save()
        (self.g['BASE'] / (token + '.env')).write_text('FIXTURE=1\n')
        return task

    def populate(self, task):
        group = self.group(task['unit'])
        group.mkdir(parents=True, exist_ok=True)
        (group / 'cgroup.events').write_text('populated 1\n')
        task['cgroup'] = '/user.slice/' + task['unit']

    def receipt(self, task):
        return json.loads((self.g['BASE'] / 'receipts' / (task['token'] + '.json')).read_text())


class Repairs(unittest.TestCase):
    def setUp(self):
        evidence = os.environ.get('HEAVY_BYTE_REPAIR_EVIDENCE')
        if evidence:
            self.root = Path(evidence) / self._testMethodName
            self.root.mkdir(parents=True, exist_ok=False)
        else:
            temp = tempfile.TemporaryDirectory(prefix='heavy-byte-repairs-')
            self.addCleanup(temp.cleanup)
            self.root = Path(temp.name)
        environment = patch.dict(os.environ, {'PATH': os.defpath, 'HOME': str(self.root),
            'GIT_CONFIG_GLOBAL': '/dev/null', 'GIT_CONFIG_NOSYSTEM': '1'}, clear=True)
        environment.start()
        self.addCleanup(environment.stop)
        self.world = World(self.root)
        self.addCleanup(self.world.close)
        previous = Path.cwd()
        os.chdir(self.world.cwd)
        self.addCleanup(os.chdir, previous)
        handlers = {s: signal.getsignal(s) for s in (signal.SIGINT, signal.SIGTERM)}
        self.addCleanup(lambda: [signal.signal(s, h) for s, h in handlers.items()])

    def test_missing_cwd_does_not_block_other_cancellation(self):
        w = self.world
        a = w.task(1, missing=True)
        b = w.task(2, state='active', lane='gate')
        ledger = w.ledger()
        w.populate(ledger.tasks[b['token']])
        ledger.data['gate'] = b['token']
        ledger.save()
        with patch.dict(os.environ, HEAVY_MIN_FREE_BYTES='invalid'):
            self.assertEqual(w.module['cancel'](b['token']), 0)
        ledger = w.ledger()
        self.assertEqual(ledger.tasks[b['token']]['state'], 'released')
        self.assertEqual(w.receipt(b)['code'], 130)
        self.assertIsNone(ledger.data['gate'])
        affected = ledger.tasks[a['token']]
        self.assertEqual(affected['state'], 'waiting')
        self.assertTrue(affected['byte_observation_failed'])
        self.assertFalse(w.module['admissible'](ledger, affected))
        # Reservation checks also fail closed without spreading an OSError.
        younger = dict(ledger.tasks[b['token']], id='3', state='waiting', lane='build', label='build')
        self.assertFalse(w.module['older_room_ready'](ledger, younger, 1))
        Path(a['repo']).mkdir()
        self.assertTrue(w.module['admissible'](ledger, affected))
        self.assertNotIn('byte_observation_failed', affected)
        self.assertNotIn('byte_wait', affected)

    def retry(self, lane, orphan=False):
        w = self.world
        task = w.task(1, state='active', lane=lane, missing=True)
        ledger = w.ledger()
        task = ledger.tasks[task['token']]
        marker = self.root / 'payload-starts'
        task['args'] = [sys.executable, '-c', 'from pathlib import Path; p=Path(' + repr(str(marker)) + '); p.open("a").write("start\\n")']
        w.populate(task)
        task['admission_free_bytes'] = 100
        ledger.data['gate'] = task['token'] if lane == 'gate' else None
        ledger.save()
        w.held.add(task['unit'])
        save = w.module['Ledger'].save
        def crash_after_save(ledger):
            save(ledger)
            if ledger.tasks[task['token']]['state'] == 'disk-retry':
                raise Crash()
        with patch.object(w.module['Ledger'], 'save', crash_after_save):
            with self.assertRaises(Crash):
                w.module['payload_disk_floor'](task['token'])
        ledger = w.ledger()
        self.assertEqual(ledger.tasks[task['token']]['state'], 'disk-retry')
        old_unit = task['unit']
        # A delayed guard cannot enter while this attempt is retiring.
        self.assertEqual(w.module['payload'](task['token']), 137)
        other = w.task(2)
        if orphan:
            w.owner_alive = False
        for _ in range(2):
            ledger = w.ledger()
            w.module['reconcile'](ledger)
            current = ledger.tasks[task['token']]
            self.assertEqual(current['unit'], old_unit)
            self.assertNotEqual(current['state'], 'released')
            self.assertNotEqual(current['state'], 'waiting')
            self.assertEqual(w.module['room'](ledger, other), 0)
            self.assertFalse(w.module['admissible'](ledger, other))
            self.assertFalse((w.g['BASE'] / 'receipts' / (task['token'] + '.json')).exists())
        w.held.clear()
        # Keep the unrelated wrapper live in the orphan fixture.
        w.owner_alive = True
        if orphan:
            ledger = w.ledger()
            ledger.tasks[task['token']]['boot'] = 'ended-boot'
            ledger.save()
        ledger = w.ledger()
        w.module['reconcile'](ledger)
        current = ledger.tasks[task['token']]
        self.assertIn('populated 0', (w.group(old_unit) / 'cgroup.events').read_text())
        self.assertIsNone(ledger.data['gate'])
        if orphan:
            self.assertEqual(current['state'], 'released')
            self.assertEqual(w.receipt(task)['code'], 137)
            return
        self.assertEqual(current['state'], 'waiting')
        self.assertNotEqual(current['unit'], old_unit)
        self.assertEqual(current['wrapper'], task['wrapper'])
        self.assertEqual(current['args'], task['args'])
        # A delayed old-unit guard also cannot impersonate the next attempt.
        Path(task['repo']).mkdir()
        self.assertTrue(w.module['admissible'](ledger, current))
        current['state'] = 'launching'
        current['admission_free_bytes'] = current.pop('checked_free_bytes')
        ledger.save()
        read_text = Path.read_text
        def old_group(path, *args, **kwargs):
            return '0::/user.slice/' + old_unit + '\n' if str(path) == '/proc/self/cgroup' else read_text(path, *args, **kwargs)
        with patch.object(Path, 'read_text', old_group):
            with self.assertRaises(w.module['Refusal']):
                w.module['payload'](task['token'])
        self.assertFalse(marker.exists())
        w.populate(current)
        ledger.save()
        def new_group(path, *args, **kwargs):
            return '0::' + current['cgroup'] + '\n' if str(path) == '/proc/self/cgroup' else read_text(path, *args, **kwargs)
        order = []
        phase, fault = w.g['phase'], w.g['fault']
        def observed_phase(token, name, **values):
            order.append(name)
            return phase(token, name, **values)
        def observed_fault(point, token):
            if point in ('settled', 'payload_floor', 'payload_finished'):
                order.append(point)
            return fault(point, token)
        with patch.object(Path, 'read_text', new_group), patch.dict(w.g,
                capture_inputs=lambda repo: {}, subreaper=lambda: None, gc=lambda *args: None,
                prepare_payload_policy=lambda token: True,
                phase=observed_phase, fault=observed_fault):
            self.assertEqual(w.module['payload'](task['token']), 0)
        self.assertEqual(order, (['settle_begin', 'settle_end', 'settled'] if lane == 'gate' else [])
            + ['payload_floor', 'payload_end', 'payload_finished'])
        self.assertEqual(marker.read_text(), 'start\n')
        self.assertEqual(w.module['payload'](task['token']), 137)
        ledger = w.ledger()
        w.module['reconcile'](ledger)
        self.assertEqual(w.receipt(task)['code'], 0)
        events = [json.loads(line) for line in (w.g['BASE'] / 'events.jsonl').read_text().splitlines()]
        self.assertEqual(sum(e['event'] == 'payload_begin' and e['token'] == task['token'] for e in events), 1)
        phases = [e['event'] for e in events if e['token'] == task['token']
            and e['event'] in ('scope_enter', 'settle_begin', 'settle_end', 'payload_begin', 'payload_end')]
        self.assertEqual(phases, ['scope_enter']
            + (['settle_begin', 'settle_end'] if lane == 'gate' else [])
            + ['payload_begin', 'payload_end'])

