#!/usr/bin/env python3
"""Report per-test and per-pair CPU accounting (tools/tiers/design.md, 7)."""
import argparse
import os
from pathlib import Path
import runpy
import sys


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory', type=Path)
    parser.add_argument('--budgets', type=Path)
    parser.add_argument('--pair')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    cpu = runpy.run_path(str(Path(__file__).with_name('cpu.py')))
    try:
        limits = cpu['budgets'](args.budgets) if args.budgets else {}
        result = cpu['summary'](args.directory, limits, args.pair)
        cpu['print_summary'](result, args.json)
        return int(bool(result['over_budget']))
    except (OSError, ValueError, KeyError, TypeError, cpu['ET'].ParseError) as error:
        print(f'cpu-summary: invalid input: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
