#!/usr/bin/env python3
"""Run a tree's slow tier with its prerequisites (tools/tiers/design.md)."""

import argparse
import json
import os
import runpy
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time
import tomllib


DISK_BYTES = 80_000_000_000


class FailedStep(Exception):
    pass


def wait_for_disk(env):
    while True:
        result = subprocess.run(["df", "-B1", "--output=avail", "/"],
                                check=True, text=True, capture_output=True, env=env,
                                stdin=subprocess.DEVNULL)
        available = int(result.stdout.splitlines()[-1].strip())
        if available >= DISK_BYTES:
            return
        print(f"tiers: waiting for disk: {available} bytes available; "
              f"need {DISK_BYTES}; checking in 60s", flush=True)
        time.sleep(60)


def step(name, command, env, *, heavy=True):
    try:
        if heavy:
            wait_for_disk(env)
        print(f"tiers: {name}: {shlex.join(command)}", flush=True)
        return subprocess.run(command, env=env, stdin=subprocess.DEVNULL).returncode
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        raise FailedStep(f"{name}: {error}") from error


def build(name, arguments, env):
    code = step(name, ["heavy", "cargo", "build", *arguments], env)
    if code:
        raise FailedStep(f"{name}: exit {code}")


def bundle(tree, target, env):
    if tree == "skein":
        package = "skein-ui-example-shell-web"
        out = target / "ui-example-bundle"
        variable = "SKEIN_UI_EXAMPLE_BUNDLE"
        options = ["--stylesheet", "skein/examples/ui/shell-web/notes.css",
                   "--noscript", "Notes needs WebAssembly and scripts."]
        features = []
    elif tree == "jig":
        package = "jig-client-test-shell-web"
        out = target / "jig-test-bundle"
        variable = "JIG_TEST_BUNDLE"
        options = ["--stylesheet", "jig/crates/jig-client-shell-web/jig.css",
                   "--stylesheet", "jig/testing/jig-client-test-shell-web/jig_client_test_shell_web.css",
                   "--pictures", "jig=jig/crates/jig-client-shell-web/pictures",
                   "--pictures", "jig-test=jig/testing/jig-client-test-shell-web/pictures",
                   "--files", "jig/testing/jig-client-test-shell-web/files",
                   "--noscript", "jig needs WebAssembly and scripts."]
        features = []
    else:
        package = "temper-client-shell-web"
        out = target / "temper-bundle"
        variable = "TEMPER_TEST_BUNDLE"
        shell = "temper/crates/temper-client-shell-web"
        options = ["--stylesheet", f"{shell}/temper.css",
                   "--stylesheet", f"{shell}/task-pages.css",
                   "--files", f"{shell}/files",
                   "--noscript", "temper needs WebAssembly and scripts."]
        features = ["--features", "loopback-navigation"]
    build("wasm module", ["--target", "wasm32-unknown-unknown", *features, "-p", package], env)
    build("bundle tool", ["-p", "skein-ui-bundle"], env)
    module = package.replace("-", "_")
    command = [str(target / "debug/skein-ui-bundle"),
               "--module", str(target / "wasm32-unknown-unknown/debug" / f"{module}.wasm"),
               "--name", module, "--prefix", "/bundle/", *options, "--out", str(out)]
    code = step("browser bundle", command, env, heavy=False)
    if code:
        raise FailedStep(f"browser bundle: exit {code}")
    env[variable] = str(out)


def target_directory(env):
    name = "cargo metadata"
    command = ["cargo", "metadata", "--format-version", "1", "--no-deps"]
    print(f"tiers: {name}: {shlex.join(command)}", flush=True)
    try:
        result = subprocess.run(command, env=env, stdin=subprocess.DEVNULL,
                                text=True, stdout=subprocess.PIPE, check=True)
        return Path(json.loads(result.stdout)["target_directory"]).resolve()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        raise FailedStep(f"{name}: {error}") from error


def package_arguments(packages):
    return [argument for package in packages for argument in ("-p", package)]


def valid_binaries(binaries):
    if not isinstance(binaries, list):
        return False
    for binary in binaries:
        if (not isinstance(binary, dict) or not {"package", "bin"} <= set(binary)
                or set(binary) - {"package", "bin", "env"}
                or any(not isinstance(value, str) or re.fullmatch(r"[A-Za-z0-9_-]+", value) is None
                       for value in binary.values())):
            return False
        if "env" in binary and re.fullmatch(r"[A-Z][A-Z0-9_]*_TEST_[A-Z0-9_]+", binary["env"]) is None:
            return False
    keys = [(binary["package"], binary["bin"]) for binary in binaries]
    variables = [binary["env"] for binary in binaries if "env" in binary]
    return (keys == sorted(set(keys)) and len({binary["bin"] for binary in binaries}) == len(binaries)
            and len(set(variables)) == len(variables))


def selected_tests(listing):
    """Identify selected tests independently of artifact paths and build hashes."""
    return {(suite["package-name"], suite["binary-id"], name)
            for suite in listing["rust-suites"].values()
            for name, test in suite.get("testcases", {}).items()
            if test["filter-match"]["status"] == "matches"}


def list_tests(profile, selection, env):
    name = f"list {profile} {'workspace' if selection == ['--workspace'] else 'packages'}"
    command = ["heavy", "cargo", "nextest", "list", *selection,
               "--profile", profile, "--message-format", "json"]
    try:
        wait_for_disk(env)
        print(f"tiers: {name}: {shlex.join(command)}", flush=True)
        # Heavy wraps stdout with its evidence and normally tails it. Preserve the
        # entire JSON document, including when nextest pretty-prints it.
        result = subprocess.run(command, env=dict(env, HEAVY_TAIL=str(sys.maxsize)),
                                stdin=subprocess.DEVNULL, text=True, stdout=subprocess.PIPE)
        if result.returncode:
            print(result.stdout, end="", flush=True)
            raise FailedStep(f"{name}: exit {result.returncode}")
        offset = 0
        for line in result.stdout.splitlines(keepends=True):
            if line.startswith("{"):
                try:
                    listing, end = json.JSONDecoder().raw_decode(result.stdout, offset)
                except ValueError:
                    pass
                else:
                    if isinstance(listing, dict) and "rust-suites" in listing:
                        print(result.stdout[:offset] + result.stdout[end:].lstrip("\n"),
                              end="", flush=True)
                        return selected_tests(listing)
            offset += len(line)
        print(result.stdout, end="", flush=True)
        raise FailedStep(f"{name}: missing nextest JSON listing")
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        raise FailedStep(f"{name}: {error}") from error


def verify(profile, packages, env):
    workspace = list_tests(profile, ["--workspace"], env)
    limited = list_tests(profile, package_arguments(packages), env)
    for label, tests in (("misses", workspace - limited), ("adds", limited - workspace)):
        for package, binary, test in sorted(tests):
            print(f"tiers: {profile}: package set {label} {package} {binary} {test}", file=sys.stderr)
    print(f"tiers: {profile}: workspace {len(workspace)} tests; "
          f"packages {len(limited)} tests ({len(packages)} packages)", flush=True)
    return workspace == limited


def main(argv=None):
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__, usage=(
        "%(prog)s [--cpu DIR] TREE TIER [-- NEXTEST_ARGS...] | --verify TREE TIER | --verify-all"))
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--verify", action="store_true")
    mode.add_argument("--verify-all", action="store_true")
    mode.add_argument("--cpu", type=Path, metavar="DIR")
    parser.add_argument("tree", nargs="?")
    parser.add_argument("tier", nargs="?")
    argv = sys.argv[1:] if argv is None else argv
    separator = argv.index("--") if "--" in argv else len(argv)
    args = parser.parse_args(argv[:separator])
    extra = argv[separator + 1:]
    if args.verify_all:
        if args.tree or args.tier or separator < len(argv):
            parser.error("--verify-all takes no tree, tier or nextest arguments")
    elif not args.tree or not args.tier:
        parser.error("TREE and TIER are required")
    if args.verify and separator < len(argv):
        parser.error("--verify takes no nextest arguments")
    if args.cpu:
        reserved = ("--config-file", "--profile", "-P", "--no-run", "--stress-count", "--stress-duration")
        if any(arg.split("=", 1)[0] in reserved or arg.startswith("-P") for arg in extra):
            parser.error("--cpu owns profile/configuration and requires one executed run (no stress or --no-run)")
        if args.cpu.exists() and (not args.cpu.is_dir() or any(args.cpu.iterdir())):
            parser.error("--cpu DIR must be an empty directory or a new path")
    try:
        with Path(".config/nextest.toml").open("rb") as source:
            profiles = tomllib.load(source)["profile"]
        pairs = {(name.rsplit("-", 1)[1], name.rsplit("-", 1)[0]): name
                 for name in profiles if "-" in name}
        profile = pairs.get((args.tree, args.tier))
        if not args.verify_all and profile is None:
            print(f"tiers: refused unknown pair {args.tree} {args.tier}; "
                  f"configured profiles: {', '.join(sorted(pairs.values()))}", file=sys.stderr)
            return 2
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"tiers: read .config/nextest.toml from the checkout root: {error}", file=sys.stderr)
        return 2
    try:
        with Path("tools/tiers/packages.toml").open("rb") as source:
            package_map = tomllib.load(source)
        binary_map = package_map.get("binaries", {})
        if not isinstance(binary_map, dict) or set(binary_map) != set(pairs.values()):
            print("tiers: refused binary inventory in tools/tiers/packages.toml "
                  "(need one list per configured pair)", file=sys.stderr)
            return 2
        chosen = sorted(pairs.values()) if args.verify_all else [profile]
        if args.verify_all or args.cpu:
            cpu = runpy.run_path(str(Path(__file__).with_name("cpu.py")))
            limits = cpu["budgets"]("tools/tiers/budgets.toml", set(pairs.values()))
        for pair in chosen:
            packages = package_map.get(pair)
            if (not isinstance(packages, list) or not packages
                    or any(not isinstance(package, str) or not package for package in packages)
                    or packages != sorted(set(packages))):
                print(f"tiers: refused missing or invalid package set for {pair} "
                      "in tools/tiers/packages.toml (need sorted, unique package names)", file=sys.stderr)
                return 2
            if not valid_binaries(binary_map[pair]):
                print(f"tiers: refused invalid binary list for {pair} in tools/tiers/packages.toml "
                      "(need sorted, unique package/bin records and distinct binary names)", file=sys.stderr)
                return 2
    except (OSError, ValueError, TypeError) as error:
        print(f"tiers: read tools/tiers/packages.toml from the checkout root: {error}", file=sys.stderr)
        return 2
    env = dict(os.environ)
    env["NEXTEST_DOUBLE_SPAWN"] = "0"
    try:
        if args.verify or args.verify_all:
            matches = True
            for pair in chosen:
                if not verify(pair, package_map[pair], env):
                    matches = False
            return 0 if matches else 1
        target = None
        if (args.tier == "browser" and args.tree in ("skein", "jig", "temper")) or profile == "qa-temper":
            target = target_directory(env)
            bundle(args.tree, target, env)
        elif any("env" in binary for binary in binary_map[profile]):
            target = target_directory(env)
        for binary in binary_map[profile]:
            build(f"prerequisite binary {binary['package']}/{binary['bin']}",
                  ["-p", binary["package"], "--bin", binary["bin"]], env)
            if "env" in binary:
                env[binary["env"]] = str(target / "debug" / binary["bin"])
        command = ["heavy", "cargo", "nextest", "run", *package_arguments(package_map[profile]), "--profile", profile,
                   "--no-fail-fast", *extra]
        if args.cpu:
            # Native prerequisite: the ordinary runner never builds or loads it.
            target = target_directory(env)
            wrapper = target / "tiers-cpu-wrapper"
            target.mkdir(parents=True, exist_ok=True)
            code = step("CPU wrapper", ["heavy", "cc", "-std=c11", "-O2", "-static", "-Wall", "-Wextra", "-Werror",
                        "tools/tiers/cpu-wrapper.c", "-o", str(wrapper)], env)
            if code:
                raise FailedStep(f"CPU wrapper: exit {code}")
            overlay = cpu["prepare"](args.cpu, profile, wrapper)
            command = [*command[:4], *overlay, *command[4:]]
            wait_for_disk(env)
            print(f"tiers: nextest: {shlex.join(command)}", flush=True)
            return cpu["execute"](command, env, args.cpu, profile, limits)
        return step("nextest", command, env)
    except (FailedStep, OSError, ValueError, KeyError, TypeError) as error:
        print(f"tiers: failed step {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
