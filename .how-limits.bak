//! Checked edge bounds for temper's frame, cards, transcript and tree.
use crate::words::Words;
// A run's line is cut at 253 bytes and its rows at 160 (chat_line.rs).
// Their names and displayed text fit 512 bytes per structure node, even
// when the receiving text bound is smaller (client/view.md, 4, and client/pages/chat/conversation.md, 2).
const STRUCTURE_TEXT: u32 = 512;
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct Limits {
    pub tree: skein_ui::Limits,
}
impl Limits {
    #[must_use]
    #[expect(
        clippy::too_many_lines,
        reason = "one checked set of expressions prices the composed pages and their edges"
    )]
    pub fn of(domain: &temper_client_domain::Limits, words: &Words) -> Option<Limits> {
        let receiving = &domain.client.domain;
        let phrase = words.ordinary_capacity()?;
        let classes_phrase = words.classes_capacity()?;
        // A follow box has its title, composed words, status and optional stopped line;
        // the tiers box composes every verify stop (client/pages/settings.md, 2).
        let follows_phrase = words.follows_capacity()?;
        let follows_boxes = temper_client_protocol_wire::v1::CEILINGS.follows_panel_follows.checked_add(1)?;
        let follows_nodes = follows_boxes.checked_mul(24)?.checked_add(receiving.rows.checked_mul(7)?)?;
        let follows_text = follows_boxes.checked_mul(8)?.checked_mul(follows_phrase)?;
        // Three class lines per proposal item and card; Settings holds its summary as name and text.
        let classes_text = receiving
            .rows
            .checked_mul(3)?
            .checked_mul(temper_client_domain::pages::inbox::card_capacity(receiving.reads).checked_add(1)?)?
            .checked_add(2)?
            .checked_mul(classes_phrase)?;
        let text =
            phrase.max(receiving.text.checked_mul(2)?).max(domain.forge.field_bytes.checked_mul(3)?.checked_add(128)?);
        // An account heading joins the provider, plan/display and holder's words.
        let text = text.max(receiving.text.checked_add(words.name_bytes.min(256).checked_mul(3)?)?.checked_add(64)?);
        // The toast wraps a full outgoing choice or reply label and "Answered: ".
        let text = text.max(temper_client_protocol_wire::CUE_BYTES.checked_add(24)?);
        // The sign-in return link percent-encodes a whole authorization address.
        let text = text.max(3400);
        // Builders draws each admitted host name whole, as name and text (client/pages/README.md).
        let builder_name = jig_client::contract::PROGRAM_HOST_NAME.checked_mul(2)?;
        let markdown = skein_ui::markdown::max_nodes(receiving.text)?;
        let cards = card_nodes(receiving, markdown)?;
        // Each watched task has one card at its first anchor: sixteen structural
        // nodes plus the result's markdown, and one region for live delegates.
        let delegations = temper_client_domain::pages::delegation::bound(domain);
        let delegated = markdown.checked_add(16)?.checked_mul(delegations)?.checked_add(1)?;
        // The window charges LINE_ROOM for each line, message, block, object
        // and part. Ten nodes per room cover block shells and per-document
        // Markdown wrappers (client/view.md, 4, and client/pages/chat/conversation.md, 2).
        let bytes = u32::try_from(receiving.document_bytes).ok()?;
        let lines = bytes.checked_div(jig_client::contract::LINE_ROOM)?;
        let window_structure = lines.checked_mul(10)?;
        let window_nodes = skein_ui::markdown::max_nodes(bytes)?.checked_add(window_structure)?;
        let window_text =
            skein_ui::markdown::max_text_bytes(bytes)?.checked_add(window_structure.checked_mul(STRUCTURE_TEXT)?)?;
        // Thread projects at most `lines` pending words and live turns together.
        // Pending words total at most the thread's bytes, with a paragraph
        // per newline. The shared structural room covers ten nodes a line.
        let pending_nodes = skein_ui::markdown::max_nodes(bytes)?;
        // Each live turn has `live` bytes; prune_live bounds their total by
        // document_bytes. Price the smaller of these two independent bounds.
        let live = u64::from(receiving.long_text).checked_mul(u64::from(lines))?.min(receiving.document_bytes);
        let live = u32::try_from(live).ok()?;
        let live_nodes =
            skein_ui::markdown::max_nodes(live)?.checked_add(pending_nodes)?.checked_add(window_structure)?;
        let live_text = skein_ui::markdown::max_text_bytes(live)?
            .checked_add(window_structure.checked_mul(STRUCTURE_TEXT)?)?
            .checked_add(bytes)?;
        let turn = receiving.turn_text.max(receiving.long_text);
        let request_nodes = receiving.long_text.checked_add(1)?.checked_mul(2)?;
        let turns = 2_u32
            // The conversation log.
            .checked_add(1)?
            // Request: region, message/who/says slots and the requester's
            // paragraph/text. Its variable words and nodes are priced once.
            .checked_add(6)?
            // End line: one paragraph and its text, including the report's words.
            .checked_add(2)?;
        let counts = receiving.accounts;
        // Per row: sources and their actions, state/fact pairs, ranks, editor and outcome.
        // Program observations may appear in both the state notice and the source list.
        // Fixed room covers disclosure/heading, controls, confirmation and sign-in ending.
        let hosts = counts.accounts.checked_mul(counts.sources.checked_mul(2)?.checked_add(4)?)?;
        let account = counts
            .sources
            .checked_mul(16)?
            .checked_add(hosts)?
            .checked_add(domain.row_uses.checked_mul(2)?)?
            .checked_add(64)?
            // Trial (domain/trial.md, 6.2): stacked line 3, why 2, acts 4,
            // disclosure/list 2 and three steps with text/status/text 12.
            .checked_add(23)?;
        let account_nodes = account
            .checked_mul(counts.accounts)?
            .checked_mul(2)?
            .checked_add(counts.sign_ins.checked_mul(2)?)?
            // Switcher row: slot, named button, repository text, link, label and count.
            .checked_add(receiving.projects.checked_mul(6)?)?
            .checked_add(128)?
            .checked_add(receiving.rows.checked_mul(3)?)?
            // Worker and program observations, omission rows and retained sign-out failures.
            .checked_add(counts.accounts.checked_mul(counts.sources.checked_add(2)?)?.checked_mul(2)?)?
            .checked_add(2)?
            .checked_add(128_u32.checked_mul(2)?)?;
        // Each model may occur under every account in its wire-bound offer.
        // Each occurrence has item/button/name and heading/list room; the
        // default tag adds three nodes. Efforts follow once, with a group.
        let choices = temper_client_domain::pages::choice::MODELS
            .checked_mul(temper_client_domain::pages::choice::MODEL_ACCOUNTS.checked_add(1)?)?
            .checked_mul(10)?
            .checked_add(temper_client_domain::pages::choice::EFFORTS.checked_mul(2)?)?
            .checked_add(receiving.rows.checked_mul(5)?)?
            .checked_add(40)?;
        // A goal's result: region, heading, status, their text and words slot plus
        // markdown; its contract paragraph and text. Budget: region, heading, balance,
        // six term/description pairs, a funder link, models term and cut line,
        // including text leaves: 34 nodes, plus two per allowed model name.
        let goal = markdown
            .checked_add(6)?
            .checked_add(2)?
            .checked_add(34)?
            // A procedure's goal slot, paragraph and link, including text leaves.
            .checked_add(5)?
            .checked_add(jig_client::contract::AUTHORITY_MODELS.checked_mul(2)?)?;
        // Each plan row adds a spend paragraph, dependency list and cut item
        // with a paragraph: six nodes including their text children. Each
        // dependency adds an item, link, status and added mark (client/pages/goal.md,
        // 2) with text: seven nodes, bounded by jig's receiving rows count per row.
        let dependencies = receiving.rows.checked_mul(7)?.checked_add(6)?.checked_mul(receiving.rows)?;
        // An agent's lineage, taskbar, brief and run: 32 fixed nodes including
        // text leaves, plus the spec's markdown and a dependency list. Jig's
        // task translation bounds dependencies by the receiving rows count:
        // one item, link, status and added mark (client/pages/goal.md, 2),
        // seven nodes with text per dependency.
        let agent = markdown.checked_add(33)?.checked_add(receiving.rows.checked_mul(7)?)?;
        // A full document's Markdown, two slots per heading (at most one
        // per three bytes), intro wrapper, path, group and attribution.
        let document = skein_ui::markdown::max_nodes(receiving.long_text)?
            .checked_add(receiving.long_text.checked_div(3)?.checked_mul(2)?)?
            .checked_add(24)?;
        let structural = cards.checked_add(follows_nodes)?
            .checked_add(turns)?
            .checked_add(delegated)?
            .checked_add(goal)?
            .checked_add(agent)?
            .checked_add(receiving.rows.checked_mul(32)?)?
            .checked_add(dependencies)?
            // Switcher row: slot, named button, repository text, link, label and count.
            .checked_add(receiving.projects.checked_mul(6)?)?
            .checked_add(128)?
            // Welcome steps, cards and foot, plus the shared accounts form.
            .max(account_nodes.checked_add(64)?)
            // Choice cards: region, heading, body, note and link with text;
            // the fixed step card also holds fields, snippets or progress.
            .max(temper_client_domain::forge::forges::ROWS.checked_mul(16)?.checked_add(152)?)
            // The menu feedback uses the ordinary text bound.
            .checked_add(40)?
            // Away's Settings heading, summary, asking row, 27 checks, duration and refusal (5.13).
            .checked_add(51)?
            // Each of Home's seven live decision rows can offer Overturn (3.5).
            .checked_add(7)?
            // Owned rows add Runs and First password: a slot, term and description each.
            .checked_add(temper_client_domain::forge::forges::ROWS.checked_mul(6)?)?
            // The context line splits the repository from its forge suffix.
            .checked_add(1)?
            // Task amendment region, fields, buttons and explanatory text leaves (5.11).
            .checked_add(16)?
            // Chats adds its intro (seven nodes), section head and repository tag
            // above the filters and empty words; rows retain borrowed lines and scalar keys.
            .checked_add(16)?
            // A chat log holds its inner column and the working indicator with three dots.
            .checked_add(5)?
            // Start a chat heading and its text outside the playground start (2), and
            // a failed playground start's alert, its text leaf and Try again (3).
            .checked_add(5)?
            // Home's stopped try paragraph and retry button (temper/docs/design/domain/trial.md, 6.3).
            .checked_add(2)?
            // The rail menu wrapper, menu and three items.
            .checked_add(5)?
            // Start goal's asking group: heading, two choices and their small text leaves.
            .checked_add(11)?
            // The adoption form's region, named by the page's heading.
            .checked_add(1)?
            // One question read whole: sixteen choices and their marks, context, Saw and cut line.
            .checked_add(temper_client_domain::question::CHOICES.checked_mul(3)?.checked_add(12)?)?
            // GitHub's App line keeps each installation in its own bounded text slot.
            .checked_add(
                temper_client_domain::forge::forges::ROWS
                    .checked_mul(temper_client_domain::forge::forges::INSTALLATIONS)?
                    .checked_mul(2)?,
            )?
            // Each landed draft has its from line, title and two choices, one with a small byline.
            .checked_add(temper_client_protocol_wire::v1::CEILINGS.drafts_panel_drafts.checked_mul(24)?)?
            // The toast holds a refusal, its Look again sentence and button (six nodes),
            // or a proposal's lead and at most rows role recipients (two nodes each).
            .checked_add(receiving.rows.checked_mul(2)?.checked_add(3)?.max(6))?;
        let text_bytes = choices
            .checked_mul(crate::choice::MODEL_SHOWN.checked_mul(2)?.checked_add(128)?)?
            .checked_add(structural.checked_mul(text)?)?
            .checked_add(window_text)?
            .checked_add(live_text)?
            .checked_add(skein_ui::markdown::max_text_bytes(receiving.long_text)?)?
            // One chat request and one composer, each at long_text.
            .checked_add(receiving.long_text.checked_mul(2)?)?
            // One question read whole.
            .checked_add(receiving.long_text)?
            .checked_add(text.checked_mul(24)?)?
            .checked_add(classes_text)?.checked_add(follows_text)?;
        let nodes = choices
            .checked_add(structural)?
            .checked_add(request_nodes)?
            .checked_add(window_nodes)?
            .checked_add(live_nodes)?
            .checked_add(document)?;
        let tree = skein_ui::Limits {
            nodes,
            depth: receiving.rows.checked_add(34)?,
            text_per_node: text.max(follows_phrase.checked_mul(6)?).max(classes_phrase.checked_mul(2)?).max(turn.checked_mul(2)?).max(builder_name).max(
                temper_client_protocol_wire::v1::CEILINGS
                    .deployment_answer_program_login_some
                    .checked_add(phrase)?
                    .checked_add(1)?,
            ),
            // Whole builder names are held once per document row.
            text_bytes: text_bytes.checked_add(receiving.rows.checked_mul(builder_name)?)?,
            // Room for a flow and a 32-stop path (client/pages/chat/conversation.md, 3).
            drawing_bytes: 2048_u32.max(crate::paths::DATA),
            scene_marks: skein_ui::flow::marks(24)?.max(crate::paths::MARKS),
            scene_bytes: skein_ui::flow::scene_bytes(24, 2048)?.max(crate::paths::SCENE_BYTES),
            // Work, tool and run, plus independent running and failed states (3.5).
            styles_per_node: 5,
            // A diff emits at most four patches a node (skein's ui/README.md, 7).
            patches: nodes.checked_mul(4)?,
            bindings: nodes,
            slots: 0,
            markdown_depth: 3,
        };
        let limits = Limits { tree };
        valid(&limits, domain, words).then_some(limits)
    }
}
fn card_nodes(receiving: &jig_client::DomainLimits, markdown: u32) -> Option<u32> {
    // Each grant and note scope has a bounded sequence of pattern segments.
    let pattern = receiving.segments.checked_add(2)?.checked_mul(2)?;
    let authority = pattern.checked_mul(2)?.checked_add(4)?.checked_mul(receiving.rows)?.checked_add(24)?;
    let proposed = markdown
        .checked_mul(2)?
        .checked_add(authority)?
        // A classes preview has a heading, three classes and six sets, each with its text leaf.
        .checked_add(receiving.rows.checked_mul(20)?)?
        .checked_add(32)?;
    // Conversation controls share one slot.
    let card = proposed.checked_mul(receiving.rows)?.checked_add(129)?;
    let cards = card.checked_mul(temper_client_domain::pages::inbox::card_capacity(receiving.reads).checked_add(1)?)?;
    Some(cards)
}
/// Refuses unrepresentable UI limits, account row counts and phrase capacity.
#[must_use]
pub fn valid(limits: &Limits, domain: &temper_client_domain::Limits, words: &Words) -> bool {
    skein_ui::valid(&limits.tree)
        && skein_ui::phrases::valid(words.book.limits())
        && words.capacity().is_some()
        && domain.client.domain.rows.checked_mul(3).is_some()
}
