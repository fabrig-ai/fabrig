family every 3

# The byte pin holds every construct (data/codec/README.md, 6).
# Older versions exercise patches (data/codec/patches.md, 8).

versioned record Blank {}

record Numbers {
    small: u8
    short: u16
    word: u32
    long: u64
    flag: bool
    pause: duration
    tag: fixed 3
}

record Texts {
    raw: bytes 8
    key: secret 5
    words: text 7
}

enum Light { off, red, amber, green }

versioned record Stamp {
    at: u64
    note: option text 4
    zone: text 8
}

enum Shape {
    blank: Blank
    numbers: Numbers
    strings: boxed Texts
    stamp: Stamp
}

record Nest {
    blanks: list 3 Blank
    lights: list 3 Light
    maybe_lights: list 2 option Light
    grid: list 2 list 2 u32
    maybe_list: option list 3 u8
    maybe_numbers: option Numbers
    shapes: list 2 Shape
    secrets: list 2 secret 3
    stamps: list 2 Stamp
    label: option text 8
}

versioned record Every {
    numbers: Numbers
    strings: Texts
    light: option Light
    shape: Shape
    stamp: Stamp
    empty: Blank
    nest: Nest
    score: u32
    # Holds Thing of every-other (data/codec/README.md 3).
    held: bytes 8 holds every-other Thing
    # Holds pieces of Numbers (data/codec/README.md 3).
    items: bytes 64 pieces Numbers
}

record Kinds {
    light: Light
}

record Lists {
    small: list 2 u8
    short: list 2 u16
    word: list 2 u32
    long: list 2 u64
    flag: list 2 bool
    pause: list 2 duration
    tag: list 2 fixed 3
    raw: list 2 bytes 4
    key: list 2 secret 4
    words: list 2 text 4
    grid: list 2 list 2 u8
    options: list 2 option u8
    records: list 2 Numbers
    enums: list 2 Light
}

record Options {
    small: option u8
    short: option u16
    word: option u32
    long: option u64
    flag: option bool
    pause: option duration
    tag: option fixed 3
    raw: option bytes 4
    key: option secret 4
    words: option text 4
    lists: option list 2 u8
    maybe: option option u8
    records: option Numbers
    enums: option Light
}

record Grouped was Flags {
    alpha: bool = false
    bravo: bool
    charlie: bool
    delta: bool
}

record Held {
    record_bytes: bytes 8 holds every-other Thing
    enum_bytes: bytes 8 holds every-other Choice
    record_secret: secret 8 holds every-other Thing
    enum_secret: secret 8 holds every-other Choice
    byte_pieces: bytes 64 pieces Numbers
    secret_pieces: secret 64 pieces Numbers
}

record LongRecord {
    alpha: bytes 4
    bravo: bytes 4
    charlie: bytes 4
    delta: bytes 4
    echo: bytes 4
    foxtrot: bytes 4
    golf: bytes 4
    hotel: bytes 4
    india: bytes 4
    juliet: bytes 4
    kilo: bytes 4
    lima: bytes 4
    mike: bytes 4
    november: bytes 4
    oscar: bytes 4
