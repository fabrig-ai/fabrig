+                row.landing.preparation,
+                &row.landing.round,
+                &row.landing.members[0].gates,
+                &row.entries
+            ))
+            .collect::<Vec<_>>(),
+        landing_rows(world)
+            .iter()
+            .map(|row| task_row(world, row.landing.task).map(|task| &task.phase))
+            .collect::<Vec<_>>()
     );
